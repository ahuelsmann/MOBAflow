	<!-- ============================================ -->
	<!-- Non-Readonly Property in GetHashCode -->
	<!-- ============================================ -->
	<!-- 
		Category: NonReadonlyMemberInGetHashCode
		Count: 2 occurrences
		File: WinUI/Controls/Docking/DocumentTab.cs
		
		Issue: GetHashCode uses Title and Tag which are mutable
		
		Why It's OK:
		- DocumentTab is internal, only used as tab identity in DockingManager
		- Title and Tag are set once during construction and never changed
		- HashCode is only used for Dictionary/HashSet lookups within DockingManager
		- Making properties init-only would break existing XAML bindings
		
		Status: ACCEPTED RISK – Internal type with stable identity
	-->
	<s:Boolean x:Key="/Default/CodeInspection/Inspections/NonReadonlyMemberInGetHashCode/@EntryIndexedValue">False</s:Boolean>

	<!-- ============================================ -->
	<!-- XAML: Field Never Used (x:Name References) -->
	<!-- ============================================ -->
	<!-- 
		Category: Xaml.UnusedField / FieldCanBeMadeReadOnly
		Count: ~10 occurrences
		Files: DockingPage.xaml (DockManager), TrainControlPage.xaml (BrakeButton, DoorReleaseButton),
		       KsSignalScreen.xaml (Zs3, Zs3V)
		
		Issue: ReSharper reports x:Name fields as unused because they are:
		1. Reserved for future XAML features (DockManager)
		2. Only used via FindName() or DataTemplate binding (not direct code-behind access)
		3. Signal screen LEDs reserved for future signal aspects (Zs3, Zs3V)
		
		Evidence:
		- x:Name fields are required by WinUI XAML for element identification
		- Removing them would break potential future bindings or VisualState references
		
		Status: INTENTIONAL – Reserved for XAML infrastructure / future use
	-->

	<!-- ============================================ -->
	<!-- Equality Comparison of Floating Point Numbers -->
	<!-- ============================================ -->
	<!-- 
		Category: CompareOfFloatsByEqualityOperator
		Count: ~4 occurrences
		Files: RestApiStatusService.cs, TrainControlViewModel.cs (DoorReleaseBlinkOpacity)
		
		Issue: Direct == comparison of double values
		
		Why Suppressed:
		- RestApiStatusService: Timer.Interval is set to exact integer constants (30000, 2000)
		  so equality comparison is safe (no rounding involved)
		- TrainControlViewModel: DoorReleaseBlinkOpacity toggles between exactly 1.0 and 0.35
		  (assigned literals, never computed) – equality is deterministic
		
		Status: SAFE – Values are assigned from literals, not computed
	-->
	<s:Boolean x:Key="/Default/CodeInspection/Inspections/CompareOfFloatsByEqualityOperator/@EntryIndexedValue">False</s:Boolean>

	<!-- ============================================ -->
	<!-- Redundant Pattern / Redundant Switch Arm -->
	<!-- ============================================ -->
	<!-- 
		Category: RedundantPattern / SwitchExpressionHandlesSomeKnownEnumValuesWithExceptionInDefault
		Count: ~3 occurrences
		Files: Speedometer.xaml.cs, SignalBoxPage.xaml.cs, TrainControlPage.xaml.cs
		
		Issue: switch expressions with explicit enum values + default arm
		
		Why Suppressed:
		- Default arm provides defensive coding against future enum additions
		- Speedometer: SpeedSteps switch with 128 | _ pattern is intentional fallback
		- Signal/Switch toggle: default arm ensures safe state on unexpected values
		
		Status: DEFENSIVE CODING – Intentional default arms for safety
	-->
	<s:Boolean x:Key="/Default/CodeInspection/Inspections/RedundantPattern/@EntryIndexedValue">False</s:Boolean>

	<!-- ============================================ -->
	<!-- Access to Static Member via Derived Type -->
	<!-- ============================================ -->
	<!-- 
		Category: AccessToStaticMemberViaDerivedType
		Count: 2 occurrences
		File: TrainControlPage.xaml.cs (UISettings access)
		
		Issue: Accessing static member from derived type instead of declaring type
		
		Why Suppressed:
		- Common pattern in WinUI/UWP when using platform APIs
		- Does not affect functionality or performance
		- Changing would reduce readability in context
		
		Status: STYLISTIC – No functional impact
	-->
	<s:Boolean x:Key="/Default/CodeInspection/Inspections/AccessToStaticMemberViaDerivedType/@EntryIndexedValue">False</s:Boolean>

	<!-- ============================================ -->
	<!-- Property Initializer Value Ignored -->
	<!-- ============================================ -->
	<!-- 
		Category: PropertyInitializedAndImmediatelyOverwritten
		Count: 1 occurrence
		File: TrainControlPage.xaml.cs (SpeedStepsSelectedIndex)
		
		Issue: Property initializer value overwritten in constructor
		
		Why It's OK:
		- Auto-property needs a type-valid default for x:Bind
		- Constructor immediately sets the correct value from ViewModel
		- This is standard practice for XAML-bound properties
		
		Status: XAML BINDING PATTERN – Initializer serves as design-time default
	-->

	<!-- ============================================ -->
	<!-- Collection Content Never Updated -->
	<!-- ============================================ -->
	<!-- 
		Category: CollectionNeverUpdated.Local
		Count: 1 occurrence
		File: SignalBoxPage.xaml.cs (_blinkingLeds)
		
		Issue: ReSharper sees _blinkingLeds as never having items added
		
		Why It's Wrong:
		- Items are added/cleared dynamically by SignalBoxPage.Properties.cs
		  (partial class, same type, different file)
		- ReSharper cross-file analysis does not always track partial class mutations
		
		Status: PARTIAL CLASS LIMITATION – Collection used in other partial file
	-->
	<s:Boolean x:Key="/Default/CodeInspection/Inspections/CollectionNeverUpdated_002ELocal/@EntryIndexedValue">False</s:Boolean>

	<!-- ============================================ -->
	<!-- Member Can Be Made Static -->
	<!-- ============================================ -->
	<!-- 
		Category: MemberCanBePrivate.Local / MemberCanBeMadeStatic.Local
		Count: Multiple across solution
		
		Issue: ReSharper suggests making methods static when they don't use instance state
		
		Why Suppressed at Solution Level:
		- Many methods are instance methods for future extensibility
		- Virtual dispatch may be needed if class hierarchy changes
		- WinUI event handlers must be instance methods (even if they could be static)
		- Changing to static breaks consistency in partial class patterns
		
		Status: DESIGN CHOICE – Instance methods preferred for extensibility
	-->
	<s:Boolean x:Key="/Default/CodeInspection/Inspections/MemberCanBeMadeStatic_002ELocal/@EntryIndexedValue">False</s:Boolean>

	<!-- ============================================ -->
	<!-- Unused Member (XAML-referenced) -->
	<!-- ============================================ -->
	<!-- 
		Category: UnusedMember.Local / UnusedMethodReturnValue.Local
		Count: ~5 occurrences
		Files: SignalBoxPage.Properties.cs (OnSignalTypeChanged), DockingPage.xaml.cs (OnPanelUndocked)
		
		Issue: Methods appear unused in C# but are:
		1. Referenced from XAML event bindings (Click="OnSignalTypeChanged")
		2. Reserved for future XAML features
		3. Part of a partial class where usage is in another file
		
		ReSharper cannot resolve XAML→C# event handler references reliably.
		
		Status: XAML EVENT HANDLER – Referenced from XAML markup
	-->
	<s:Boolean x:Key="/Default/CodeInspection/Inspections/UnusedMember_002ELocal/@EntryIndexedValue">False</s:Boolean>

	<!-- ============================================ -->
	<!-- Null-Coalescing Left Operand Never Null -->
	<!-- ============================================ -->
	<!-- 
		Category: NullCoalescingConditionIsAlwaysNotNullAccordingToAPIContract
		Count: ~10 occurrences
		Files: MainWindowViewModel.SettingsPageLayout.cs, MainWindowViewModel.Settings.cs
		
		Issue: ??= operator on properties that are never null per annotations
		
		Why Some Remain:
		- Defensive initialization in GetSettingsPageLayout() ensures
		  SettingsPage and Sections are never null even if AppSettings
		  is deserialized from a corrupted/incomplete JSON file
		- The ??= pattern is a deliberate safety net for deserialization edge cases
		
		Status: DEFENSIVE CODING – Safety net for JSON deserialization
	-->
	<s:Boolean x:Key="/Default/CodeInspection/Inspections/NullCoalescingConditionIsAlwaysNotNullAccordingToAPIContract/@EntryIndexedValue">False</s:Boolean>

	<!-- ============================================ -->
	<!-- Expression Is Always False -->
	<!-- ============================================ -->
	<!-- 
		Category: ConditionIsAlwaysTrueOrFalse / ExpressionIsAlwaysNull
		Count: ~6 occurrences
		Files: MainWindowViewModel.SettingsPageLayout.cs, MauiViewModel.cs,
		       Z21DiscoveryService.cs, TrainClassViewModel.cs
		
		Issue: Null checks on non-nullable types flagged as always-false
		
		Why Some Remain:
		- Guard clauses protect against future refactoring
		- JSON deserialization can produce null for non-nullable reference types
		  (System.Text.Json does not enforce NRT at runtime)
		- External API responses (Z21 UDP) may contain unexpected null values
		
		Status: DEFENSIVE CODING – Runtime safety for deserialization/network
	-->
	<s:Boolean x:Key="/Default/CodeInspection/Inspections/ConditionIsAlwaysTrueOrFalse/@EntryIndexedValue">False</s:Boolean>

	<!-- ============================================ -->
	<!-- Function Never Returns -->
	<!-- ============================================ -->
	<!-- 
		Category: FunctionNeverReturns
		Count: 1 occurrence
		File: MauiViewModel.cs (RestApiHealthCheckLoopAsync)
		
		Issue: while(true) loop method flagged as never returning
		
		Why It's Intentional:
		- Background health check loop runs for the lifetime of the app
		- Standard pattern for periodic background tasks in mobile apps
		- Loop is broken by app lifecycle (process termination)
		
		Status: INTENTIONAL – Lifetime background loop pattern
	-->
	<s:Boolean x:Key="/Default/CodeInspection/Inspections/FunctionNeverReturns/@EntryIndexedValue">False</s:Boolean>

	<!-- ============================================ -->
	<!-- Missing XML Doc Param Tag -->
	<!-- ============================================ -->
	<!-- 
		Category: MissingXmlDocParam
		Count: ~3 occurrences
		Files: MainWindowViewModel.cs constructor
		
		Issue: XML doc comment has params documented but new parameters
		added later without updating the XML comment block
		
		Why Suppressed:
		- Constructor has 15+ parameters; maintaining all param tags is
		  low-value compared to the summary documentation
		- The summary accurately describes the class purpose
		- Individual param tags for DI constructor parameters add noise
		
		Status: LOW PRIORITY – Summary documentation is sufficient
	-->
	<s:Boolean x:Key="/Default/CodeInspection/Inspections/MissingXmlDocParam/@EntryIndexedValue">False</s:Boolean>
</wpf:ResourceDictionary>