# Normalize text files in the repository and use native line endings on checkout.
* text=auto

# Preserve line endings required by platform-specific files.
*.bat text eol=crlf
*.cmd text eol=crlf
*.sln text eol=crlf
*.sh text eol=lf

# Spec Kit manifests hash file bytes; keep managed assets stable across platforms.
.agents/skills/speckit-*/SKILL.md text eol=lf
.specify/scripts/** text eol=lf
.specify/templates/*.md text eol=lf

# Binary files - never perform line ending conversion or text diffs.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.webp binary
*.ico binary
*.pdf binary
*.dll binary
*.exe binary
*.pdb binary
*.nupkg binary
*.snupkg binary
*.zip binary
*.wav binary
*.mp3 binary
*.pptx binary
*.dylib binary
*.so binary
*.a binary
*.woff binary
*.woff2 binary
*.ttf binary
*.appx binary
*.msix binary
*.msixbundle binary
