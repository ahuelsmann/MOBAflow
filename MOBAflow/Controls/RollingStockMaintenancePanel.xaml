<UserControl
    x:Class="Moba.WinUI.Controls.RollingStockMaintenancePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:Moba.WinUI.Converter"
    DataContext="{x:Bind ViewModel, Mode=OneWay}">

    <UserControl.Resources>
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <StackPanel Spacing="12">
        <TextBlock
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="Usage and maintenance" />

        <TextBlock
            AutomationProperties.Name="No rolling-stock vehicle selected"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Select a vehicle to view usage and maintenance."
            TextWrapping="Wrap"
            Visibility="{Binding HasSelectedVehicle, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

        <StackPanel
            Spacing="12"
            Visibility="{Binding HasSelectedVehicle, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Operating time" />
                            <TextBlock
                                AutomationProperties.Name="Operating time"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{Binding OperatingTimeText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Completed trips" />
                            <TextBlock
                                AutomationProperties.Name="Completed trips"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{Binding CompletedTripsText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Distance" />
                            <TextBlock
                                AutomationProperties.Name="Tracked distance"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{Binding DistanceText}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding OperatingStatusText}" />
                </StackPanel>
            </Border>

            <Border
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="4">
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Next maintenance task" />
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding NextTaskName}" />
                    <TextBlock Text="{Binding NextTaskStatusText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Expander Header="Maintenance tasks">
                <StackPanel Padding="0,8,0,0" Spacing="8">
                    <ComboBox
                        AutomationProperties.Name="Maintenance task template"
                        DisplayMemberPath="Label"
                        Header="Shared template"
                        ItemsSource="{Binding TaskTemplates}"
                        SelectedItem="{Binding SelectedTaskTemplate, Mode=TwoWay}" />
                    <TextBox
                        AutomationProperties.Name="New maintenance task name"
                        Header="Task name"
                        Text="{Binding NewPlanName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="100" />
                            <ColumnDefinition Width="*" MinWidth="100" />
                            <ColumnDefinition Width="*" MinWidth="100" />
                        </Grid.ColumnDefinitions>
                        <NumberBox
                            Grid.Column="0"
                            AutomationProperties.Name="Calendar interval in days"
                            Header="Days"
                            Minimum="0"
                            SpinButtonPlacementMode="Compact"
                            Value="{Binding NewPlanIntervalDays, Mode=TwoWay}" />
                        <NumberBox
                            Grid.Column="1"
                            AutomationProperties.Name="Operating interval in hours"
                            Header="Operating hours"
                            Minimum="0"
                            SpinButtonPlacementMode="Compact"
                            Value="{Binding NewPlanOperatingHours, Mode=TwoWay}" />
                        <NumberBox
                            Grid.Column="2"
                            AutomationProperties.Name="Completed trip interval"
                            Header="Trips"
                            Minimum="0"
                            SpinButtonPlacementMode="Compact"
                            Value="{Binding NewPlanCompletedTrips, Mode=TwoWay}" />
                    </Grid>
                    <Button
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Add maintenance task"
                        Command="{Binding AddMaintenancePlanCommand}"
                        Content="Add task" />

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="No maintenance tasks have been configured."
                        TextWrapping="Wrap"
                        Visibility="{Binding HasMaintenancePlans, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                    <ListView
                        AutomationProperties.Name="Maintenance tasks"
                        ItemsSource="{Binding MaintenancePlans}"
                        SelectedItem="{Binding SelectedPlan, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="8" Spacing="2">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Name}" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding State}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Record selected maintenance task"
                        Command="{Binding CompleteSelectedPlanCommand}"
                        Content="Record selected task" />
                </StackPanel>
            </Expander>

            <Expander Header="Correct usage counters">
                <StackPanel Padding="0,8,0,0" Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                        </Grid.ColumnDefinitions>
                        <NumberBox
                            Grid.Column="0"
                            AutomationProperties.Name="Operating hours correction"
                            Header="Operating hours delta"
                            SpinButtonPlacementMode="Compact"
                            Value="{Binding CorrectionOperatingHours, Mode=TwoWay}" />
                        <NumberBox
                            Grid.Column="1"
                            AutomationProperties.Name="Completed trips correction"
                            Header="Trips delta"
                            SpinButtonPlacementMode="Compact"
                            Value="{Binding CorrectionCompletedTrips, Mode=TwoWay}" />
                    </Grid>
                    <TextBox
                        AutomationProperties.Name="Usage correction reason"
                        Header="Reason"
                        PlaceholderText="Required for the audit history"
                        Text="{Binding CorrectionReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Record usage correction"
                        Command="{Binding RecordCorrectionCommand}"
                        Content="Record correction" />
                </StackPanel>
            </Expander>

            <Expander Header="Maintenance and correction history">
                <StackPanel Padding="0,8,0,0" Spacing="8">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="No maintenance or correction history is available."
                        TextWrapping="Wrap"
                        Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                    <ItemsControl AutomationProperties.Name="Maintenance and correction history" ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4" Spacing="2">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Title}" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding RecordedAt}" />
                                    <TextBlock Text="{Binding Details}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>

            <TextBlock
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{Binding OperationStatus}"
                TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</UserControl>
