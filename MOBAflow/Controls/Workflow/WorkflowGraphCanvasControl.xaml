<UserControl
    x:Class="Moba.WinUI.Controls.Workflow.WorkflowGraphCanvasControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Resolve brushes on the generated element, including an inherited theme override. -->
        <Style x:Key="GraphTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="GraphCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="GraphParameterTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="GraphTriggerIconStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="GraphActionIconStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="GraphCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="GraphTriggerCardStyle" TargetType="Border" BasedOn="{StaticResource GraphCardStyle}">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="GraphSelectedCardStyle" TargetType="Border" BasedOn="{StaticResource GraphCardStyle}">
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="GraphSelectedTriggerCardStyle" TargetType="Border" BasedOn="{StaticResource GraphTriggerCardStyle}">
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="GraphParameterPillStyle" TargetType="Border" BasedOn="{StaticResource GraphCardStyle}">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="GraphPortStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="Stroke" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="GraphSuccessStatusStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style x:Key="GraphCriticalStatusStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style x:Key="GraphUnassignedStatusStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="GraphDotStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="GraphConnectionStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="GraphArrowStyle" TargetType="Polygon">
            <Setter Property="Fill" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        KeyDown="OnRootKeyDown"
        IsTabStop="True">

        <ScrollViewer
            x:Name="CanvasScrollViewer"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            MinZoomFactor="0.5"
            MaxZoomFactor="2.0"
            ZoomMode="Enabled">

            <Grid
                x:Name="CanvasHost"
                Width="1600"
                Height="1200"
                Background="Transparent"
                PointerPressed="OnCanvasBackgroundPointerPressed">

                <Canvas
                    x:Name="DotGridCanvas"
                    Width="1600"
                    Height="1200"
                    IsHitTestVisible="False" />

                <Canvas
                    x:Name="ConnectionsCanvas"
                    Width="1600"
                    Height="1200"
                    IsHitTestVisible="False" />

                <Canvas
                    x:Name="NodesCanvas"
                    Width="1600"
                    Height="1200" />
            </Grid>
        </ScrollViewer>

        <StackPanel
            x:Name="EmptyStatePanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="6"
            Padding="24"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <FontIcon
                Glyph="&#xEF90;"
                FontSize="28"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                x:Name="EmptyStateTitleText"
                Text="No actions in this workflow"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                x:Name="EmptyStateSubtitleText"
                Text="Use 'Add action' in the toolbar above to add steps to the graph."
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                MaxWidth="280"
                TextWrapping="Wrap" />
        </StackPanel>

        <Border
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="12"
            Padding="4"
            CornerRadius="6"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button
                    Padding="8,4"
                    AutomationProperties.Name="Auto layout graph nodes"
                    Click="OnAutoLayoutClicked"
                    ToolTipService.ToolTip="Snap all nodes to clean grid positions">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE80A;" FontSize="12" />
                        <TextBlock Text="Auto layout" Style="{ThemeResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Button>
                <Button
                    Padding="8,4"
                    AutomationProperties.Name="Reset graph zoom"
                    Click="OnResetZoomClicked"
                    ToolTipService.ToolTip="Reset zoom to 100%">
                    <TextBlock Text="100%" Style="{ThemeResource CaptionTextBlockStyle}" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
