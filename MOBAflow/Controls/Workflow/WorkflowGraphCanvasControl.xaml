<UserControl
    x:Class="Moba.WinUI.Controls.Workflow.WorkflowGraphCanvasControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        KeyDown="OnRootKeyDown"
        IsTabStop="True">

        <ScrollViewer
            x:Name="CanvasScrollViewer"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            MinZoomFactor="0.5"
            MaxZoomFactor="2.0"
            ZoomMode="Enabled">

            <Grid
                x:Name="CanvasHost"
                Width="1600"
                Height="1200"
                Background="Transparent"
                PointerPressed="OnCanvasBackgroundPointerPressed">

                <Canvas
                    x:Name="DotGridCanvas"
                    Width="1600"
                    Height="1200"
                    IsHitTestVisible="False" />

                <Canvas
                    x:Name="ConnectionsCanvas"
                    Width="1600"
                    Height="1200"
                    IsHitTestVisible="False" />

                <Canvas
                    x:Name="NodesCanvas"
                    Width="1600"
                    Height="1200" />
            </Grid>
        </ScrollViewer>

        <StackPanel
            x:Name="EmptyStatePanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="6"
            Padding="24"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <FontIcon
                Glyph="&#xEF90;"
                FontSize="28"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                x:Name="EmptyStateTitleText"
                Text="No actions in this workflow"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                x:Name="EmptyStateSubtitleText"
                Text="Use 'Add action' in the toolbar above to add steps to the graph."
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                MaxWidth="280"
                TextWrapping="Wrap" />
        </StackPanel>

        <Border
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="12"
            Padding="4"
            CornerRadius="6"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button
                    Padding="8,4"
                    AutomationProperties.Name="Auto layout graph nodes"
                    Click="OnAutoLayoutClicked"
                    ToolTipService.ToolTip="Snap all nodes to clean grid positions">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE80A;" FontSize="12" />
                        <TextBlock Text="Auto layout" Style="{ThemeResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Button>
                <Button
                    Padding="8,4"
                    AutomationProperties.Name="Reset graph zoom"
                    Click="OnResetZoomClicked"
                    ToolTipService.ToolTip="Reset zoom to 100%">
                    <TextBlock Text="100%" Style="{ThemeResource CaptionTextBlockStyle}" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
