            CornerRadius="10"
            PointerPressed="OnAspectClicked"
            Tag="Zs1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                <controls:KsSignalScreen
                    x:Name="AspectZs1Signal"
                    Width="64"
                    Height="70"
                    IsHitTestVisible="False" />
                <TextBlock x:Name="AspectZs1Label" HorizontalAlignment="Center" Text="Zs1" />
            </StackPanel>
        </Border>

        <Border
            x:Name="AspectZs7Button"
            Grid.Row="2"
            Grid.Column="2"
            Height="112"
