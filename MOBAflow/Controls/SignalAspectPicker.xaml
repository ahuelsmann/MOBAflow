                    Width="64"
                    Height="70"
                    IsHitTestVisible="False" />
                <TextBlock x:Name="AspectKs1BlinkLabel" HorizontalAlignment="Center" Text="Ks1 Bl" />
            </StackPanel>
        </Border>

        <Border
            x:Name="AspectKennlichtButton"
