                    IsHitTestVisible="False" />
                <TextBlock x:Name="AspectDunkelLabel" HorizontalAlignment="Center" Text="Dunkel" />
            </StackPanel>
        </Border>

        <Border
            x:Name="AspectRa12Button"
            Grid.Row="2"
            Grid.Column="0"
            Height="112"
            Padding="8"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10"
            PointerPressed="OnAspectClicked"
            Tag="Ra12">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
