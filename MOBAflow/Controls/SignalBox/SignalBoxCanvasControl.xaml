<UserControl
    x:Class="Moba.WinUI.Controls.SignalBox.SignalBoxCanvasControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Moba.WinUI.Controls.SignalBox"
    xmlns:controls="using:Moba.WinUI.Controls"
    xmlns:domain="using:Moba.Domain">

    <UserControl.Resources>
        <local:GridCoordinateConverter x:Key="GridConverter" />

        <DataTemplate x:Key="StraightTrackTemplate" x:DataType="domain:SbTrackStraight">
            <Canvas Width="1920" Height="1080" IsHitTestVisible="False">
                <Canvas Width="60" Height="60" Canvas.Left="{x:Bind X, Converter={StaticResource GridConverter}, Mode=OneWay}" Canvas.Top="{x:Bind Y, Converter={StaticResource GridConverter}, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform Angle="{x:Bind Rotation, Mode=OneWay}" />
                    </Canvas.RenderTransform>
                    <Line X1="0" Y1="30" X2="60" Y2="30" Stroke="{ThemeResource SignalBoxTrackColor}" StrokeThickness="4" />
                </Canvas>
            </Canvas>
        </DataTemplate>

        <DataTemplate x:Key="CurveTrackTemplate" x:DataType="domain:SbTrackCurve">
            <Canvas Width="1920" Height="1080" IsHitTestVisible="False">
                <Canvas Width="60" Height="60" Canvas.Left="{x:Bind X, Converter={StaticResource GridConverter}, Mode=OneWay}" Canvas.Top="{x:Bind Y, Converter={StaticResource GridConverter}, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform Angle="{x:Bind Rotation, Mode=OneWay}" />
                    </Canvas.RenderTransform>
                    <Path Data="M 0,30 Q 30,30 30,60" Stroke="{ThemeResource SignalBoxTrackColor}" StrokeThickness="4" />
                </Canvas>
            </Canvas>
        </DataTemplate>

        <DataTemplate x:Key="SwitchTemplate" x:DataType="domain:SbSwitch">
            <Canvas Width="1920" Height="1080" IsHitTestVisible="False">
                <Canvas Width="60" Height="60" Canvas.Left="{x:Bind X, Converter={StaticResource GridConverter}, Mode=OneWay}" Canvas.Top="{x:Bind Y, Converter={StaticResource GridConverter}, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform Angle="{x:Bind Rotation, Mode=OneWay}" />
                    </Canvas.RenderTransform>
                    <Line X1="0" Y1="30" X2="60" Y2="30" Stroke="{ThemeResource SignalBoxTrackColor}" StrokeThickness="4" />
                    <Line X1="30" Y1="30" X2="60" Y2="0" Stroke="{ThemeResource SignalBoxTrackColor}" StrokeThickness="4" />
                    <Line X1="30" Y1="30" X2="60" Y2="60" Stroke="{ThemeResource SignalBoxTrackColor}" StrokeThickness="4" />
                    <!-- Center dot logic simplified -->
                    <Ellipse Canvas.Left="26" Canvas.Top="26" Width="8" Height="8" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                </Canvas>
            </Canvas>
        </DataTemplate>

        <DataTemplate x:Key="SignalTemplate" x:DataType="domain:SbSignal">
            <Canvas Width="1920" Height="1080" IsHitTestVisible="False">
                <Canvas Width="60" Height="60" Canvas.Left="{x:Bind X, Converter={StaticResource GridConverter}, Mode=OneWay}" Canvas.Top="{x:Bind Y, Converter={StaticResource GridConverter}, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform Angle="{x:Bind Rotation, Mode=OneWay}" />
                    </Canvas.RenderTransform>
                    <controls:KsSignalScreen Width="50" Height="50" Aspect="{x:Bind SignalAspect, Mode=OneWay}" SignalArticleNumber="{x:Bind MainSignalArticleNumber, Mode=OneWay}" Canvas.Left="5" Canvas.Top="5" />
                </Canvas>
            </Canvas>
        </DataTemplate>

        <DataTemplate x:Key="DetectorTemplate" x:DataType="domain:SbDetector">
            <Canvas Width="1920" Height="1080" IsHitTestVisible="False">
                <Canvas Width="60" Height="60" Canvas.Left="{x:Bind X, Converter={StaticResource GridConverter}, Mode=OneWay}" Canvas.Top="{x:Bind Y, Converter={StaticResource GridConverter}, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform Angle="{x:Bind Rotation, Mode=OneWay}" />
                    </Canvas.RenderTransform>
                    <Line X1="0" Y1="30" X2="60" Y2="30" Stroke="{ThemeResource SignalBoxTrackColor}" StrokeThickness="4" />
                    <Ellipse Width="10" Height="10" Fill="{ThemeResource AccentFillColorSecondaryBrush}" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1" Canvas.Left="25" Canvas.Top="25" />
                </Canvas>
            </Canvas>
        </DataTemplate>

        <local:SbElementTemplateSelector x:Key="ElementSelector"
            StraightTrackTemplate="{StaticResource StraightTrackTemplate}"
            CurveTrackTemplate="{StaticResource CurveTrackTemplate}"
            SwitchTemplate="{StaticResource SwitchTemplate}"
            SignalTemplate="{StaticResource SignalTemplate}"
            DetectorTemplate="{StaticResource DetectorTemplate}" />
    </UserControl.Resources>

    <ScrollViewer x:Name="CanvasScrollViewer"
        HorizontalScrollBarVisibility="Auto"
        MinZoomFactor="0.3"
        MaxZoomFactor="3.0"
        VerticalScrollBarVisibility="Auto"
        ZoomMode="Enabled">
        
        <Grid Width="1920" Height="1080">
            <Canvas x:Name="GridCanvas" Width="1920" Height="1080" IsHitTestVisible="False" />
            <ItemsControl ItemsSource="{x:Bind PlanViewModel.Elements, Mode=OneWay}"
                          ItemTemplateSelector="{StaticResource ElementSelector}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas x:Name="TrackCanvas"
                                Width="1920"
                                Height="1080"
                                AllowDrop="True"
                                Background="Transparent"
                                DragOver="OnCanvasDragOver"
                                Drop="OnCanvasDrop"
                                PointerMoved="OnCanvasPointerMoved"
                                PointerPressed="OnCanvasPointerPressed"
                                PointerReleased="OnCanvasPointerReleased" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</UserControl>
