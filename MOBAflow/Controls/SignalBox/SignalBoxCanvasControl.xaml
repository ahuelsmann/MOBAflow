<UserControl
    x:Class="Moba.WinUI.Controls.SignalBox.SignalBoxCanvasControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Moba.WinUI.Controls"
    xmlns:domain="using:Moba.Domain"
    xmlns:local="using:Moba.WinUI.Controls.SignalBox">

    <UserControl.Resources>
        <local:GridCoordinateConverter x:Key="GridConverter" />

        <DataTemplate x:Key="StraightTrackTemplate" x:DataType="domain:SbTrackStraight">
            <Canvas
                Width="1920"
                Height="1080"
                IsHitTestVisible="False">
                <Canvas
                    Canvas.Left="{x:Bind X, Converter={StaticResource GridConverter}, Mode=OneTime}"
                    Canvas.Top="{x:Bind Y, Converter={StaticResource GridConverter}, Mode=OneTime}"
                    Width="60"
                    Height="60"
                    RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform Angle="{x:Bind Rotation, Mode=OneTime}" />
                    </Canvas.RenderTransform>
                    <Line
                        Stroke="{ThemeResource SignalBoxTrackBrush}"
                        StrokeThickness="4"
                        X1="0"
                        X2="60"
                        Y1="30"
                        Y2="30" />
                </Canvas>
            </Canvas>
        </DataTemplate>

        <DataTemplate x:Key="CurveTrackTemplate" x:DataType="domain:SbTrackCurve">
            <Canvas
                Width="1920"
                Height="1080"
                IsHitTestVisible="False">
                <Canvas
                    Canvas.Left="{x:Bind X, Converter={StaticResource GridConverter}, Mode=OneTime}"
                    Canvas.Top="{x:Bind Y, Converter={StaticResource GridConverter}, Mode=OneTime}"
                    Width="60"
                    Height="60"
                    RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform Angle="{x:Bind Rotation, Mode=OneTime}" />
                    </Canvas.RenderTransform>
                    <Path
                        Data="M 0,30 Q 30,30 30,60"
                        Stroke="{ThemeResource SignalBoxTrackBrush}"
                        StrokeThickness="4" />
                </Canvas>
            </Canvas>
        </DataTemplate>

        <DataTemplate x:Key="SwitchTemplate" x:DataType="domain:SbSwitch">
            <Canvas
                Width="1920"
                Height="1080"
                IsHitTestVisible="False">
                <Canvas
                    Canvas.Left="{x:Bind X, Converter={StaticResource GridConverter}, Mode=OneTime}"
                    Canvas.Top="{x:Bind Y, Converter={StaticResource GridConverter}, Mode=OneTime}"
                    Width="60"
                    Height="60"
                    RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform Angle="{x:Bind Rotation, Mode=OneTime}" />
                    </Canvas.RenderTransform>
                    <Line
                        Stroke="{ThemeResource SignalBoxTrackBrush}"
                        StrokeThickness="4"
                        X1="0"
                        X2="60"
                        Y1="30"
                        Y2="30" />
                    <Line
                        Stroke="{ThemeResource SignalBoxTrackBrush}"
                        StrokeThickness="4"
                        X1="30"
                        X2="60"
                        Y1="30"
                        Y2="0" />
                    <Line
                        Stroke="{ThemeResource SignalBoxTrackBrush}"
                        StrokeThickness="4"
                        X1="30"
                        X2="60"
                        Y1="30"
                        Y2="60" />
                    <!--  Center dot logic simplified  -->
                    <Ellipse
                        Canvas.Left="26"
                        Canvas.Top="26"
                        Width="8"
                        Height="8"
                        Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                </Canvas>
            </Canvas>
        </DataTemplate>

        <DataTemplate x:Key="SignalTemplate" x:DataType="domain:SbSignal">
            <Canvas
                Width="1920"
                Height="1080"
                IsHitTestVisible="False">
                <Canvas
                    Canvas.Left="{x:Bind X, Converter={StaticResource GridConverter}, Mode=OneTime}"
                    Canvas.Top="{x:Bind Y, Converter={StaticResource GridConverter}, Mode=OneTime}"
                    Width="60"
                    Height="60"
                    RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform Angle="{x:Bind Rotation, Mode=OneTime}" />
                    </Canvas.RenderTransform>
                    <controls:KsSignalScreen
                        Canvas.Left="5"
                        Canvas.Top="5"
                        Width="50"
                        Height="50"
                        Aspect="{x:Bind SignalAspect, Mode=OneTime}"
                        BottomSpeedValue="{x:Bind BottomSpeedIndicator, Mode=OneTime}"
                        SignalArticleNumber="{x:Bind MainSignalArticleNumber, Mode=OneTime}"
                        TopSpeedValue="{x:Bind TopSpeedIndicator, Mode=OneTime}" />
                </Canvas>
            </Canvas>
        </DataTemplate>

        <DataTemplate x:Key="DetectorTemplate" x:DataType="domain:SbDetector">
            <Canvas
                Width="1920"
                Height="1080"
                IsHitTestVisible="False">
                <Canvas
                    Canvas.Left="{x:Bind X, Converter={StaticResource GridConverter}, Mode=OneTime}"
                    Canvas.Top="{x:Bind Y, Converter={StaticResource GridConverter}, Mode=OneTime}"
                    Width="60"
                    Height="60"
                    RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform Angle="{x:Bind Rotation, Mode=OneTime}" />
                    </Canvas.RenderTransform>
                    <Line
                        Stroke="{ThemeResource SignalBoxTrackBrush}"
                        StrokeThickness="4"
                        X1="0"
                        X2="60"
                        Y1="30"
                        Y2="30" />
                    <Ellipse
                        Canvas.Left="25"
                        Canvas.Top="25"
                        Width="10"
                        Height="10"
                        Fill="{ThemeResource AccentFillColorSecondaryBrush}"
                        Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                        StrokeThickness="1" />
                </Canvas>
            </Canvas>
        </DataTemplate>

        <local:SbElementTemplateSelector
            x:Key="ElementSelector"
            CurveTrackTemplate="{StaticResource CurveTrackTemplate}"
            DetectorTemplate="{StaticResource DetectorTemplate}"
            SignalTemplate="{StaticResource SignalTemplate}"
            StraightTrackTemplate="{StaticResource StraightTrackTemplate}"
            SwitchTemplate="{StaticResource SwitchTemplate}" />
    </UserControl.Resources>

    <ScrollViewer
        x:Name="CanvasScrollViewer"
        HorizontalScrollBarVisibility="Auto"
        MaxZoomFactor="3.0"
        MinZoomFactor="0.3"
        VerticalScrollBarVisibility="Auto"
        ZoomMode="Enabled">

        <Grid Width="1920" Height="1080">
            <Canvas
                Width="1920"
                Height="1080"
                IsHitTestVisible="False" />
            <ItemsControl ItemTemplateSelector="{StaticResource ElementSelector}" ItemsSource="{x:Bind PlanViewModel.Elements, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas
                            Width="1920"
                            Height="1080"
                            AllowDrop="True"
                            Background="Transparent"
                            DragOver="OnCanvasDragOver"
                            Drop="OnCanvasDrop"
                            PointerMoved="OnCanvasPointerMoved"
                            PointerPressed="OnCanvasPointerPressed"
                            PointerReleased="OnCanvasPointerReleased" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</UserControl>
