<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Moba.WinUI.Controls.Matrix.View5x5"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Moba.WinUI.Controls.Matrix"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Row 1  -->
        <Rectangle
            Grid.Row="0"
            Grid.Column="0"
            Fill="{Binding Cell11}" />
        <Rectangle
            Grid.Row="0"
            Grid.Column="1"
            Fill="{Binding Cell12}" />
        <Rectangle
            Grid.Row="0"
            Grid.Column="2"
            Fill="{Binding Cell13}" />
        <Rectangle
            Grid.Row="0"
            Grid.Column="3"
            Fill="{Binding Cell14}" />
        <Rectangle
            Grid.Row="0"
            Grid.Column="4"
            Fill="{Binding Cell15}" />

        <!--  Row 2  -->
        <Rectangle
            Grid.Row="1"
            Grid.Column="0"
            Fill="{Binding Cell21}" />
        <Rectangle
            Grid.Row="1"
            Grid.Column="1"
            Fill="{Binding Cell22}" />
        <Rectangle
            Grid.Row="1"
            Grid.Column="2"
            Fill="{Binding Cell23}" />
        <Rectangle
            Grid.Row="1"
            Grid.Column="3"
            Fill="{Binding Cell24}" />
        <Rectangle
            Grid.Row="1"
            Grid.Column="4"
            Fill="{Binding Cell25}" />

        <!--  Row 3  -->
        <Rectangle
            Grid.Row="2"
            Grid.Column="0"
            Fill="{Binding Cell31}" />
        <Rectangle
            Grid.Row="2"
            Grid.Column="1"
            Fill="{Binding Cell32}" />
        <Rectangle
            Grid.Row="2"
            Grid.Column="2"
            Fill="{Binding Cell33}" />
        <Rectangle
            Grid.Row="2"
            Grid.Column="3"
            Fill="{Binding Cell34}" />
        <Rectangle
            Grid.Row="2"
            Grid.Column="4"
            Fill="{Binding Cell35}" />

        <!--  Row 4  -->
        <Rectangle
            Grid.Row="3"
            Grid.Column="0"
            Fill="{Binding Cell41}" />
        <Rectangle
            Grid.Row="3"
            Grid.Column="1"
            Fill="{Binding Cell42}" />
        <Rectangle
            Grid.Row="3"
            Grid.Column="2"
            Fill="{Binding Cell43}" />
        <Rectangle
            Grid.Row="3"
            Grid.Column="3"
            Fill="{Binding Cell44}" />
        <Rectangle
            Grid.Row="3"
            Grid.Column="4"
            Fill="{Binding Cell45}" />

        <!--  Row 5  -->
        <Rectangle
            Grid.Row="4"
            Grid.Column="0"
            Fill="{Binding Cell51}" />
        <Rectangle
            Grid.Row="4"
            Grid.Column="1"
            Fill="{Binding Cell52}" />
        <Rectangle
            Grid.Row="4"
            Grid.Column="2"
            Fill="{Binding Cell53}" />
        <Rectangle
            Grid.Row="4"
            Grid.Column="3"
            Fill="{Binding Cell54}" />
        <Rectangle
            Grid.Row="4"
            Grid.Column="4"
            Fill="{Binding Cell55}" />
    </Grid>
</UserControl>