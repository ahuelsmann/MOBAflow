<UserControl
    x:Class="Moba.WinUI.Controls.KsSignalScreen"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Ks signal 4046 (main + distant signal): fixed LED grid, uniform scale via Viewbox.
        Lamp positions match the multiplexer layout; aspects per KsSignalScreenVisualState.
    -->

    <Viewbox Stretch="Uniform">
        <Grid
            x:Name="SignalGrid"
            Padding="6"
            ColumnSpacing="3"
            RowSpacing="3"
            Width="90">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopSpeedRow" Height="0" />
                <RowDefinition Height="15" />
                <RowDefinition Height="21" />
                <RowDefinition Height="21" />
                <RowDefinition Height="15" />
                <RowDefinition Height="15" />
                <RowDefinition x:Name="BottomSpeedRow" Height="0" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="17.25" />
                <ColumnDefinition Width="17.25" />
                <ColumnDefinition Width="17.25" />
                <ColumnDefinition Width="17.25" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="HousingBorder"
                Grid.Row="1"
                Grid.RowSpan="5"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                Background="{ThemeResource SignalHousingBackgroundBrush}"
                CornerRadius="4" />

            <Border
                x:Name="TopSpeedBox"
                Grid.Row="0"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Width="36"
                Height="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SignalHousingBackgroundBrush}"
                CornerRadius="2"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="TopSpeedIndicator"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text=""
                    TextAlignment="Center" />
            </Border>

            <Ellipse
                x:Name="W1"
                Grid.Row="1"
                Grid.Column="0"
                Width="12"
                Height="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Fill="{ThemeResource SignalLampOffBrush}" />

            <Ellipse
                x:Name="Hp0"
                Grid.Row="2"
                Grid.Column="2"
                Width="18"
                Height="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Fill="{ThemeResource SignalLampOffBrush}" />

            <Ellipse
                x:Name="Ks1"
                Grid.Row="3"
                Grid.Column="1"
                Width="18"
                Height="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Fill="{ThemeResource SignalLampOffBrush}" />
            <Ellipse
                x:Name="Ks2"
                Grid.Row="3"
                Grid.Column="3"
                Width="18"
                Height="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Fill="{ThemeResource SignalLampOffBrush}" />

            <Ellipse
                x:Name="W2"
                Grid.Row="4"
                Grid.Column="1"
                Width="12"
                Height="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Fill="{ThemeResource SignalLampOffBrush}" />
            <Ellipse
                x:Name="Zs7Center"
                Grid.Row="4"
                Grid.Column="2"
                Width="12"
                Height="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Fill="{ThemeResource SignalLampOffBrush}" />
            <Ellipse
                x:Name="Zs7Right"
                Grid.Row="4"
                Grid.Column="3"
                Width="12"
                Height="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Fill="{ThemeResource SignalLampOffBrush}" />

            <Ellipse
                x:Name="W3"
                Grid.Row="5"
                Grid.Column="0"
                Width="12"
                Height="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Fill="{ThemeResource SignalLampOffBrush}" />
            <Ellipse
                x:Name="Ra12Right"
                Grid.Row="5"
                Grid.Column="1"
                Width="12"
                Height="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Fill="{ThemeResource SignalLampOffBrush}" />

            <Border
                x:Name="BottomSpeedBox"
                Grid.Row="6"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Width="36"
                Height="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SignalHousingBackgroundBrush}"
                CornerRadius="2"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="BottomSpeedIndicator"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Text=""
                    TextAlignment="Center" />
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
