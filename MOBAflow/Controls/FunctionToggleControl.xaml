<UserControl
    x:Class="Moba.WinUI.Controls.FunctionToggleControl"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:Moba.WinUI.Converter">
    <ToggleButton
        x:Name="FunctionToggleButton"
        MinHeight="36"
        Background="{x:Bind converter:BoolToBacklightBrushConverter.CreateBrush(IsOn, BacklightColorHex, Root), Mode=OneWay}"
        Command="{x:Bind ToggleCommand, Mode=OneWay}"
        CommandParameter="{x:Bind FunctionIndex, Mode=OneWay}"
        IsChecked="{x:Bind IsOn, Mode=OneWay}"
        Padding="6,4"
        RightTapped="FunctionToggleButton_RightTapped"
        Style="{StaticResource BacklightToggleButtonStyle}"
        ToolTipService.ToolTip="{x:Bind Description, Mode=OneWay}">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="0" />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="0"
                Width="20"
                Height="20"
                VerticalAlignment="Center"
                converter:FunctionSymbolImageBehavior.AssetName="{x:Bind IconAsset, Mode=OneWay}"
                converter:FunctionSymbolImageBehavior.RenderSize="20" />
            <TextBlock
                x:Name="FunctionLabelText"
                Grid.Column="1"
                MinWidth="28"
                VerticalAlignment="Center"
                FontSize="11"
                FontWeight="SemiBold"
                Text="{x:Bind Label, Mode=OneWay}" />
            <TextBlock
                x:Name="DescriptionText"
                Grid.Column="2"
                VerticalAlignment="Center"
                FontSize="11"
                Text="{x:Bind Description, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                Visibility="{x:Bind Description, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
        </Grid>
    </ToggleButton>
</UserControl>
