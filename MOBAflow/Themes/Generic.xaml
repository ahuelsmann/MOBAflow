<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Moba.WinUI.Controls">

    <!--  Style for CollapsibleColumnHelper (e.g. City/Workflow Library)  -->
    <Style TargetType="controls:CollapsibleColumnHelper">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:CollapsibleColumnHelper">
                    <Grid>
                        <Border
                            x:Name="CollapsedTab"
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="{TemplateBinding Glyph}" />
                            </StackPanel>
                        </Border>

                        <Grid
                            x:Name="ExpandedPanel"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">

                            <!--  Subtle accent bar on the left  -->
                            <Border
                                Width="3"
                                Margin="0,8,0,8"
                                HorizontalAlignment="Left"
                                Background="#FFE666"
                                CornerRadius="2"
                                Opacity="0.16" />

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Padding="12,8,8,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon
                                            Grid.Column="0"
                                            Margin="0,0,8,0"
                                            FontSize="14"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="{TemplateBinding Glyph}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            Text="{TemplateBinding Header}" />

                                        <ContentPresenter
                                            Grid.Column="2"
                                            Margin="8,0,8,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding HeaderActions}" />

                                        <Button
                                            x:Name="CollapseButton"
                                            Grid.Column="3"
                                            Padding="4"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ToolTipService.ToolTip="Unpin panel">
                                            <FontIcon
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE718;" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <ContentPresenter
                                    Grid.Row="1"
                                    Padding="12,4,8,8"
                                    Content="{TemplateBinding PanelContent}" />
                            </Grid>
                        </Grid>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ExpansionStates">
                                <VisualState x:Name="Expanded">
                                    <VisualState.Setters>
                                        <Setter Target="ExpandedPanel.Visibility" Value="Visible" />
                                        <Setter Target="CollapsedTab.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Collapsed">
                                    <VisualState.Setters>
                                        <Setter Target="ExpandedPanel.Visibility" Value="Collapsed" />
                                        <Setter Target="CollapsedTab.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

