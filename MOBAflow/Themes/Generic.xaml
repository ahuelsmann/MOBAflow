<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Moba.WinUI.Controls">

    <!--  Style for CollapsibleColumnHelper (e.g. City/Workflow/Wagon/Track Library)  -->
    <Style TargetType="controls:CollapsibleColumnHelper">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:CollapsibleColumnHelper">
                    <Grid>
                        <Border
                            x:Name="CollapsedTab"
                            Width="32"
                            MinHeight="48"
                            Padding="0,6"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="{TemplateBinding Header}"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            ToolTipService.ToolTip="{TemplateBinding Header}"
                            Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Width="3"
                                    Margin="2,4,0,4"
                                    Background="{ThemeResource MobaColumnHelperAccentBrush}"
                                    CornerRadius="2" />
                                <Border
                                    Grid.Column="1"
                                    Width="22"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource MobaColumnHelperBadgeBackgroundBrush}"
                                    BorderBrush="{ThemeResource MobaColumnHelperBadgeBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <FontIcon
                                        FontSize="12"
                                        Foreground="{ThemeResource MobaColumnHelperAccentBrush}"
                                        Glyph="{TemplateBinding Glyph}" />
                                </Border>
                            </Grid>
                        </Border>

                        <Grid
                            x:Name="ExpandedPanel"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">

                            <!--  Semantic Warm Amber Gold accent bar on the left for Helper/Library columns  -->
                            <Border
                                Width="3.5"
                                Margin="0,8,0,8"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource MobaColumnHelperAccentBrush}"
                                CornerRadius="2" />

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Padding="12,8,8,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Width="26"
                                            Height="26"
                                            Margin="0,0,8,0"
                                            Background="{ThemeResource MobaColumnHelperBadgeBackgroundBrush}"
                                            BorderBrush="{ThemeResource MobaColumnHelperBadgeBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <FontIcon
                                                FontSize="13"
                                                Foreground="{ThemeResource MobaColumnHelperAccentBrush}"
                                                Glyph="{TemplateBinding Glyph}" />
                                        </Border>

                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            Text="{TemplateBinding Header}" />

                                        <ContentPresenter
                                            Grid.Column="2"
                                            Margin="8,0,8,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding HeaderActions}" />

                                        <Button
                                            AutomationProperties.Name="Unpin panel"
                                            x:Name="CollapseButton"
                                            Grid.Column="3"
                                            Padding="4"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ToolTipService.ToolTip="Unpin panel">
                                            <FontIcon
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE718;" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <ContentPresenter
                                    Grid.Row="1"
                                    Padding="12,4,8,8"
                                    Content="{TemplateBinding PanelContent}" />
                            </Grid>
                        </Grid>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ExpansionStates">
                                <VisualState x:Name="Expanded">
                                    <VisualState.Setters>
                                        <Setter Target="ExpandedPanel.Visibility" Value="Visible" />
                                        <Setter Target="CollapsedTab.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Collapsed">
                                    <VisualState.Setters>
                                        <Setter Target="ExpandedPanel.Visibility" Value="Collapsed" />
                                        <Setter Target="CollapsedTab.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

