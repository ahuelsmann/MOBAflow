<Page
    x:Class="Moba.WinUI.View.LocomotivesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Moba.WinUI.Controls"
    xmlns:controls1="using:CommunityToolkit.WinUI.Controls"
    xmlns:converter="using:Moba.WinUI.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="using:Moba.SharedUI.ViewModel"
    DataContext="{x:Bind ViewModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converter:NullableConverter x:Key="NullableConverter" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                x:Name="ColList"
                Width="250"
                MinWidth="32" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition
                x:Name="ColProperties"
                Width="1*"
                MinWidth="32" />
        </Grid.ColumnDefinitions>

        <controls:CollapsibleColumnCollection
            Grid.Column="0"
            Margin="0"
            Glyph="&#xE7C0;"
            Header="Locomotives"
            IsExpanded="{x:Bind ViewModel.IsLocomotivesListExpanded, Mode=TwoWay}">
            <controls:CollapsibleColumnCollection.HeaderActions>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button
                        Padding="4"
                        Command="{x:Bind ViewModel.AddLocomotiveCommand}"
                        ToolTipService.ToolTip="Add a new locomotive">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                    </Button>
                    <Button
                        Padding="4"
                        Command="{x:Bind ViewModel.DeleteLocomotiveCommand}"
                        ToolTipService.ToolTip="Delete the selected locomotive">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    </Button>
                </StackPanel>
            </controls:CollapsibleColumnCollection.HeaderActions>
            <controls:CollapsibleColumnCollection.PanelContent>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <AutoSuggestBox
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        PlaceholderText="Search locomotives..."
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.LocomotiveSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <ListView
                        Grid.Row="1"
                        IsItemClickEnabled="True"
                        ItemsSource="{x:Bind ViewModel.SelectedProject.Locomotives, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedLocomotive, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Command="{x:Bind ViewModel.AddLocomotiveCommand}" Text="Add Locomotive">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE710;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Command="{x:Bind ViewModel.DeleteLocomotiveCommand}" Text="Delete Locomotive">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE738;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodel:LocomotiveViewModel">
                                <Grid Padding="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        FontSize="16"
                                        Glyph="&#xE7C0;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Name, Mode=OneWay}" />
                                    <FontIcon
                                        Grid.Column="2"
                                        FontSize="12"
                                        Foreground="{ThemeResource SystemAccentColor}"
                                        Glyph="&#xEB9F;"
                                        Visibility="{x:Bind HasPhoto, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </controls:CollapsibleColumnCollection.PanelContent>
        </controls:CollapsibleColumnCollection>

        <controls1:GridSplitter
            Grid.Column="1"
            Width="4"
            HorizontalAlignment="Left"
            ResizeBehavior="PreviousAndNext" />

        <controls:CollapsibleColumnProperties
            Grid.Column="2"
            Margin="0"
            Glyph="&#xE946;"
            Header="Properties"
            IsExpanded="{x:Bind ViewModel.IsLocomotivesPropertiesExpanded, Mode=TwoWay}">
            <controls:CollapsibleColumnProperties.PanelContent>
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <InfoBar
                            IsClosable="False"
                            IsOpen="{x:Bind Management.HasAddressFindings, Mode=OneWay}"
                            Message="{x:Bind Management.AddressFindingSummary, Mode=OneWay}"
                            Severity="Warning"
                            Title="Digital address findings" />
                        <ItemsControl ItemsSource="{x:Bind Management.AddressFindings, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewmodel:AddressFindingViewModel">
                                    <TextBlock Margin="8,2" Text="{x:Bind Message}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ContentControl
                            HorizontalContentAlignment="Stretch"
                            Content="{x:Bind ViewModel.SelectedLocomotive, Mode=OneWay}"
                            ContentTemplateSelector="{StaticResource EntityTemplateSelector}"
                            Visibility="{x:Bind ViewModel.SelectedLocomotive, Mode=OneWay, Converter={StaticResource NullableConverter}}" />
                        <Expander Header="Maintenance reminders">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Command="{x:Bind Management.AddMaintenancePlanCommand}" Content="Add reminder" />
                                    <Button Command="{x:Bind Management.AddMaintenanceEntryCommand}" Content="Record maintenance" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{x:Bind Management.MaintenancePlans, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,4" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding State}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                        <Expander Header="Decoder CV backups">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Command="{x:Bind Management.ImportCvSnapshotCommand}" Content="Import backup" />
                                    <Button Command="{x:Bind Management.ExportLatestCvSnapshotCommand}" Content="Export latest" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{x:Bind Management.DecoderSnapshots, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,4">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding CapturedAt}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                        <Expander Header="Feedback whistle automation">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Command="{x:Bind Management.AddWhistleRuleCommand}" Content="Add rule" />
                                    <Button Command="{x:Bind Management.DeleteSelectedWhistleRuleCommand}" Content="Delete selected" />
                                </StackPanel>
                                <ListView
                                    ItemsSource="{x:Bind Management.WhistleRules, Mode=OneWay}"
                                    SelectedItem="{x:Bind Management.SelectedWhistleRule, Mode=TwoWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Padding="8" Spacing="6">
                                                <TextBox Header="Name" Text="{Binding Name, Mode=TwoWay}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <NumberBox Header="Feedback input" Minimum="1" Value="{Binding InPort, Mode=TwoWay}" />
                                                    <NumberBox Header="Function F0–F31" Maximum="31" Minimum="0" Value="{Binding FunctionIndex, Mode=TwoWay}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <NumberBox Header="Delay (ms)" Minimum="0" Value="{Binding DelayMilliseconds, Mode=TwoWay}" />
                                                    <NumberBox Header="Active (ms)" Minimum="1" Value="{Binding ActiveDurationMilliseconds, Mode=TwoWay}" />
                                                </StackPanel>
                                                <ToggleSwitch Header="Enabled" IsOn="{Binding Enabled, Mode=TwoWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Expander>
                        <Button
                            HorizontalAlignment="Left"
                            Command="{x:Bind Management.ExportPassportCommand}"
                            Content="Export printable locomotive passport" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Management.OperationStatus, Mode=OneWay}" />
                    </StackPanel>
                </ScrollViewer>
            </controls:CollapsibleColumnProperties.PanelContent>
        </controls:CollapsibleColumnProperties>
    </Grid>
</Page>
