<Page
    x:Class="Moba.WinUI.View.SignalBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Moba.WinUI.Controls"
    xmlns:controls1="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:signalbox="using:Moba.WinUI.Controls.SignalBox"
    mc:Ignorable="d">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Delete" Invoked="OnDeleteAccelerator" />
        <KeyboardAccelerator Key="Back" Invoked="OnDeleteAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Toolbar  -->
        <CommandBar
            Grid.Row="0"
            DefaultLabelPosition="Right"
            OverflowButtonVisibility="Auto">
            <AppBarButton
                x:Name="DeleteButton"
                Click="OnDeleteButtonClick"
                Icon="Delete"
                Label="Delete"
                ToolTipService.ToolTip="Delete selected element (Del)" />
        </CommandBar>
        <Border
            Grid.Row="1"
            Padding="12,8"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        Text="{x:Bind InterlockingViewModel.StatusText, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind InterlockingViewModel.Revision, Mode=OneWay}" />
                    <ComboBox
                        Width="160"
                        AutomationProperties.Name="Operational turnout"
                        DisplayMemberPath="Name"
                        ItemsSource="{x:Bind InterlockingViewModel.Turnouts}"
                        PlaceholderText="Select turnout"
                        SelectedItem="{x:Bind InterlockingViewModel.SelectedTurnout, Mode=TwoWay}" />
                    <Button
                        Command="{x:Bind InterlockingViewModel.SetTurnoutStraightCommand}"
                        Content="Straight"
                        IsEnabled="{x:Bind InterlockingViewModel.CanOperateTurnout, Mode=OneWay}" />
                    <Button
                        Command="{x:Bind InterlockingViewModel.SetTurnoutDivergingLeftCommand}"
                        Content="Left"
                        IsEnabled="{x:Bind InterlockingViewModel.CanOperateTurnout, Mode=OneWay}" />
                    <Button
                        Command="{x:Bind InterlockingViewModel.SetTurnoutDivergingRightCommand}"
                        Content="Right"
                        IsEnabled="{x:Bind InterlockingViewModel.CanOperateTurnout, Mode=OneWay}" />
                    <TextBlock
                        MaxWidth="220"
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind InterlockingViewModel.SelectedTurnout.AccessibleState, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind InterlockingViewModel.SelectedTurnout.AccessibleState, Mode=OneWay}" />
                    <ComboBox
                        Width="150"
                        AutomationProperties.Name="Protected block"
                        DisplayMemberPath="Name"
                        ItemsSource="{x:Bind InterlockingViewModel.Blocks}"
                        PlaceholderText="Select block"
                        SelectedItem="{x:Bind InterlockingViewModel.SelectedBlock, Mode=TwoWay}" />
                    <TextBlock
                        MaxWidth="200"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind InterlockingViewModel.SelectedBlock.AccessibleState, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind InterlockingViewModel.SelectedBlock.AccessibleState, Mode=OneWay}" />
                    <ComboBox
                        Width="150"
                        AutomationProperties.Name="Protected signal"
                        DisplayMemberPath="Name"
                        ItemsSource="{x:Bind InterlockingViewModel.Signals}"
                        PlaceholderText="Select signal"
                        SelectedItem="{x:Bind InterlockingViewModel.SelectedSignal, Mode=TwoWay}" />
                    <TextBlock
                        MaxWidth="200"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind InterlockingViewModel.SelectedSignal.AccessibleState, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind InterlockingViewModel.SelectedSignal.AccessibleState, Mode=OneWay}" />
                    <ComboBox
                        Width="160"
                        AutomationProperties.Name="Interlocking route"
                        DisplayMemberPath="Name"
                        ItemsSource="{x:Bind InterlockingViewModel.Routes}"
                        PlaceholderText="Select route"
                        SelectedItem="{x:Bind InterlockingViewModel.SelectedRoute, Mode=TwoWay}" />
                    <Button
                        Command="{x:Bind InterlockingViewModel.PreviewRouteCommand}"
                        Content="Preview"
                        IsEnabled="{x:Bind InterlockingViewModel.CanOperateRoute, Mode=OneWay}" />
                    <Button
                        Command="{x:Bind InterlockingViewModel.SelectRouteCommand}"
                        Content="Select"
                        IsEnabled="{x:Bind InterlockingViewModel.CanOperateRoute, Mode=OneWay}" />
                    <Button
                        Command="{x:Bind InterlockingViewModel.SetRouteCommand}"
                        Content="Set"
                        IsEnabled="{x:Bind InterlockingViewModel.CanOperateRoute, Mode=OneWay}" />
                    <Button
                        Command="{x:Bind InterlockingViewModel.CancelRouteCommand}"
                        Content="Cancel"
                        IsEnabled="{x:Bind InterlockingViewModel.HasSelectedRoute, Mode=OneWay}" />
                    <Button
                        Command="{x:Bind InterlockingViewModel.ReleaseRouteCommand}"
                        Content="Release"
                        IsEnabled="{x:Bind InterlockingViewModel.HasSelectedRoute, Mode=OneWay}" />
                    <Button
                        Command="{x:Bind InterlockingViewModel.ReconcileRouteCommand}"
                        Content="Reconcile"
                        IsEnabled="{x:Bind InterlockingViewModel.HasSelectedRoute, Mode=OneWay}" />
                    <TextBlock
                        MaxWidth="220"
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind InterlockingViewModel.SelectedRoute.AccessibleState, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind InterlockingViewModel.SelectedRoute.AccessibleState, Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  Main Content: Toolbox | Canvas | Properties  -->
        <Grid
            Grid.Row="2"
            Padding="0"
            ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    x:Name="ColToolbox"
                    Width="240"
                    MinWidth="32" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition
                    x:Name="ColCanvas"
                    Width="3*"
                    MinWidth="100" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition
                    x:Name="ColProperties"
                    Width="1*"
                    MinWidth="32" />
            </Grid.ColumnDefinitions>

            <!--  LEFT: Toolbox Panel  -->
            <controls:CollapsibleColumnHelper
                Grid.Column="0"
                Margin="0"
                Glyph="&#xE70F;"
                Header="Elements"
                IsExpanded="{x:Bind ViewModel.IsSignalBoxToolboxExpanded, Mode=TwoWay}">
                <controls:CollapsibleColumnHelper.PanelContent>
                    <signalbox:SignalBoxToolboxControl />
                </controls:CollapsibleColumnHelper.PanelContent>
            </controls:CollapsibleColumnHelper>

            <controls1:GridSplitter
                Grid.Column="1"
                Width="4"
                HorizontalAlignment="Left"
                ResizeBehavior="PreviousAndNext" />

            <!--  CENTER: Stellwerk Canvas (clipped so the internal 1920x1080 surface does not push the status bar off-screen)  -->
            <Border
                Grid.Column="2"
                Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0">
                <signalbox:SignalBoxCanvasControl
                    x:Name="CanvasControl"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            </Border>

            <controls1:GridSplitter
                Grid.Column="3"
                Width="4"
                HorizontalAlignment="Left"
                ResizeBehavior="PreviousAndNext" />

            <!--  RIGHT: Properties Panel  -->
            <controls:CollapsibleColumnProperties
                Grid.Column="4"
                Margin="0"
                Glyph="&#xE946;"
                Header="Properties"
                IsExpanded="{x:Bind ViewModel.IsSignalBoxPropertiesExpanded, Mode=TwoWay}">
                <controls:CollapsibleColumnProperties.PanelContent>
                    <signalbox:SignalBoxPropertiesControl
                        x:Name="PropertiesControl" />
                </controls:CollapsibleColumnProperties.PanelContent>
            </controls:CollapsibleColumnProperties>
        </Grid>

        <!--  Status Bar  -->
        <Border
            Grid.Row="3"
            MinHeight="32"
            Padding="16,8"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="" />
                <TextBlock
                    x:Name="ElementCountText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="Elements: 0" />
            </Grid>
        </Border>
    </Grid>
</Page>
