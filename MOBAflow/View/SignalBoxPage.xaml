<Page
    x:Class="Moba.WinUI.View.SignalBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Moba.WinUI.Controls"
    xmlns:controls1="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:signalbox="using:Moba.WinUI.Controls.SignalBox"
    mc:Ignorable="d">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Delete" Invoked="OnDeleteAccelerator" />
        <KeyboardAccelerator Key="Back" Invoked="OnDeleteAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Toolbar  -->
        <CommandBar
            Grid.Row="0"
            DefaultLabelPosition="Right"
            OverflowButtonVisibility="Auto">
            <AppBarButton
                x:Name="DeleteButton"
                Click="OnDeleteButtonClick"
                Icon="Delete"
                Label="Delete"
                ToolTipService.ToolTip="Delete selected element (Del)" />
            <AppBarButton
                x:Name="ContextButton"
                AutomationProperties.HelpText="{x:Bind InterlockingViewModel.AvailabilityDescription, Mode=OneWay}"
                Click="OnContextButtonClick"
                Command="{x:Bind ViewModel.OpenSignalBoxWorkbenchCommand}"
                Icon="ContactInfo"
                Label="Context"
                ToolTipService.ToolTip="{x:Bind InterlockingViewModel.AvailabilityDescription, Mode=OneWay}" />
        </CommandBar>
        <!--  Main Content: Toolbox | Canvas | Properties  -->
        <Grid
            x:Name="MainGrid"
            Grid.Row="1"
            Padding="0"
            ColumnSpacing="0">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="WorkbenchLayoutStates">
                    <VisualState x:Name="WideWorkbenchState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1024" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="CompactWorkbenchState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ColProperties.Width" Value="0" />
                            <Setter Target="RightWorkbenchSplitter.Visibility" Value="Collapsed" />
                            <Setter Target="WorkbenchHost.(Grid.Column)" Value="2" />
                            <Setter Target="WorkbenchHost.HorizontalAlignment" Value="Right" />
                            <Setter Target="WorkbenchHost.Width" Value="360" />
                            <Setter Target="WorkbenchHost.(Panel.ZIndex)" Value="10" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    x:Name="ColToolbox"
                    Width="240"
                    MinWidth="32" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition
                    x:Name="ColCanvas"
                    Width="3*"
                    MinWidth="100" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition
                    x:Name="ColProperties"
                    Width="1*"
                    MinWidth="32" />
            </Grid.ColumnDefinitions>

            <!--  LEFT: Toolbox Panel  -->
            <controls:CollapsibleColumnHelper
                Grid.Column="0"
                Margin="0"
                Glyph="&#xE70F;"
                Header="Elements"
                IsExpanded="{x:Bind ViewModel.IsSignalBoxToolboxExpanded, Mode=TwoWay}">
                <controls:CollapsibleColumnHelper.PanelContent>
                    <signalbox:SignalBoxToolboxControl />
                </controls:CollapsibleColumnHelper.PanelContent>
            </controls:CollapsibleColumnHelper>

            <controls1:GridSplitter
                Grid.Column="1"
                Width="4"
                HorizontalAlignment="Left"
                ResizeBehavior="PreviousAndNext" />

            <!--  CENTER: Stellwerk Canvas (clipped so the internal 1920x1080 surface does not push the status bar off-screen)  -->
            <Border
                Grid.Column="2"
                Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0">
                <signalbox:SignalBoxCanvasControl
                    x:Name="CanvasControl"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            </Border>

            <controls1:GridSplitter
                x:Name="RightWorkbenchSplitter"
                Grid.Column="3"
                Width="4"
                HorizontalAlignment="Left"
                ResizeBehavior="PreviousAndNext" />

            <!--  RIGHT: Selected Object Workbench  -->
            <controls:CollapsibleColumnProperties
                x:Name="WorkbenchHost"
                Grid.Column="4"
                Margin="0"
                MaxWidth="420"
                Glyph="&#xE946;"
                Header="Context"
                IsExpanded="{x:Bind ViewModel.IsSignalBoxPropertiesExpanded, Mode=TwoWay}">
                <controls:CollapsibleColumnProperties.PanelContent>
                    <controls:SelectedObjectWorkbench
                        x:Name="SelectedObjectWorkbench"
                        Context="{x:Bind InterlockingViewModel}">
                        <controls:SelectedObjectWorkbench.DefinitionContent>
                            <StackPanel Padding="0,8,0,0" Spacing="8">
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.SolutionSaveStatusText, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                                <signalbox:SignalBoxPropertiesControl
                                    x:Name="PropertiesControl" />
                            </StackPanel>
                        </controls:SelectedObjectWorkbench.DefinitionContent>
                    </controls:SelectedObjectWorkbench>
                </controls:CollapsibleColumnProperties.PanelContent>
            </controls:CollapsibleColumnProperties>
        </Grid>

        <!--  Status Bar  -->
        <Border
            Grid.Row="2"
            MinHeight="32"
            Padding="16,8"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="" />
                <TextBlock
                    x:Name="ElementCountText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="Elements: 0" />
            </Grid>
        </Border>
    </Grid>
</Page>
