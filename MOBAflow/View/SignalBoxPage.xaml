<Page
    x:Class="Moba.WinUI.View.SignalBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Moba.WinUI.Controls"
    xmlns:controls1="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:signalbox="using:Moba.WinUI.Controls.SignalBox"
    mc:Ignorable="d">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Delete" Invoked="OnDeleteAccelerator" />
        <KeyboardAccelerator Key="Back" Invoked="OnDeleteAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Toolbar  -->
        <CommandBar
            Grid.Row="0"
            DefaultLabelPosition="Right"
            OverflowButtonVisibility="Auto">
            <AppBarButton
                x:Name="DeleteButton"
                Click="OnDeleteButtonClick"
                Icon="Delete"
                Label="Delete"
                ToolTipService.ToolTip="Delete selected element (Del)" />
        </CommandBar>

        <!--  Main Content: Toolbox | Canvas | Properties  -->
        <Grid
            Grid.Row="1"
            Padding="0"
            ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    x:Name="ColToolbox"
                    Width="240"
                    MinWidth="32" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="100" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition
                    x:Name="ColProperties"
                    Width="300"
                    MinWidth="32" />
            </Grid.ColumnDefinitions>

            <!--  LEFT: Toolbox Panel  -->
            <controls:CollapsibleColumnHelper
                Grid.Column="0"
                Margin="0"
                Glyph="&#xE70F;"
                Header="Elements"
                IsExpanded="{x:Bind ViewModel.IsSignalBoxToolboxExpanded, Mode=TwoWay}">
                <controls:CollapsibleColumnHelper.PanelContent>
                    <signalbox:SignalBoxToolboxControl />
                </controls:CollapsibleColumnHelper.PanelContent>
            </controls:CollapsibleColumnHelper>

            <controls1:GridSplitter
                Grid.Column="1"
                Width="4"
                HorizontalAlignment="Left"
                ResizeBehavior="PreviousAndNext" />

            <!--  CENTER: Stellwerk Canvas (clipped so the internal 1920x1080 surface does not push the status bar off-screen)  -->
            <Border
                Grid.Column="2"
                Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0">
                <signalbox:SignalBoxCanvasControl
                    x:Name="CanvasControl"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            </Border>

            <controls1:GridSplitter
                Grid.Column="3"
                Width="4"
                HorizontalAlignment="Left"
                ResizeBehavior="PreviousAndNext" />

            <!--  RIGHT: Properties Panel  -->
            <controls:CollapsibleColumnProperties
                Grid.Column="4"
                Margin="0"
                Glyph="&#xE946;"
                Header="Properties"
                IsExpanded="{x:Bind ViewModel.IsSignalBoxPropertiesExpanded, Mode=TwoWay}">
                <controls:CollapsibleColumnProperties.PanelContent>
                    <signalbox:SignalBoxPropertiesControl
                        x:Name="PropertiesControl"
                        RequestElementDeletion="OnPropertyControlElementDeletion"
                        RequestVisualRefresh="OnPropertyControlVisualRefresh"
                        ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
                </controls:CollapsibleColumnProperties.PanelContent>
            </controls:CollapsibleColumnProperties>
        </Grid>

        <!--  Status Bar  -->
        <Border
            Grid.Row="2"
            MinHeight="32"
            Padding="16,8"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="" />
                <TextBlock
                    x:Name="ElementCountText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="Elements: 0" />
            </Grid>
        </Border>
    </Grid>
</Page>
