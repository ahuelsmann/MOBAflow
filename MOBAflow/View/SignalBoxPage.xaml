<Page
    x:Class="Moba.WinUI.View.SignalBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Moba.WinUI.Controls"
    xmlns:controls1="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:signalbox="using:Moba.WinUI.Controls.SignalBox"
    mc:Ignorable="d">

    <Grid Padding="0" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Page Header - Fluent Design System  -->
        <Border
            Grid.Row="0"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid Padding="32,20,32,20" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Title  -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level1"
                        FontSize="32"
                        FontWeight="SemiBold"
                        Text="Signal Box" />
                </StackPanel>

                <!--  Grid Toggle  -->
                <ToggleButton
                    x:Name="GridToggleButton"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Checked="OnGridToggled"
                    IsChecked="True"
                    ToolTipService.ToolTip="Raster ein-/ausblenden"
                    Unchecked="OnGridToggled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE80A;" />
                        <TextBlock Text="Raster" />
                    </StackPanel>
                </ToggleButton>

                <!--  Toolbox Toggle (for Medium/Compact)  -->
                <ToggleButton
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    IsChecked="True"
                    ToolTipService.ToolTip="Toolbox ein-/ausblenden"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE70F;" />
                        <TextBlock Text="Toolbox" />
                    </StackPanel>
                </ToggleButton>

                <!--  Properties Toggle (for Medium/Compact)  -->
                <ToggleButton
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    IsChecked="True"
                    ToolTipService.ToolTip="Eigenschaften ein-/ausblenden"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE713;" />
                        <TextBlock Text="Eigenschaften" />
                    </StackPanel>
                </ToggleButton>

                <!--  Skin Selector Button with Flyout  -->
                <Button
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Farbschema auswählen">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE790;" />
                            <TextBlock Text="Skin" />
                        </StackPanel>
                    </Button.Content>
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="200" Spacing="8">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="FARBSCHEMA WÄHLEN" />
                                <Button HorizontalAlignment="Stretch" Command="{x:Bind SkinViewModel.SelectSystemCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border
                                            Width="20"
                                            Height="20"
                                            Background="{ThemeResource SystemAccentColor}"
                                            CornerRadius="4" />
                                        <TextBlock VerticalAlignment="Center" Text="System" />
                                    </StackPanel>
                                </Button>
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="COLOR SKINS" />
                                <Button HorizontalAlignment="Stretch" Command="{x:Bind SkinViewModel.SelectBlueCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border
                                            Width="20"
                                            Height="20"
                                            Background="{ThemeResource SkinBlueBrush}"
                                            CornerRadius="4" />
                                        <TextBlock VerticalAlignment="Center" Text="Blau" />
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" Command="{x:Bind SkinViewModel.SelectGreenCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border
                                            Width="20"
                                            Height="20"
                                            Background="{ThemeResource SkinGreenBrush}"
                                            CornerRadius="4" />
                                        <TextBlock VerticalAlignment="Center" Text="Grün" />
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" Command="{x:Bind SkinViewModel.SelectOrangeCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border
                                            Width="20"
                                            Height="20"
                                            Background="{ThemeResource SkinOrangeBrush}"
                                            CornerRadius="4" />
                                        <TextBlock VerticalAlignment="Center" Text="Orange" />
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" Command="{x:Bind SkinViewModel.SelectRedCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border
                                            Width="20"
                                            Height="20"
                                            Background="{ThemeResource SkinRedBrush}"
                                            CornerRadius="4" />
                                        <TextBlock VerticalAlignment="Center" Text="Red" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <!--  Main Content: Toolbox | Canvas | Properties  -->
        <Grid
            Grid.Row="1"
            Padding="0"
            ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    x:Name="ColToolbox"
                    Width="240"
                    MinWidth="32" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="100" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition
                    x:Name="ColProperties"
                    Width="300"
                    MinWidth="32" />
            </Grid.ColumnDefinitions>

            <!--  LEFT: Toolbox Panel  -->
            <controls:CollapsibleColumnHelper
                Grid.Column="0"
                Margin="0"
                Glyph="&#xE70F;"
                Header="Elemente"
                IsExpanded="{x:Bind ViewModel.IsSignalBoxToolboxExpanded, Mode=TwoWay}">
                <controls:CollapsibleColumnHelper.PanelContent>
                    <signalbox:SignalBoxToolboxControl />
                </controls:CollapsibleColumnHelper.PanelContent>
            </controls:CollapsibleColumnHelper>

            <controls1:GridSplitter
                Grid.Column="1"
                Width="4"
                HorizontalAlignment="Left"
                ResizeBehavior="PreviousAndNext" />

            <!--  CENTER: Stellwerk Canvas  -->
            <Border
                Grid.Column="2"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0">
                <signalbox:SignalBoxCanvasControl x:Name="CanvasControl" />
            </Border>

            <controls1:GridSplitter
                Grid.Column="3"
                Width="4"
                HorizontalAlignment="Left"
                ResizeBehavior="PreviousAndNext" />

            <!--  RIGHT: Properties Panel  -->
            <controls:CollapsibleColumnProperties
                Grid.Column="4"
                Margin="0"
                Glyph="&#xE946;"
                Header="Eigenschaften"
                IsExpanded="{x:Bind ViewModel.IsSignalBoxPropertiesExpanded, Mode=TwoWay}">
                <controls:CollapsibleColumnProperties.PanelContent>
                    <signalbox:SignalBoxPropertiesControl
                        x:Name="PropertiesControl"
                        RequestElementDeletion="OnPropertyControlElementDeletion"
                        RequestVisualRefresh="OnPropertyControlVisualRefresh"
                        ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
                </controls:CollapsibleColumnProperties.PanelContent>
            </controls:CollapsibleColumnProperties>
        </Grid>
    </Grid>
</Page>
