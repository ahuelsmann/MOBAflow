<Page
    x:Class="Moba.WinUI.View.EventManagerPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="using:Moba.WinUI.Behavior"
    xmlns:controls="using:Moba.WinUI.Controls"
    xmlns:converter="using:Moba.WinUI.Converter"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:domain="using:Moba.Domain"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:viewmodel="using:Moba.SharedUI.ViewModel"
    xmlns:steps="using:Moba.SharedUI.ViewModel.WorkflowSteps">

    <Page.Resources>
        <converter:BoolToPickerStateBrushConverter x:Key="RepeatBorderBrushConverter" Role="Border" />
    </Page.Resources>

    <Grid Padding="8" ColumnSpacing="0" KeyDown="OnPageKeyDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ToolboxColumn" Width="220" MinWidth="32" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="ValuesColumn" Width="260" MinWidth="32" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="PropertiesColumn" Width="300" MinWidth="32" />
        </Grid.ColumnDefinitions>

        <controls:CollapsibleColumnHelper x:Name="ToolboxPanel" Grid.Column="0" Header="Toolbox" Glyph="&#xE945;">
            <controls:CollapsibleColumnHelper.PanelContent>
                <Grid Padding="8" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ComboBox Header="Journey" DisplayMemberPath="Name" ItemsSource="{x:Bind ViewModel.Journeys, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedJourney, Mode=TwoWay}" />
                    <NumberBox Grid.Row="1" Header="Default InPort" Minimum="1" Maximum="512" SpinButtonPlacementMode="Inline" Value="{Binding DefaultInPort, Mode=TwoWay}" />
                    <ListView x:Name="ToolboxList" Grid.Row="2" CanDragItems="True" DragItemsStarting="ToolboxList_DragItemsStarting" DoubleTapped="ToolboxList_DoubleTapped" ItemsSource="{x:Bind ViewModel.ToolboxElements}" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodel:EventElementDescriptor">
                                <Border Margin="0,4" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="{x:Bind DefaultRepeatCount}" />
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Description}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </controls:CollapsibleColumnHelper.PanelContent>
        </controls:CollapsibleColumnHelper>

        <toolkit:GridSplitter Grid.Column="1" Width="4" ResizeBehavior="PreviousAndNext" />

        <Grid Grid.Column="2" Margin="8,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <CommandBar DefaultLabelPosition="Right">
                <AppBarButton Icon="Undo" Label="Undo" Command="{x:Bind ViewModel.UndoCommand}" />
                <AppBarButton Icon="Redo" Label="Redo" Command="{x:Bind ViewModel.RedoCommand}" />
                <AppBarButton Icon="Delete" Label="Delete step" Command="{x:Bind ViewModel.DeleteStepCommand}" CommandParameter="{x:Bind ViewModel.SelectedStep, Mode=OneWay}" />
            </CommandBar>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="SequenceDropSurface" Padding="16" AllowDrop="True" Background="{ThemeResource LayerFillColorDefaultBrush}" DragOver="Sequence_DragOver" Drop="Sequence_Drop">
                    <ItemsRepeater x:Name="StepsRepeater" ItemsSource="{x:Bind ViewModel.Steps}">
                        <ItemsRepeater.Layout><StackLayout Orientation="Vertical" Spacing="20" /></ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="viewmodel:JourneyFeedbackStepViewModel">
                                <Border x:Name="StepCard" Tag="{x:Bind}" CanDrag="True" DragStarting="StepCard_DragStarting" Tapped="StepCard_Tapped" Padding="16" AutomationProperties.Name="{x:Bind AutomationName}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{x:Bind IsRepeat, Mode=OneWay, Converter={StaticResource RepeatBorderBrushConverter}, ConverterParameter={Binding ElementName=PageRoot}}" BorderThickness="3" CornerRadius="18">
                                    <i:Interaction.Behaviors>
                                        <behavior:WorkflowDropBehavior Command="{x:Bind AssignWorkflowCommand}" />
                                        <behavior:StationDropBehavior Command="{x:Bind AssignStationCommand}" />
                                    </i:Interaction.Behaviors>
                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock x:Name="RepeatText" HorizontalAlignment="Center" FontSize="52" FontWeight="Bold" Foreground="{x:Bind IsRepeat, Mode=OneWay, Converter={StaticResource BoolToAccentBrushConverter}, ConverterParameter={Binding ElementName=PageRoot}}" Text="{x:Bind RepeatCount, Mode=OneWay}" />
                                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="{x:Bind InPortText, Mode=OneWay}" />
                                        <Grid Grid.Row="2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Workflow" />
                                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind WorkflowName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="2" Padding="4" Command="{x:Bind RemoveWorkflowCommand}" ToolTipService.ToolTip="Remove workflow"><FontIcon Glyph="&#xE711;" /></Button>
                                        </Grid>
                                        <Grid Grid.Row="3" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Stop" />
                                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind StopName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="2" Padding="4" Command="{x:Bind RemoveStopTransitionCommand}" ToolTipService.ToolTip="Remove stop change"><FontIcon Glyph="&#xE711;" /></Button>
                                        </Grid>
                                        <TextBlock Grid.Row="4" HorizontalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" Text="{x:Bind RuntimeProgress, Mode=OneWay}" />
                                    </Grid>
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Remove workflow" Command="{x:Bind RemoveWorkflowCommand}" />
                                            <MenuFlyoutItem Text="Remove stop change" Command="{x:Bind RemoveStopTransitionCommand}" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Delete feedback step" Command="{Binding ViewModel.DeleteStepCommand, ElementName=PageRoot}" CommandParameter="{x:Bind}" />
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>
            </ScrollViewer>
        </Grid>

        <toolkit:GridSplitter Grid.Column="3" Width="4" ResizeBehavior="PreviousAndNext" />

        <controls:CollapsibleColumnHelper x:Name="ValuesPanel" Grid.Column="4" Header="Values" Glyph="&#xE8A5;">
            <controls:CollapsibleColumnHelper.PanelContent>
                <Grid Padding="8" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <AutoSuggestBox PlaceholderText="Search workflows..." Text="{x:Bind ViewModel.WorkflowLibrary.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ListView
                        x:Name="WorkflowValuesList"
                        Grid.Row="1"
                        AutomationProperties.Name="Contextual workflow library"
                        CanDragItems="True"
                        DragItemsStarting="WorkflowValues_DragItemsStarting"
                        DoubleTapped="WorkflowValues_DoubleTapped"
                        ItemsSource="{x:Bind ViewModel.WorkflowLibrary.FilteredWorkflows, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.WorkflowLibrary.SelectedWorkflow, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate><DataTemplate x:DataType="viewmodel:WorkflowViewModel"><TextBlock Padding="6" Text="{x:Bind Name}" /></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <CommandBar Grid.Row="2" DefaultLabelPosition="Collapsed" OverflowButtonVisibility="Auto">
                        <AppBarButton Icon="Add" Label="Create workflow" Command="{x:Bind ViewModel.WorkflowLibrary.CreateWorkflowCommand}" />
                        <AppBarButton Icon="Copy" Label="Duplicate workflow" Command="{x:Bind ViewModel.WorkflowLibrary.DuplicateSelectedWorkflowCommand}" />
                        <AppBarButton Icon="Delete" Label="Delete workflow" Command="{x:Bind ViewModel.WorkflowLibrary.DeleteSelectedWorkflowCommand}" />
                        <AppBarSeparator />
                        <AppBarButton Icon="Play" Label="Add action" Command="{x:Bind ViewModel.WorkflowLibrary.SelectedWorkflow.AddStepCommand}" CommandParameter="{x:Bind steps:WorkflowStepKind.Action}" />
                        <AppBarButton Icon="Clock" Label="Add delay" Command="{x:Bind ViewModel.WorkflowLibrary.SelectedWorkflow.AddStepCommand}" CommandParameter="{x:Bind steps:WorkflowStepKind.Delay}" />
                        <AppBarButton Icon="Filter" Label="Add condition" Command="{x:Bind ViewModel.WorkflowLibrary.SelectedWorkflow.AddStepCommand}" CommandParameter="{x:Bind steps:WorkflowStepKind.Condition}" />
                        <AppBarButton Icon="Stop" Label="Add termination" Command="{x:Bind ViewModel.WorkflowLibrary.SelectedWorkflow.AddStepCommand}" CommandParameter="{x:Bind steps:WorkflowStepKind.Terminate}" />
                    </CommandBar>
                    <ListView
                        Grid.Row="3"
                        AutomationProperties.Name="Contextual workflow steps"
                        ItemsSource="{x:Bind ViewModel.WorkflowLibrary.SelectedWorkflow.Steps, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.WorkflowLibrary.SelectedStep, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="steps:WorkflowStepViewModel">
                                <Grid Padding="6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Kind}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button
                        Grid.Row="4"
                        HorizontalAlignment="Stretch"
                        Content="Assign selected workflow to feedback step"
                        Command="{x:Bind ViewModel.WorkflowLibrary.AssignSelectedWorkflowCommand}"
                        CommandParameter="{x:Bind ViewModel.SelectedStep}" />
                    <AutoSuggestBox Grid.Row="5" PlaceholderText="Search stops..." Text="{x:Bind ViewModel.StationSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ListView x:Name="StationValuesList" Grid.Row="6" CanDragItems="True" DragItemsStarting="StationValues_DragItemsStarting" DoubleTapped="StationValues_DoubleTapped" ItemsSource="{x:Bind ViewModel.Stations, Mode=OneWay}" SelectionMode="Single">
                        <ListView.ItemTemplate><DataTemplate x:DataType="viewmodel:StationAssignmentOption"><TextBlock Padding="6" Text="{x:Bind Name}" /></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </controls:CollapsibleColumnHelper.PanelContent>
        </controls:CollapsibleColumnHelper>

        <toolkit:GridSplitter Grid.Column="5" Width="4" ResizeBehavior="PreviousAndNext" />

        <controls:CollapsibleColumnProperties x:Name="PropertiesPanel" Grid.Column="6" Header="Properties" Glyph="&#xE946;">
            <controls:CollapsibleColumnProperties.PanelContent>
                <ScrollViewer Padding="12">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="12" DataContext="{x:Bind ViewModel.SelectedStep, Mode=OneWay}">
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Feedback occurrence" />
                            <NumberBox Header="InPort" Minimum="1" Maximum="512" SpinButtonPlacementMode="Inline" Value="{Binding InPort, Mode=TwoWay}" />
                            <NumberBox Header="Repeat count" Minimum="1" SpinButtonPlacementMode="Inline" Value="{Binding RepeatCount, Mode=TwoWay}" />
                            <ComboBox Header="Workflow" DisplayMemberPath="Name" ItemsSource="{Binding AvailableWorkflows}" SelectedValue="{Binding WorkflowId, Mode=TwoWay}" SelectedValuePath="Id" />
                            <ComboBox Header="Stop mode" ItemsSource="{Binding StopModes}" SelectedItem="{Binding StopMode, Mode=TwoWay}" />
                            <ComboBox Header="Target stop" DisplayMemberPath="Name" ItemsSource="{Binding AvailableStations}" SelectedValue="{Binding TargetStationId, Mode=TwoWay}" SelectedValuePath="Id" />
                            <NumberBox Header="Delay (ms)" Minimum="0" SpinButtonPlacementMode="Inline" Value="{Binding DelayMs, Mode=TwoWay}" />
                            <ComboBox Header="Only when current stop is" DisplayMemberPath="Name" ItemsSource="{Binding AvailableStations}" SelectedValue="{Binding ConditionStationId, Mode=TwoWay}" SelectedValuePath="Id" />
                            <ToggleSwitch Header="Enabled" IsOn="{Binding Enabled, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Workflow editor" />
                        <ContentControl
                            HorizontalContentAlignment="Stretch"
                            Content="{x:Bind ViewModel.WorkflowLibrary.SelectedEditorObject, Mode=OneWay}"
                            ContentTemplateSelector="{StaticResource EntityTemplateSelector}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button Content="Dry run" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.WorkflowLibrary.DryRunSelectedWorkflowCommand}" />
                            <Button Grid.Column="1" Content="Validate" Command="{x:Bind ViewModel.WorkflowLibrary.ValidateCommand}" />
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.WorkflowLibrary.ValidationIssues, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Margin="0,2" Text="{Binding Message}" TextWrapping="Wrap" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </controls:CollapsibleColumnProperties.PanelContent>
        </controls:CollapsibleColumnProperties>
    </Grid>
</Page>
