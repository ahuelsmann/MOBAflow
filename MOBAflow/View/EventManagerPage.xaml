<Page
    x:Class="Moba.WinUI.View.EventManagerPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Moba.WinUI.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewmodel="using:Moba.SharedUI.ViewModel">
    <Grid Padding="8" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                <ComboBox Header="Journey" HorizontalAlignment="Stretch" DisplayMemberPath="Name" PlaceholderText="Select a journey"
                          ItemsSource="{x:Bind ViewModel.Journeys, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedJourney, Mode=TwoWay}" />
                <NumberBox Grid.Column="1" Header="Default InPort" Minimum="1" Maximum="512" SpinButtonPlacementMode="Inline"
                           Value="{x:Bind ViewModel.DefaultInPort, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                           ToolTipService.ToolTip="InPort used for new events" />
            </Grid>
            <StackPanel x:Name="JourneyCommands" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button Content="Start journey" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.MainWindow.StartJourneyCommand}" />
                <Button Content="Stop" Command="{x:Bind ViewModel.MainWindow.StopJourneyCommand}" ToolTipService.ToolTip="Stop journey" />
                <Button AutomationProperties.Name="Journey options" ToolTipService.ToolTip="Journey options">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Reset all InPort counters" Command="{x:Bind ViewModel.MainWindow.ResetCountersCommand}"
                                            ToolTipService.ToolTip="Available when all journeys are stopped." />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="8"
                    Visibility="{x:Bind ViewModel.HasPlanNotice, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="{x:Bind ViewModel.PlanStatus, Mode=OneWay}" />
            <Button Content="Create event plan" Command="{x:Bind ViewModel.CreateEventPlanCommand}"
                    Visibility="{x:Bind ViewModel.IsLegacyJourney, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>
        <Grid x:Name="EditorColumns" Grid.Row="2" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="EventPlanColumn" Width="2*" MinWidth="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="WorkflowLibraryColumn" Width="*" MinWidth="32" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="PropertiesColumn" Width="1.2*" MinWidth="32" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="CompactPanelsRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid x:Name="PlanArea" Margin="0,0,4,0" RowSpacing="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <CommandBar DefaultLabelPosition="Collapsed" OverflowButtonVisibility="Auto">
                    <CommandBar.Content>
                        <TextBlock Margin="4,0,8,0" VerticalAlignment="Center" Text="{x:Bind ViewModel.EventCountLabel, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                    </CommandBar.Content>
                    <AppBarButton Icon="Add" Label="Add event" ToolTipService.ToolTip="Add event" Command="{x:Bind ViewModel.AddEventCommand}" />
                    <AppBarButton Icon="Remove" Label="Delete event" ToolTipService.ToolTip="Delete selected event" Command="{x:Bind ViewModel.DeleteSelectedEventCommand}" />
                    <AppBarSeparator />
                    <AppBarButton Icon="Undo" Label="Undo" ToolTipService.ToolTip="Undo" Command="{x:Bind ViewModel.UndoCommand}" />
                    <AppBarButton Icon="Redo" Label="Redo" ToolTipService.ToolTip="Redo" Command="{x:Bind ViewModel.RedoCommand}" />
                    <CommandBar.SecondaryCommands>
                        <AppBarButton Icon="Copy" Label="Duplicate event" Command="{x:Bind ViewModel.DuplicateSelectedEventCommand}" />
                        <AppBarButton Icon="Up" Label="Move up" Command="{x:Bind ViewModel.MoveSelectedEventUpCommand}" />
                        <AppBarButton Label="Move down" Command="{x:Bind ViewModel.MoveSelectedEventDownCommand}">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE74B;" /></AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar.SecondaryCommands>
                </CommandBar>
                <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid Padding="4" RowSpacing="8" AllowDrop="True" Background="{ThemeResource LayerFillColorDefaultBrush}"
                          DragOver="Plan_DragOver" DragLeave="Plan_DragLeave" Drop="Plan_Drop">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ItemsRepeater x:Name="EventsRepeater" ItemsSource="{x:Bind ViewModel.Events}"
                                       AutomationProperties.Name="Journey events" ElementPrepared="EventsRepeater_ElementPrepared"
                                       PreviewKeyDown="EventsRepeater_PreviewKeyDown">
                            <ItemsRepeater.Layout><StackLayout Orientation="Vertical" Spacing="4" /></ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="viewmodel:JourneyEventViewModel">
                                    <ListViewItem Tag="{x:Bind}" Padding="8,8" MinHeight="64" CornerRadius="4" HorizontalContentAlignment="Stretch"
                                                  IsSelected="{x:Bind IsSelected, Mode=OneWay}" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                                                  Tapped="EventRow_Tapped" GotFocus="EventRow_GotFocus" ContextRequested="EventRow_ContextRequested"
                                                  CanDrag="True" DragStarting="EventHandle_DragStarting" AllowDrop="True"
                                                  DragOver="EventRow_DragOver" DragLeave="EventRow_DragLeave" Drop="EventRow_Drop">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind InPortText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind CountLabel, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                               ToolTipService.ToolTip="Activation count for this InPort since journey start" />
                                                </Grid>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE945;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind WorkflowName, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{x:Bind WorkflowName, Mode=OneWay}" />
                                                    <TextBlock Grid.Column="2" Text="Disabled" Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Visibility="{x:Bind Enabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                                </Grid>
                                            </StackPanel>
                                            <Button Grid.Column="1" Tag="{x:Bind}" Width="32" Height="32" Padding="4" VerticalAlignment="Center"
                                                    Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="Event actions"
                                                    ToolTipService.ToolTip="Event actions" Click="EventActions_Click">
                                                <FontIcon Glyph="&#xE712;" FontSize="16" />
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Remove workflow" Command="{x:Bind RemoveWorkflowCommand}" />
                                                        <MenuFlyoutItem Text="Duplicate event" Tag="{x:Bind}" IsEnabled="{x:Bind CanEdit, Mode=OneWay}" Click="DuplicateEvent_Click" />
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Delete event" Tag="{x:Bind}" IsEnabled="{x:Bind CanEdit, Mode=OneWay}" Click="DeleteEvent_Click" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                            <Border x:Name="RowDropIndicator" Grid.ColumnSpan="2" Margin="-8" CornerRadius="4" BorderThickness="2"
                                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0" IsHitTestVisible="False" />
                                        </Grid>
                                        <ListViewItem.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Remove workflow" Command="{x:Bind RemoveWorkflowCommand}" />
                                                <MenuFlyoutItem Text="Duplicate event" Tag="{x:Bind}" IsEnabled="{x:Bind CanEdit, Mode=OneWay}" Click="DuplicateEvent_Click" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Delete event" Tag="{x:Bind}" IsEnabled="{x:Bind CanEdit, Mode=OneWay}" Click="DeleteEvent_Click" />
                                            </MenuFlyout>
                                        </ListViewItem.ContextFlyout>
                                    </ListViewItem>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <StackPanel Grid.Row="1" Padding="16" Spacing="4"
                                    Visibility="{x:Bind ViewModel.IsEmptyPlan, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Add your first event" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Choose an InPort and count, then assign a workflow." TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Grid Grid.Row="2" MinHeight="40" Visibility="{x:Bind ViewModel.HasEventPlan, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Padding="8" Text="Drop a workflow here to add an event" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Border x:Name="AddDropIndicator" CornerRadius="4" BorderThickness="2" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </ScrollViewer>
                <TextBlock Grid.Row="2" Margin="4" Text="Counts since journey start, separately for each InPort."
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </Grid>
            <toolkit:GridSplitter x:Name="LibrarySplitter" Grid.Column="1" Width="4" ResizeBehavior="PreviousAndNext" />
            <controls:CollapsibleColumnHelper x:Name="ValuesPanel" Grid.Column="2" Header="Values" Glyph="&#xE8A5;">
                <controls:CollapsibleColumnHelper.PanelContent>
                    <Grid Padding="8" RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Workflows" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <AutoSuggestBox Grid.Row="1" PlaceholderText="Search workflows..." AutomationProperties.Name="Search workflows"
                                        Text="{x:Bind ViewModel.WorkflowLibrary.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ListView x:Name="WorkflowValuesList" Grid.Row="2" CanDragItems="True" SelectionMode="Single"
                                  ItemsSource="{x:Bind ViewModel.WorkflowLibrary.FilteredWorkflows, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.WorkflowLibrary.SelectedWorkflow, Mode=TwoWay}"
                                  DragItemsStarting="WorkflowValues_DragItemsStarting" DoubleTapped="WorkflowValues_DoubleTapped"
                                  AutomationProperties.Name="Workflows to assign to an event" ToolTipService.ToolTip="Drag a workflow onto an event to assign it">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="32" />
                                    <Setter Property="Padding" Value="8,4" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodel:WorkflowViewModel">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </controls:CollapsibleColumnHelper.PanelContent>
            </controls:CollapsibleColumnHelper>
            <toolkit:GridSplitter x:Name="PropertiesSplitter" Grid.Column="3" Width="4" ResizeBehavior="PreviousAndNext" />
            <controls:CollapsibleColumnProperties x:Name="PropertiesPanel" Grid.Column="4" Header="Properties" Glyph="&#xE946;">
                <controls:CollapsibleColumnProperties.PanelContent>
                    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="12" Spacing="12" DataContext="{x:Bind ViewModel.SelectedEvent, Mode=OneWay}">
                            <TextBlock Text="Event" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <NumberBox Header="InPort" Minimum="1" Maximum="512" SpinButtonPlacementMode="Inline"
                                       Value="{Binding InPort, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEditSelectedEvent, Mode=OneWay}" />
                            <TextBox Header="Count since journey start" Text="{Binding CountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     InputScope="Number" IsEnabled="{x:Bind ViewModel.CanEditSelectedEvent, Mode=OneWay}" />
                            <TextBlock Text="{Binding CountValidationMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       Visibility="{Binding HasCountValidationError, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <ComboBox Header="Workflow" HorizontalAlignment="Stretch" DisplayMemberPath="Name"
                                      ItemsSource="{Binding AvailableWorkflows}" SelectedValue="{Binding WorkflowId, Mode=TwoWay}" SelectedValuePath="Id"
                                      PlaceholderText="Choose a workflow" IsEnabled="{x:Bind ViewModel.CanEditSelectedEvent, Mode=OneWay}" />
                            <ToggleSwitch Header="Enabled" IsOn="{Binding Enabled, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEditSelectedEvent, Mode=OneWay}" />
                        </StackPanel>
                    </ScrollViewer>
                </controls:CollapsibleColumnProperties.PanelContent>
            </controls:CollapsibleColumnProperties>
        </Grid>
        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.MainWindow.JourneyCommandStatus, Mode=OneWay}" TextWrapping="Wrap"
                   Visibility="{x:Bind ViewModel.HasCommandStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Page>
