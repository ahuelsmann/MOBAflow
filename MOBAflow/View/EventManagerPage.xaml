<Page
    x:Class="Moba.WinUI.View.EventManagerPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewmodel="using:Moba.SharedUI.ViewModel">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Microsoft.UI.Xaml/DensityStyles/Compact.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="EventColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="PageLayout" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="JourneyHeader" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="8">
                <TextBlock Text="Event plan" Style="{StaticResource TitleTextBlockStyle}" />
                <ComboBox MinWidth="240" MaxWidth="460" HorizontalAlignment="Left" VerticalAlignment="Center"
                          DisplayMemberPath="Name" PlaceholderText="Select a journey"
                          AutomationProperties.Name="Journey"
                          ItemsSource="{x:Bind ViewModel.Journeys, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedJourney, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel x:Name="JourneyCommands" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.MainWindow.StartJourneyCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE768;" FontSize="14" />
                        <TextBlock Text="Start journey" />
                    </StackPanel>
                </Button>
                <Button Content="Stop" Command="{x:Bind ViewModel.MainWindow.StopJourneyCommand}" ToolTipService.ToolTip="Stop journey" />
                <Button AutomationProperties.Name="Journey options" ToolTipService.ToolTip="Journey options">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE712;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Reset all InPort counters" Command="{x:Bind ViewModel.MainWindow.ResetCountersCommand}"
                                            ToolTipService.ToolTip="Available when all journeys are stopped." />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8"
                    Visibility="{x:Bind ViewModel.HasPlanNotice, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                     Message="{x:Bind ViewModel.PlanStatus, Mode=OneWay}" />
            <Button Content="Create event plan" Command="{x:Bind ViewModel.CreateEventPlanCommand}"
                    Visibility="{x:Bind ViewModel.IsLegacyJourney, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <Grid x:Name="EditorColumns" Grid.Row="2" ColumnSpacing="12" RowSpacing="12" SizeChanged="OnPageSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="EventPlanColumn" Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="WorkflowLibraryColumn" Width="*" MaxWidth="340" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="PlanArea" RowSpacing="12" AllowDrop="True" Background="Transparent"
                  DragOver="Plan_DragOver" DragLeave="Plan_DragLeave" Drop="Plan_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Events" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.EventCountLabel, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.AddEventCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Add event" />
                        </StackPanel>
                    </Button>
                    <CommandBar Grid.Column="2" HorizontalContentAlignment="Right" DefaultLabelPosition="Collapsed"
                                Background="Transparent" IsDynamicOverflowEnabled="True" OverflowButtonVisibility="Visible">
                        <AppBarButton Icon="Undo" Label="Undo" Command="{x:Bind ViewModel.UndoCommand}" DynamicOverflowOrder="2" />
                        <AppBarButton Icon="Redo" Label="Redo" Command="{x:Bind ViewModel.RedoCommand}" DynamicOverflowOrder="3" />
                        <AppBarToggleButton x:Name="WorkflowLibraryToggle" Label="Workflow library" IsChecked="True"
                                            Checked="WorkflowLibraryToggle_Changed" Unchecked="WorkflowLibraryToggle_Changed"
                                            DynamicOverflowOrder="1">
                            <AppBarToggleButton.Icon>
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8A5;" />
                            </AppBarToggleButton.Icon>
                        </AppBarToggleButton>
                        <CommandBar.SecondaryCommands>
                            <AppBarButton Icon="Copy" Label="Duplicate event" Command="{x:Bind ViewModel.DuplicateSelectedEventCommand}" />
                            <AppBarButton Icon="Up" Label="Move up" Command="{x:Bind ViewModel.MoveSelectedEventUpCommand}" />
                            <AppBarButton Label="Move down" Command="{x:Bind ViewModel.MoveSelectedEventDownCommand}">
                                <AppBarButton.Icon>
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE74B;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Icon="Delete" Label="Delete event" Command="{x:Bind ViewModel.DeleteSelectedEventCommand}" />
                        </CommandBar.SecondaryCommands>
                    </CommandBar>
                </Grid>

                <ListView x:Name="EventList" Grid.Row="1" VerticalAlignment="Top" Background="Transparent"
                          ItemsSource="{x:Bind ViewModel.Events}" SelectedItem="{x:Bind ViewModel.SelectedEvent, Mode=TwoWay}"
                          SelectionMode="Single" KeyDown="EventList_KeyDown"
                          ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.Header>
                        <Grid Padding="12,4,12,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="InPort" Style="{StaticResource EventColumnHeader}" />
                            <TextBlock Grid.Column="2" Text="Count" Style="{StaticResource EventColumnHeader}"
                                       ToolTipService.ToolTip="Accepted activations on this InPort since journey start." />
                            <TextBlock Grid.Column="3" Text="Run workflow" Style="{StaticResource EventColumnHeader}" />
                            <FontIcon Grid.Column="4" FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE73E;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="Event enabled" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodel:JourneyEventViewModel">
                            <Border Tag="{x:Bind}" Padding="12,8" AllowDrop="True"
                                    DragOver="EventRow_DragOver" DragLeave="EventRow_DragLeave" Drop="EventRow_Drop"
                                    CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Width="24" Height="32" VerticalAlignment="Center" Tag="{x:Bind}"
                                          CanDrag="True" DragStarting="EventHandle_DragStarting" Background="Transparent"
                                          ToolTipService.ToolTip="Drag to move. Hold Ctrl to copy.">
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE700;" FontSize="12"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                    <NumberBox Grid.Column="1" Minimum="1" Maximum="512" SmallChange="1"
                                               SpinButtonPlacementMode="Compact" MinHeight="32" VerticalAlignment="Center"
                                               Value="{Binding InPort, Mode=TwoWay}" IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                               AutomationProperties.Name="InPort" />
                                    <TextBox Grid.Column="2" MinHeight="32" VerticalAlignment="Center"
                                             Text="{x:Bind CountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{x:Bind CanEdit, Mode=OneWay}" AutomationProperties.Name="Count since journey start"
                                             ToolTipService.ToolTip="{x:Bind CountText, Mode=OneWay}" />
                                    <ComboBox Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Center" MinHeight="32"
                                              DisplayMemberPath="Name" ItemsSource="{x:Bind AvailableWorkflows, Mode=OneWay}"
                                              SelectedValue="{x:Bind WorkflowId, Mode=TwoWay}" SelectedValuePath="Id"
                                              PlaceholderText="Drop or choose a workflow" IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                              AutomationProperties.Name="Workflow" ToolTipService.ToolTip="{x:Bind WorkflowName, Mode=OneWay}" />
                                    <CheckBox Grid.Column="4" MinWidth="0" Width="32" MinHeight="32" Padding="0" VerticalAlignment="Center"
                                              IsChecked="{x:Bind Enabled, Mode=TwoWay}" IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                              AutomationProperties.Name="Event enabled" ToolTipService.ToolTip="Event enabled" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3"
                                               Text="{x:Bind CountValidationMessage, Mode=OneWay}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{x:Bind HasCountValidationError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <Border x:Name="RowDropIndicator" Grid.ColumnSpan="5" Grid.RowSpan="2" Margin="-12,-8"
                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2"
                                            CornerRadius="6" Opacity="0" IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.Footer>
                        <StackPanel Spacing="8" Margin="0,4,0,0">
                            <StackPanel Padding="24" HorizontalAlignment="Center" Spacing="8"
                                        Visibility="{x:Bind ViewModel.IsEmptyPlan, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Build your journey, one event at a time" TextAlignment="Center"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Choose an InPort and count, then add a workflow."
                                           TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Border x:Name="AddDropTarget" Padding="12" MinHeight="48" CornerRadius="6"
                                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Grid>
                                    <Grid ColumnSpacing="8" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE710;" FontSize="14"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="Drop a workflow to add an event" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </Grid>
                                    <Border x:Name="AddDropIndicator" Margin="-12" CornerRadius="6" BorderThickness="2"
                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0" IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ListView.Footer>
                </ListView>
                <TextBlock Grid.Row="2" Text="Counts start with the journey, separately for each InPort."
                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <toolkit:GridSplitter x:Name="LibrarySplitter" Grid.Column="1" Width="4" ResizeBehavior="PreviousAndNext" />

            <Border x:Name="WorkflowLibraryPanel" Grid.Column="2" Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ScrollViewer x:Name="WorkflowLibraryScroller" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Workflows" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Drag onto an event" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Workflow library options">
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE712;" FontSize="16" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Create workflow" Command="{x:Bind ViewModel.WorkflowLibrary.CreateWorkflowCommand}" />
                                        <MenuFlyoutItem Text="Duplicate workflow" Command="{x:Bind ViewModel.WorkflowLibrary.DuplicateSelectedWorkflowCommand}" />
                                        <MenuFlyoutItem Text="Delete workflow" Command="{x:Bind ViewModel.WorkflowLibrary.DeleteSelectedWorkflowCommand}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <AutoSuggestBox Grid.Row="1" PlaceholderText="Search workflows" QueryIcon="Find"
                                        Text="{x:Bind ViewModel.WorkflowLibrary.SearchText, Mode=TwoWay}" />
                        <ListView x:Name="WorkflowValuesList" Grid.Row="2" CanDragItems="True"
                                  DragItemsStarting="WorkflowValues_DragItemsStarting" DoubleTapped="WorkflowValues_DoubleTapped"
                                  ItemsSource="{x:Bind ViewModel.WorkflowLibrary.FilteredWorkflows, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.WorkflowLibrary.SelectedWorkflow, Mode=TwoWay}"
                                  ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="8" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodel:WorkflowViewModel">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8A5;" FontSize="16"
                                                  VerticalAlignment="Top" Margin="0,3,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="4" ToolTipService.ToolTip="{x:Bind Description, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Description, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Grid Grid.Row="3" ColumnSpacing="12" Padding="0,8,0,0" BorderThickness="0,1,0,0"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="InPort for new events" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <NumberBox Grid.Column="1" Minimum="1" Maximum="512" SpinButtonPlacementMode="Compact"
                                       VerticalAlignment="Center" Value="{Binding DefaultInPort, Mode=TwoWay}"
                                       IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.Name="InPort for new events" />
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.MainWindow.JourneyCommandStatus, Mode=OneWay}"
                   Visibility="{x:Bind ViewModel.HasCommandStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                   TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Page>
