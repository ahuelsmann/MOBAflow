<Page
    x:Class="Moba.WinUI.View.JourneysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Moba.WinUI.Controls"
    xmlns:controls1="using:CommunityToolkit.WinUI.Controls"
    xmlns:converter="using:Moba.WinUI.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Moba.Domain"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:Moba.WinUI.Behavior"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="using:Moba.SharedUI.ViewModel"
    DataContext="{x:Bind ViewModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converter:ResourceKeyToBrushConverter x:Key="ResourceKeyToBrushConverter" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                x:Name="ColJourneys"
                Width="250"
                MinWidth="32" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Journeys  -->
        <controls:CollapsibleColumnCollection
            Grid.Column="0"
            Margin="0"
            Glyph="&#xE7C1;"
            Header="Journeys"
            IsExpanded="{x:Bind ViewModel.IsJourneyListExpanded, Mode=TwoWay}">
            <controls:CollapsibleColumnCollection.HeaderActions>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button
                        Padding="4"
                        Command="{x:Bind ViewModel.AddJourneyCommand}"
                        ToolTipService.ToolTip="Create a new journey">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                    </Button>
                    <Button
                        Padding="4"
                        Command="{x:Bind ViewModel.DeleteJourneyCommand}"
                        ToolTipService.ToolTip="Remove the selected journey">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    </Button>
                </StackPanel>
            </controls:CollapsibleColumnCollection.HeaderActions>
            <controls:CollapsibleColumnCollection.PanelContent>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <AutoSuggestBox
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        PlaceholderText="Search journeys..."
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.JourneySearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <ListView
                        Grid.Row="1"
                        IsItemClickEnabled="True"
                        ItemsSource="{x:Bind ViewModel.SelectedProject.Journeys, Mode=OneWay}"
                        KeyDown="JourneysListView_KeyDown"
                        SelectedItem="{x:Bind ViewModel.SelectedJourney, Mode=TwoWay}"
                        SelectionMode="Single">
                        <i:Interaction.Behaviors>
                            <local:ListViewItemClickBehavior Command="{x:Bind ViewModel.JourneysPageItemClickedCommand}" />
                        </i:Interaction.Behaviors>
                        <ListView.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Command="{x:Bind ViewModel.AddJourneyCommand}" Text="Add Journey">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE710;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Command="{x:Bind ViewModel.DeleteJourneyCommand}" Text="Delete Journey">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodel:JourneyViewModel">
                                <Grid Padding="6">
                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Name, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </controls:CollapsibleColumnCollection.PanelContent>
        </controls:CollapsibleColumnCollection>

        <Grid Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    x:Name="ColStations"
                    Width="250"
                    MinWidth="32" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--  Stations (of selected Journey)  -->
            <controls:CollapsibleColumnCollection
                Grid.Column="0"
                Margin="0"
                Glyph="&#xE81D;"
                Header="Stations"
                IsExpanded="{x:Bind ViewModel.IsStationListExpanded, Mode=TwoWay}">
                <controls:CollapsibleColumnCollection.HeaderActions>
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button
                            Padding="4"
                            Command="{x:Bind ViewModel.AddStationCommand}"
                            ToolTipService.ToolTip="Add a new station to this journey">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                        </Button>
                        <Button
                            Padding="4"
                            Command="{x:Bind ViewModel.AddEventCommand}"
                            ToolTipService.ToolTip="Add a new event to this journey"
                            Visibility="{x:Bind ViewModel.IsStationTimelineView, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon FontSize="14" Glyph="&#xE945;" />
                        </Button>
                        <Button
                            Padding="4"
                            Command="{x:Bind ViewModel.DeleteStationCommand}"
                            ToolTipService.ToolTip="Remove the selected station">
                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        </Button>
                    </StackPanel>
                </controls:CollapsibleColumnCollection.HeaderActions>
                <controls:CollapsibleColumnCollection.PanelContent>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ToggleSwitch
                            Grid.Row="0"
                            Margin="0,0,0,8"
                            IsOn="{x:Bind ViewModel.IsStationTimelineView, Mode=TwoWay}"
                            OffContent="Normal View"
                            OnContent="Advanced View" />

                        <AutoSuggestBox
                            Grid.Row="1"
                            Margin="0,0,0,8"
                            PlaceholderText="Search stations..."
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.SelectedJourney.StationSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ListView
                            x:Name="StationListView"
                            Grid.Row="2"
                            AllowDrop="True"
                            CanDragItems="{x:Bind ViewModel.IsStationTimelineView, Mode=OneWay}"
                            DragItemsStarting="StationListView_DragItemsStarting"
                            DragOver="StationListView_DragOver"
                            Drop="StationListView_Drop"
                            IsItemClickEnabled="True"
                            ItemsSource="{x:Bind ViewModel.SelectedJourney.FilteredStations, Mode=OneWay}"
                            KeyDown="StationsListView_KeyDown"
                            SelectedItem="{x:Bind ViewModel.SelectedStation, Mode=TwoWay}"
                            SelectionMode="Single">
                            <i:Interaction.Behaviors>
                                <local:ListViewItemClickBehavior Command="{x:Bind ViewModel.JourneysPageItemClickedCommand}" />
                            </i:Interaction.Behaviors>
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Command="{x:Bind ViewModel.AddStationCommand}" Text="Add Station">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE710;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind ViewModel.DeleteStationCommand}" Text="Delete Station">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodel:StationViewModel">
                                    <Grid Padding="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!--  Current Station Indicator  -->
                                        <Border
                                            Grid.ColumnSpan="2"
                                            Margin="-6"
                                            Background="{ThemeResource SystemAccentColorLight2}"
                                            CornerRadius="4"
                                            Opacity="0.3"
                                            Visibility="{x:Bind IsCurrentStation, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <FontIcon
                                            Grid.Column="0"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            Glyph="{x:Bind StationIconGlyph, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind StationKindText, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            Text="{x:Bind Name, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </controls:CollapsibleColumnCollection.PanelContent>
            </controls:CollapsibleColumnCollection>

            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        x:Name="ColCityLib"
                        Width="250"
                        MinWidth="32" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--  City Library  -->
                <controls:CollapsibleColumnHelper
                    Grid.Column="0"
                    Margin="0"
                    Glyph="&#xEC06;"
                    Header="City Library"
                    IsExpanded="{x:Bind ViewModel.IsCityLibraryVisible, Mode=TwoWay}">
                    <controls:CollapsibleColumnHelper.PanelContent>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <AutoSuggestBox
                                Grid.Row="0"
                                Margin="0,0,0,8"
                                PlaceholderText="Search cities..."
                                QueryIcon="Find"
                                Text="{x:Bind ViewModel.CitySearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <ScrollViewer
                                Grid.Row="1"
                                VerticalScrollBarVisibility="Auto"
                                VerticalScrollMode="Auto">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Drag or double-click to add" />
                                    <ListView
                                        CanDragItems="True"
                                        DoubleTapped="CityListView_DoubleTapped"
                                        DragItemsStarting="CityListView_DragItemsStarting"
                                        ItemsSource="{x:Bind ViewModel.CityLibrary, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedCity, Mode=TwoWay}"
                                        SelectionMode="Single">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="domain:City">
                                                <Grid Padding="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        Text="{x:Bind Name}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </controls:CollapsibleColumnHelper.PanelContent>
                </controls:CollapsibleColumnHelper>

                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            x:Name="ColWorkflowLib"
                            Width="250"
                            MinWidth="32" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--  Workflow Library  -->
                    <controls:CollapsibleColumnHelper
                        Grid.Column="0"
                        Margin="0"
                        Glyph="&#xE945;"
                        Header="Workflow Library"
                        IsExpanded="{x:Bind ViewModel.IsWorkflowLibraryVisible, Mode=TwoWay}">
                        <controls:CollapsibleColumnHelper.PanelContent>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <AutoSuggestBox
                                    Grid.Row="0"
                                    Margin="0,0,0,8"
                                    PlaceholderText="Search workflows..."
                                    QueryIcon="Find"
                                    Text="{x:Bind ViewModel.WorkflowSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <ScrollViewer
                                    Grid.Row="1"
                                    VerticalScrollBarVisibility="Auto"
                                    VerticalScrollMode="Auto">
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="Drag to station to assign" />
                                        <ListView
                                            CanDragItems="True"
                                            DragItemsStarting="WorkflowListView_DragItemsStarting"
                                            ItemsSource="{x:Bind ViewModel.FilteredWorkflows, Mode=OneWay}"
                                            SelectionMode="Single">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodel:WorkflowViewModel">
                                                    <Grid Padding="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            Text="{x:Bind Name, Mode=OneWay}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </controls:CollapsibleColumnHelper.PanelContent>
                    </controls:CollapsibleColumnHelper>

                    <!--  Properties Panel  -->
                    <controls:CollapsibleColumnProperties
                        Grid.Column="2"
                        Margin="0"
                        Glyph="&#xE946;"
                        Header="{x:Bind ViewModel.JourneysPagePropertiesTitle, Mode=OneWay}"
                        IsExpanded="{x:Bind ViewModel.IsJourneyPropertiesExpanded, Mode=TwoWay}">
                        <controls:CollapsibleColumnProperties.PanelContent>
                            <ContentControl
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Content="{x:Bind ViewModel.JourneysPageSelectedObject, Mode=OneWay}"
                                ContentTemplateSelector="{StaticResource EntityTemplateSelector}" />
                        </controls:CollapsibleColumnProperties.PanelContent>
                    </controls:CollapsibleColumnProperties>

                    <controls1:GridSplitter
                        Grid.Column="1"
                        Width="4"
                        HorizontalAlignment="Left"
                        ResizeBehavior="PreviousAndNext"
                        Visibility="{x:Bind ViewModel.IsWorkflowLibraryVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>

                <controls1:GridSplitter
                    Grid.Column="1"
                    Width="4"
                    HorizontalAlignment="Left"
                    ResizeBehavior="PreviousAndNext"
                    Visibility="{x:Bind ViewModel.IsCityLibraryVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

            <!--  Splitter between Stations and City Lib/Rest  -->
            <controls1:GridSplitter
                Grid.Column="1"
                Width="4"
                HorizontalAlignment="Left"
                ResizeBehavior="PreviousAndNext" />
        </Grid>

        <!--  Splitter between Journeys and Stations/Rest  -->
        <controls1:GridSplitter
            Grid.Column="1"
            Width="4"
            HorizontalAlignment="Left"
            ResizeBehavior="PreviousAndNext" />
    </Grid>
</Page>