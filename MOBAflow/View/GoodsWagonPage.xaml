<Page
    x:Class="Moba.WinUI.View.GoodsWagonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="using:Moba.WinUI.Behavior"
    xmlns:controls="using:Moba.WinUI.Controls"
    xmlns:converter="using:Moba.WinUI.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="using:Moba.SharedUI.ViewModel"
    DataContext="{x:Bind ViewModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converter:NullableConverter x:Key="NullableConverter" />
    </Page.Resources>

    <Grid>
        <i:Interaction.Behaviors>
            <behavior:GridColumnResizeBehavior PersistenceKey="GoodsWagonPage" />
        </i:Interaction.Behaviors>

        <Grid.ColumnDefinitions>
            <ColumnDefinition
                x:Name="ColList"
                Width="{x:Bind ViewModel.LayoutColumnWidths.GoodsWagonPage.Col0, Mode=OneWay, Converter={StaticResource DoubleToGridLengthConverter}}"
                MinWidth="32" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition
                x:Name="ColProperties"
                Width="1*"
                MinWidth="32" />
        </Grid.ColumnDefinitions>

        <controls:CollapsibleColumnCollection
            Grid.Column="0"
            Margin="0"
            Glyph="&#xE7C0;"
            Header="Goods Wagons"
            IsExpanded="{x:Bind ViewModel.IsGoodsWagonListExpanded, Mode=TwoWay}">
            <controls:CollapsibleColumnCollection.HeaderActions>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button
                        Padding="4"
                        Command="{x:Bind ViewModel.AddGoodsWagonCommand}"
                        ToolTipService.ToolTip="Add a new goods wagon">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                    </Button>
                    <Button
                        Padding="4"
                        Command="{x:Bind ViewModel.DeleteGoodsWagonCommand}"
                        ToolTipService.ToolTip="Delete the selected goods wagon">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    </Button>
                </StackPanel>
            </controls:CollapsibleColumnCollection.HeaderActions>
            <controls:CollapsibleColumnCollection.PanelContent>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <AutoSuggestBox
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        PlaceholderText="Search goods wagons..."
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.GoodsWagonSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <ListView
                        Grid.Row="1"
                        IsItemClickEnabled="True"
                        ItemsSource="{x:Bind ViewModel.SelectedProject.GoodsWagons, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedGoodsWagon, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Command="{x:Bind ViewModel.AddGoodsWagonCommand}" Text="Add Goods Wagon">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE710;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Command="{x:Bind ViewModel.DeleteGoodsWagonCommand}" Text="Delete Goods Wagon">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE738;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodel:GoodsWagonViewModel">
                                <Grid Padding="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        FontSize="16"
                                        Glyph="&#xE7C0;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Name, Mode=OneWay}" />
                                    <FontIcon
                                        Grid.Column="2"
                                        FontSize="12"
                                        Foreground="{ThemeResource SystemAccentColor}"
                                        Glyph="&#xEB9F;"
                                        Visibility="{x:Bind HasPhoto, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </controls:CollapsibleColumnCollection.PanelContent>
        </controls:CollapsibleColumnCollection>

        <Border
            Grid.Column="1"
            Width="4"
            HorizontalAlignment="Left"
            behavior:GridColumnResizeBehavior.SplitterMode="Left"
            Background="{ThemeResource CardStrokeColorDefaultBrush}" />

        <controls:CollapsibleColumnProperties
            Grid.Column="2"
            Margin="0"
            Glyph="&#xE946;"
            Header="Properties"
            IsExpanded="{x:Bind ViewModel.IsGoodsWagonPropertiesExpanded, Mode=TwoWay}">
            <controls:CollapsibleColumnProperties.PanelContent>
                <ContentControl
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Content="{x:Bind ViewModel.SelectedGoodsWagon, Mode=OneWay}"
                    ContentTemplateSelector="{StaticResource EntityTemplateSelector}"
                    Visibility="{x:Bind ViewModel.SelectedGoodsWagon, Mode=OneWay, Converter={StaticResource NullableConverter}}" />
            </controls:CollapsibleColumnProperties.PanelContent>
        </controls:CollapsibleColumnProperties>
    </Grid>
</Page>