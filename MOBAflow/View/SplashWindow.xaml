<Window
    x:Class="Moba.WinUI.View.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MOBAflow">
    <Grid
        x:Name="RootGrid"
        Width="520"
        Height="320"
        Background="#FF2F4250">
        <Border
            Width="440"
            Padding="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#FF1F2B35"
            BorderBrush="#55F59E2C"
            BorderThickness="1"
            CornerRadius="16">
            <StackPanel HorizontalAlignment="Center" Spacing="20">
                <FontIcon
                    FontSize="56"
                    Foreground="#FFF59E2C"
                    Glyph="&#xE7C0;" />

                <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="0">
                        <TextBlock
                            FontSize="34"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFFFF"
                            Text="MOBA" />
                        <TextBlock
                            FontSize="34"
                            FontWeight="SemiBold"
                            Foreground="#FFF59E2C"
                            Text="flow" />
                    </StackPanel>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Foreground="#FFEEF5F7"
                        Text="Modellbahn-Automation" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <ProgressRing
                        Width="24"
                        Height="24"
                        Foreground="#FFF59E2C"
                        IsActive="True"
                        IsIndeterminate="True" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="#FFEEF5F7"
                        Text="Systeme werden initialisiert" />
                </StackPanel>

                <TextBlock
                    x:Name="VersionTextBlock"
                    HorizontalAlignment="Center"
                    FontSize="11"
                    Foreground="#BBEEF5F7"
                    Text="MOBAflow" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
