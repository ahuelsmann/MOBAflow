<Page
    x:Class="Moba.WinUI.View.WorkflowsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Moba.WinUI.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Moba.SharedUI.ViewModel"
    xmlns:actions="using:Moba.SharedUI.ViewModel.Action"
    xmlns:domain="using:Moba.Domain.Enum"
    DataContext="{x:Bind ViewModel}">

    <Grid Padding="8" ColumnSpacing="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColWorkflows" Width="240" MinWidth="180" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="ColActions" Width="320" MinWidth="240" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="ColProperties" Width="1*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <controls:CollapsibleColumnCollection
            Grid.Column="0"
            Header="Workflows"
            Glyph="&#xEF90;"
            IsExpanded="{x:Bind ViewModel.IsWorkflowListExpanded, Mode=TwoWay}">
            <controls:CollapsibleColumnCollection.HeaderActions>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button
                        Padding="4"
                        AutomationProperties.Name="Create workflow"
                        Command="{x:Bind ViewModel.WorkflowLibrary.CreateWorkflowCommand}"
                        ToolTipService.ToolTip="Create workflow">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                    </Button>
                    <Button
                        Padding="4"
                        AutomationProperties.Name="Duplicate selected workflow"
                        Command="{x:Bind ViewModel.WorkflowLibrary.DuplicateSelectedWorkflowCommand}"
                        ToolTipService.ToolTip="Duplicate selected workflow">
                        <FontIcon Glyph="&#xE8B0;" FontSize="14" />
                    </Button>
                    <Button
                        Padding="4"
                        AutomationProperties.Name="Delete selected workflow"
                        Command="{x:Bind ViewModel.WorkflowLibrary.DeleteSelectedWorkflowCommand}"
                        ToolTipService.ToolTip="Delete selected workflow">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    </Button>
                </StackPanel>
            </controls:CollapsibleColumnCollection.HeaderActions>
            <controls:CollapsibleColumnCollection.PanelContent>
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <AutoSuggestBox
                        PlaceholderText="Search workflows..."
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.WorkflowLibrary.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ListView
                        x:Name="WorkflowListView"
                        Grid.Row="1"
                        AutomationProperties.Name="Workflow library"
                        CanDragItems="True"
                        DragItemsStarting="WorkflowListView_DragItemsStarting"
                        ItemsSource="{x:Bind ViewModel.WorkflowLibrary.FilteredWorkflows, Mode=OneWay}"
                        KeyDown="WorkflowListView_KeyDown"
                        SelectedItem="{x:Bind ViewModel.WorkflowLibrary.SelectedWorkflow, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkflowViewModel">
                                <Grid Padding="8" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xEF90;" FontSize="16" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ActionSummary, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </controls:CollapsibleColumnCollection.PanelContent>
        </controls:CollapsibleColumnCollection>

        <toolkit:GridSplitter Grid.Column="1" Width="4" ResizeBehavior="PreviousAndNext" />

        <controls:CollapsibleColumnHelper
            Grid.Column="2"
            Header="Actions"
            Glyph="&#xE945;"
            IsExpanded="{x:Bind ViewModel.IsWorkflowActionsExpanded, Mode=TwoWay}">
            <controls:CollapsibleColumnHelper.PanelContent>
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.WorkflowLibrary.ActionListHint, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <CommandBar DefaultLabelPosition="Right" OverflowButtonVisibility="Auto">
                            <AppBarButton Label="Add action" Icon="Add" IsEnabled="{x:Bind ViewModel.WorkflowLibrary.HasWorkflowSelection, Mode=OneWay}">
                                <AppBarButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Announcement" Command="{x:Bind ViewModel.WorkflowLibrary.AddActionCommand}" CommandParameter="{x:Bind domain:ActionType.Announcement}" />
                                        <MenuFlyoutItem Text="Audio" Command="{x:Bind ViewModel.WorkflowLibrary.AddActionCommand}" CommandParameter="{x:Bind domain:ActionType.Audio}" />
                                        <MenuFlyoutItem Text="Command" Command="{x:Bind ViewModel.WorkflowLibrary.AddActionCommand}" CommandParameter="{x:Bind domain:ActionType.Command}" />
                                        <MenuFlyoutItem Text="Signal aspect" Command="{x:Bind ViewModel.WorkflowLibrary.AddActionCommand}" CommandParameter="{x:Bind domain:ActionType.SelectSignalAspect}" />
                                        <MenuFlyoutItem Text="PowerShell script" Command="{x:Bind ViewModel.WorkflowLibrary.AddActionCommand}" CommandParameter="{x:Bind domain:ActionType.ExecuteScript}" />
                                        <MenuFlyoutItem Text="Destination display" Command="{x:Bind ViewModel.WorkflowLibrary.AddActionCommand}" CommandParameter="{x:Bind domain:ActionType.TrainDestinationDisplay}" />
                                        <MenuFlyoutItem Text="Change journey stop" Command="{x:Bind ViewModel.WorkflowLibrary.AddActionCommand}" CommandParameter="{x:Bind domain:ActionType.ChangeJourneyStop}" />
                                    </MenuFlyout>
                                </AppBarButton.Flyout>
                            </AppBarButton>
                            <AppBarButton Label="Move up" Icon="Up" Command="{x:Bind ViewModel.WorkflowLibrary.MoveSelectedActionUpCommand}" ToolTipService.ToolTip="Move action up (Alt+Up)" />
                            <AppBarButton Label="Move down" Command="{x:Bind ViewModel.WorkflowLibrary.MoveSelectedActionDownCommand}" ToolTipService.ToolTip="Move action down (Alt+Down)">
                                <AppBarButton.Icon><FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE74B;" /></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="Delete action" Icon="Delete" Command="{x:Bind ViewModel.WorkflowLibrary.DeleteSelectedActionCommand}" />
                        </CommandBar>
                    </StackPanel>
                    <ListView
                        x:Name="ActionListView"
                        Grid.Row="1"
                        AutomationProperties.Name="Actions in execution order"
                        CanDragItems="True"
                        CanReorderItems="True"
                        AllowDrop="True"
                        DragItemsCompleted="ActionListView_DragItemsCompleted"
                        DragItemsStarting="ActionListView_DragItemsStarting"
                        ItemsSource="{x:Bind ViewModel.WorkflowLibrary.SelectedWorkflow.Actions, Mode=OneWay}"
                        KeyDown="ActionListView_KeyDown"
                        SelectedItem="{x:Bind ViewModel.WorkflowLibrary.SelectedAction, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="actions:WorkflowActionViewModel">
                                <Grid Padding="8" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Number, Mode=OneWay}" FontWeight="SemiBold" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Type}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </controls:CollapsibleColumnHelper.PanelContent>
        </controls:CollapsibleColumnHelper>

        <toolkit:GridSplitter Grid.Column="3" Width="4" ResizeBehavior="PreviousAndNext" />

        <controls:CollapsibleColumnProperties
            Grid.Column="4"
            Header="Properties"
            Glyph="&#xE946;"
            IsExpanded="{x:Bind ViewModel.IsWorkflowPropertiesExpanded, Mode=TwoWay}">
            <controls:CollapsibleColumnProperties.PanelContent>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                    <StackPanel Padding="12" Spacing="16">
                        <Button Content="Workflow settings" Command="{x:Bind ViewModel.WorkflowLibrary.ShowWorkflowSettingsCommand}" />
                        <ContentControl
                            HorizontalContentAlignment="Stretch"
                            Content="{x:Bind ViewModel.WorkflowLibrary.SelectedEditorObject, Mode=OneWay}"
                            ContentTemplateSelector="{StaticResource EntityTemplateSelector}" />

                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Validation and diagnostics" />
                                    <TextBlock Text="{x:Bind ViewModel.WorkflowLibrary.ValidationIssues.Count, Mode=OneWay}" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Content="Dry run"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.WorkflowLibrary.DryRunSelectedWorkflowCommand}" />
                                    <Button
                                        Grid.Column="1"
                                        Content="Cancel"
                                        Command="{x:Bind ViewModel.WorkflowLibrary.CancelDryRunCommand}" />
                                    <Button
                                        Grid.Column="2"
                                        Content="Validate"
                                        Command="{x:Bind ViewModel.WorkflowLibrary.ValidateCommand}" />
                                </Grid>
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Text="{x:Bind ViewModel.WorkflowLibrary.LastDryRunStatus, Mode=OneWay}" />

                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Validation" />
                                <ListView
                                    MaxHeight="180"
                                    AutomationProperties.Name="Workflow validation issues"
                                    ItemsSource="{x:Bind ViewModel.WorkflowLibrary.ValidationIssues, Mode=OneWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                AutomationProperties.Name="Open validation issue"
                                                Command="{Binding DataContext.WorkflowLibrary.NavigateToValidationIssueCommand, ElementName=PageRoot}"
                                                CommandParameter="{Binding}">
                                                <StackPanel Padding="4">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Code}" />
                                                    <TextBlock Text="{Binding FieldPath}" />
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Planned effects" />
                                <ListView
                                    MaxHeight="160"
                                    AutomationProperties.Name="Dry run planned effects"
                                    ItemsSource="{x:Bind ViewModel.WorkflowLibrary.PlannedEffects, Mode=OneWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Padding="4" Text="{Binding Description}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Recent trace" />
                                <ListView
                                    MaxHeight="280"
                                    AutomationProperties.Name="Workflow execution trace"
                                    ItemsSource="{x:Bind ViewModel.WorkflowLibrary.TraceEntries, Mode=OneWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="4" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Sequence}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Kind}" />
                                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </controls:CollapsibleColumnProperties.PanelContent>
        </controls:CollapsibleColumnProperties>
    </Grid>
</Page>
