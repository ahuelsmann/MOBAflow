<Page
    x:Class="Moba.WinUI.View.OverviewPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Moba.Common.Events"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Moba.SharedUI.ViewModel"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="32,24,32,32" Spacing="8">

            <!--  Page Header  -->
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Overview" />

            <!--  REST API & Connected Clients  -->
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="REST API and Clients"
                IsExpanded="True">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon
                                FontSize="20"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Glyph="&#xE968;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </Expander.HeaderTemplate>
                <StackPanel Padding="56,16,0,16" Spacing="16">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.SettingsPage.AutoStartWebApp, Mode=OneWay, Converter={StaticResource BoolToAutoStartLabelConverter}}" />
                    </StackPanel>
                    <!--  A pending row shows a progress ring instead of the dot; its text says what it waits for.  -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Grid
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center">
                            <Ellipse
                                Width="12"
                                Height="12"
                                Fill="{x:Bind SystemStatus.RestApiIsReachable, Mode=OneWay, Converter={StaticResource BoolToAccentBrushConverter}, ConverterParameter={Binding ElementName=PageRoot}}"
                                Visibility="{x:Bind SystemStatus.RestApiIsPending, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                            <ProgressRing
                                Width="16"
                                Height="16"
                                AutomationProperties.AccessibilityView="Raw"
                                IsActive="{x:Bind SystemStatus.RestApiIsPending, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind SystemStatus.RestApiStatusText, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind SystemStatus.RestApiWaitingTime, Mode=OneWay}"
                            Visibility="{x:Bind SystemStatus.RestApiWaitingTime, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="MOBAsmart sync" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Ellipse
                                Width="12"
                                Height="12"
                                Margin="2,0"
                                VerticalAlignment="Center"
                                Fill="{x:Bind SystemStatus.SolutionLoadedIsHealthy, Mode=OneWay, Converter={StaticResource BoolToAccentBrushConverter}, ConverterParameter={Binding ElementName=PageRoot}}" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}">
                                <Run Text="Solution loaded: " />
                                <Run Text="{x:Bind SystemStatus.SolutionLoadedStatusText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Grid
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center">
                                <Ellipse
                                    Width="12"
                                    Height="12"
                                    Fill="{x:Bind SystemStatus.RuntimeHubHostIsHealthy, Mode=OneWay, Converter={StaticResource BoolToAccentBrushConverter}, ConverterParameter={Binding ElementName=PageRoot}}"
                                    Visibility="{x:Bind SystemStatus.RuntimeHubHostIsPending, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    AutomationProperties.AccessibilityView="Raw"
                                    IsActive="{x:Bind SystemStatus.RuntimeHubHostIsPending, Mode=OneWay}" />
                            </Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.LiveSetting="Polite"
                                Style="{StaticResource BodyTextBlockStyle}">
                                <Run Text="RuntimeHub host: " />
                                <Run Text="{x:Bind SystemStatus.RuntimeHubHostStatusText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind SystemStatus.RuntimeHubHostWaitingTime, Mode=OneWay}"
                                Visibility="{x:Bind SystemStatus.RuntimeHubHostWaitingTime, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Grid
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center">
                                <Ellipse
                                    Width="12"
                                    Height="12"
                                    Fill="{x:Bind SystemStatus.SolutionSyncIsHealthy, Mode=OneWay, Converter={StaticResource BoolToAccentBrushConverter}, ConverterParameter={Binding ElementName=PageRoot}}"
                                    Visibility="{x:Bind SystemStatus.SolutionSyncIsPending, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    AutomationProperties.AccessibilityView="Raw"
                                    IsActive="{x:Bind SystemStatus.SolutionSyncIsPending, Mode=OneWay}" />
                            </Grid>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}">
                                <Run Text="Solution sync: " />
                                <Run Text="{x:Bind SystemStatus.SolutionSyncStatusText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Ellipse
                                Width="12"
                                Height="12"
                                Margin="2,0"
                                VerticalAlignment="Center"
                                Fill="{x:Bind SystemStatus.RuntimeSnapshotIsHealthy, Mode=OneWay, Converter={StaticResource BoolToAccentBrushConverter}, ConverterParameter={Binding ElementName=PageRoot}}" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}">
                                <Run Text="Runtime snapshot: " />
                                <Run Text="{x:Bind SystemStatus.RuntimeSnapshotStatusText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Grid
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center">
                                <Ellipse
                                    Width="12"
                                    Height="12"
                                    Fill="{x:Bind SystemStatus.RestCacheIsHealthy, Mode=OneWay, Converter={StaticResource BoolToAccentBrushConverter}, ConverterParameter={Binding ElementName=PageRoot}}"
                                    Visibility="{x:Bind SystemStatus.RestCacheIsPending, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    AutomationProperties.AccessibilityView="Raw"
                                    IsActive="{x:Bind SystemStatus.RestCacheIsPending, Mode=OneWay}" />
                            </Grid>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}">
                                <Run Text="REST cache: " />
                                <Run Text="{x:Bind SystemStatus.RestCacheStatusText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Grid
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center">
                                <Ellipse
                                    Width="12"
                                    Height="12"
                                    Fill="{x:Bind SystemStatus.HubBroadcastIsHealthy, Mode=OneWay, Converter={StaticResource BoolToAccentBrushConverter}, ConverterParameter={Binding ElementName=PageRoot}}"
                                    Visibility="{x:Bind SystemStatus.HubBroadcastIsPending, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    AutomationProperties.AccessibilityView="Raw"
                                    IsActive="{x:Bind SystemStatus.HubBroadcastIsPending, Mode=OneWay}" />
                            </Grid>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}">
                                <Run Text="Hub broadcast: " />
                                <Run Text="{x:Bind SystemStatus.HubBroadcastStatusText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Ellipse
                                Width="12"
                                Height="12"
                                Margin="2,0"
                                VerticalAlignment="Center"
                                Fill="{x:Bind SystemStatus.RemoteSnapshotIsHealthy, Mode=OneWay, Converter={StaticResource BoolToAccentBrushConverter}, ConverterParameter={Binding ElementName=PageRoot}}" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}">
                                <Run Text="Remote snapshot: " />
                                <Run Text="{x:Bind SystemStatus.RemoteSnapshotStatusText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Connected clients" />
                        <ItemsRepeater ItemsSource="{x:Bind SystemStatus.RestApiConnectedClients, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="common:RestApiClientInfo">
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="12,8"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind DeviceName}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="No clients connected"
                            Visibility="{x:Bind SystemStatus.RestApiConnectedClientsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!--  Z21 System State Section (only visible when connected)  -->
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="Z21 System State"
                IsExpanded="True">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="20" Glyph="&#xE945;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </Expander.HeaderTemplate>
                <Grid
                    Padding="56,16,0,16"
                    ColumnSpacing="24"
                    RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Row 0: Main Current | Temperature  -->
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Main Current:" />
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Text="{x:Bind ViewModel.MainCurrent, Mode=OneWay}" />
                        <TextBlock VerticalAlignment="Center" Text=" mA" />
                    </StackPanel>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Text="Temperature:" />
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Text="{x:Bind ViewModel.Temperature, Mode=OneWay}" />
                        <TextBlock VerticalAlignment="Center" Text=" °C" />
                    </StackPanel>

                    <!--  Row 1: Supply Voltage | VCC Voltage  -->
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Supply Voltage:" />
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Text="{x:Bind ViewModel.SupplyVoltage, Mode=OneWay}" />
                        <TextBlock VerticalAlignment="Center" Text=" mV" />
                    </StackPanel>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Text="VCC Voltage:" />
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Text="{x:Bind ViewModel.VccVoltage, Mode=OneWay}" />
                        <TextBlock VerticalAlignment="Center" Text=" mV" />
                    </StackPanel>
                </Grid>
            </Expander>

            <!--  Z21 Version Info Section (only visible when connected)  -->
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="Versions"
                IsExpanded="True">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="20" Glyph="&#xE946;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </Expander.HeaderTemplate>
                <Grid
                    Padding="56,16,0,16"
                    ColumnSpacing="24"
                    RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Seriennummer:" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Text="{x:Bind ViewModel.SerialNumber, Mode=OneWay}" />

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Text="Firmware Version:" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Text="{x:Bind ViewModel.FirmwareVersion, Mode=OneWay}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Hardware Typ:" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Text="{x:Bind ViewModel.HardwareType, Mode=OneWay}" />
                </Grid>
            </Expander>

            <!--  Counter Settings Section  -->
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="Counter Settings"
                IsExpanded="True">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="20" Glyph="&#xE823;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </Expander.HeaderTemplate>
                <StackPanel Padding="56,16,0,16" Spacing="16">

                    <!--  Target Lap Count  -->
                    <NumberBox
                        Width="200"
                        HorizontalAlignment="Left"
                        Header="Target Lap Count"
                        Minimum="1"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind Counters.GlobalTargetLapCount, Mode=TwoWay}" />

                    <!--  Timer Filter Settings  -->
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <CheckBox Content="Use Timer Filter" IsChecked="{x:Bind Counters.UseTimerFilter, Mode=TwoWay}" />
                            <TextBlock
                                Margin="32,0,0,0"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Prevents multiple counts from the same train pass"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <NumberBox
                            Width="200"
                            HorizontalAlignment="Left"
                            Header="Timer Interval (seconds)"
                            IsEnabled="{x:Bind Counters.UseTimerFilter, Mode=OneWay}"
                            LargeChange="1"
                            Minimum="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind Counters.TimerIntervalSeconds, Mode=TwoWay}">
                            <NumberBox.Description>
                                <TextBlock Text="Example: 10s for 16-axle trains" TextWrapping="Wrap" />
                            </NumberBox.Description>
                        </NumberBox>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!--  Track Statistics Section (only visible when connected)  -->
            <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon FontSize="20" Glyph="&#xE9D9;" />
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Track Statistics" />
                </StackPanel>

                <ItemsRepeater ItemsSource="{x:Bind Counters.Statistics, Mode=OneWay}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:InPortStatistic">
                            <Border
                                Margin="0,0,0,12"
                                Padding="16"
                                Background="{x:Bind BackgroundColorName, Mode=OneWay, Converter={StaticResource HexColorToBrushConverter}}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--  Title: Name (if available) or "InPort X"  -->
                                    <TextBlock
                                        Grid.Row="0"
                                        FontWeight="Bold"
                                        Foreground="{ThemeResource MobaFeedbackCardForegroundBrush}"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind DisplayName, Mode=OneWay}" />

                                    <!--  Subtitle: InPort number  -->
                                    <TextBlock
                                        Grid.Row="1"
                                        Foreground="{ThemeResource MobaFeedbackCardForegroundBrush}"
                                        Opacity="0.8"
                                        Style="{StaticResource CaptionTextBlockStyle}">
                                        <Run Text="InPort " />
                                        <Run Text="{x:Bind InPort, Mode=OneWay}" />
                                    </TextBlock>

                                    <TextBlock
                                        Grid.Row="2"
                                        Margin="0,4,0,0"
                                        Foreground="{ThemeResource MobaFeedbackCardForegroundBrush}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind LapCountFormatted, Mode=OneWay}" />

                                    <ProgressBar
                                        Grid.Row="3"
                                        Margin="0,4,0,0"
                                        Maximum="1"
                                        ShowError="False"
                                        ShowPaused="False"
                                        Value="{x:Bind Progress, Mode=OneWay}" />

                                    <Grid Grid.Row="4" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel
                                            Grid.Column="0"
                                            Orientation="Horizontal"
                                            Spacing="4">
                                            <FontIcon
                                                FontSize="12"
                                                Foreground="{ThemeResource MobaFeedbackCardForegroundBrush}"
                                                Glyph="&#xE916;" />
                                            <TextBlock Foreground="{ThemeResource MobaFeedbackCardForegroundBrush}" Text="Last lap:" />
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource MobaFeedbackCardForegroundBrush}"
                                                Text="{x:Bind LastLapTimeFormatted, Mode=OneWay}" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="4">
                                            <FontIcon
                                                FontSize="12"
                                                Foreground="{ThemeResource MobaFeedbackCardForegroundBrush}"
                                                Glyph="&#xE890;" />
                                            <TextBlock Foreground="{ThemeResource MobaFeedbackCardForegroundBrush}" Text="Last seen:" />
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource MobaFeedbackCardForegroundBrush}"
                                                Text="{x:Bind LastFeedbackTimeFormatted, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8">
                                        <TextBox Width="240" PlaceholderText="New counter value"
                                                 AutomationProperties.Name="New counter value"
                                                 Text="{x:Bind CounterValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Content="Set" Command="{x:Bind SetCounterCommand}" />
                                        <Button Content="Reset" Command="{x:Bind ResetCounterCommand}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="6" Text="{x:Bind CounterError, Mode=OneWay}"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource MobaFeedbackCardForegroundBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!--  Reset Button  -->
                <TextBlock Text="{x:Bind Counters.CounterPersistenceError, Mode=OneWay}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind Counters.CounterCommandStatus, Mode=OneWay}"
                           TextWrapping="Wrap" />
                <Button
                    MinWidth="200"
                    HorizontalAlignment="Center"
                    Command="{x:Bind Counters.ResetCountersCommand}"
                    Content="Reset All Counters" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
