<Page
    x:Class="Moba.WinUI.View.DisplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModel="using:Moba.WinUI.ViewModel"
    DataContext="{x:Bind ViewModel}">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollMode="Enabled">
        <Grid Padding="16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Display" />

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="10">
                <NumberBox
                    Header="Gleisnummer"
                    Minimum="0"
                    Maximum="99"
                    SpinButtonPlacementMode="Inline"
                    Value="{x:Bind ViewModel.TrackNumber, Mode=TwoWay}" />

                <TextBox Header="ESP32 IP-Adresse (WLAN)" Text="{x:Bind ViewModel.EspIpAddress, Mode=TwoWay}" />
                <NumberBox Header="UDP Port" Minimum="1" Maximum="65535" Value="{x:Bind ViewModel.UdpPort, Mode=TwoWay}" />

                <NumberBox Header="Refresh Hz" Minimum="1" Maximum="60" Value="{x:Bind ViewModel.RefreshHz, Mode=TwoWay}" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.StartCommand}" Content="Start" />
                    <Button Command="{x:Bind ViewModel.StopCommand}" Content="Stop" />
                </StackPanel>

                <TextBlock Text="{x:Bind ViewModel.ActivityStatusText, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.FramesSentStatusText, Mode=OneWay}" />
                <TextBlock
                    TextWrapping="WrapWholeWords"
                    Text="{x:Bind ViewModel.LastTransportOutcomeText, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.LastFrameTimeText, Mode=OneWay}" />

                <Border
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="WLAN am ESP konfigurieren" />
                        <TextBox Header="Neue SSID" Text="{x:Bind ViewModel.WifiSsid, Mode=TwoWay}" />
                        <TextBox Header="Neues WLAN-Passwort" Text="{x:Bind ViewModel.WifiPassword, Mode=TwoWay}" />
                        <Button
                            Command="{x:Bind ViewModel.SaveWifiConfigCommand}"
                            Content="WLAN auf ESP speichern" />
                        <Button
                            Command="{x:Bind ViewModel.ReadWifiStatusCommand}"
                            Content="WLAN-Status vom ESP lesen" />
                        <TextBlock
                            TextWrapping="WrapWholeWords"
                            Text="{x:Bind ViewModel.WifiConfigStatusText, Mode=OneWay}" />
                        <TextBlock
                            TextWrapping="WrapWholeWords"
                            Text="{x:Bind ViewModel.WifiDeviceStatusText, Mode=OneWay}" />
                        <TextBlock
                            Opacity="0.8"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Hinweis: Das ESP startet nach erfolgreichem Speichern automatisch neu." />
                        <TextBlock
                            Opacity="0.9"
                            TextWrapping="WrapWholeWords"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Wenn das ESP im aktuellen WLAN nicht erreichbar ist: Mit dem Access Point MOBAflow-Setup-XXXXXX verbinden, hier als ESP-IP 192.168.4.1 eintragen, WLAN speichern und danach wieder ins Ziel-WLAN wechseln." />
                    </StackPanel>
                </Border>
            </StackPanel>

                <Border
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8">
                    <!-- Preview matches the physical size of the 1.69" 240x280 LCD (~218 PPI): ~1.10" x 1.28" -> 106 x 123 EP at 96 EP/inch. -->
                    <Image
                        Width="106"
                        Height="123"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Stretch="Fill"
                        Source="{x:Bind ViewModel.PreviewImage, Mode=OneWay}" />
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
