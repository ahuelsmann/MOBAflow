<Page
    x:Class="Moba.WinUI.View.DisplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Moba.WinUI.Controls.Display"
    xmlns:converter="using:Moba.WinUI.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Moba.WinUI.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <SelectorBar SelectionChanged="OnDisplaySelectionChanged">
            <SelectorBarItem
                IsSelected="True"
                Tag="WaveshareLcdTouch700Inch"
                Text="Waveshare LCD Touch 7.00inch" />
            <SelectorBarItem Tag="WaveshareLcd169Inch" Text="Waveshare LCD Module 1.69inch" />
            <SelectorBarItem Tag="WaveshareLcd147Inch" Text="Waveshare LCD Module 1.47inch" />
        </SelectorBar>

        <controls:WaveshareLcdTouch700InchConfigurationView
            Grid.Row="1"
            DataContext="{x:Bind ViewModel.WaveshareLcdTouch700InchConfiguration, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsWaveshareLcdTouch700InchSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
        <controls:WaveshareLcd169InchConfigurationView
            Grid.Row="1"
            DataContext="{x:Bind ViewModel.WaveshareLcd169InchConfiguration, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsWaveshareLcd169InchSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
        <controls:WaveshareLcd147InchConfigurationView
            Grid.Row="1"
            DataContext="{x:Bind ViewModel.WaveshareLcd147InchConfiguration, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsWaveshareLcd147InchSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</Page>
