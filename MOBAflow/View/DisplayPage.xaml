<Page
    x:Class="Moba.WinUI.View.DisplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Configured ESP32 Display" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Connect to the endpoint from Settings to read live protocol, capability, and health information."
                    TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind ViewModel.EndpointStatusText, Mode=OneWay}"
                Severity="Informational" />

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="240" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Endpoint" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.ConfiguredEndpointText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        Grid.RowSpan="3"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.HelpText="Validate the endpoint and negotiate protocol capabilities"
                        Command="{x:Bind ViewModel.ConnectCommand}"
                        Content="Connect and negotiate"
                        Style="{StaticResource AccentButtonStyle}" />

                    <TextBlock Grid.Row="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Connection" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.ConnectionStatusText, Mode=OneWay}" />

                    <TextBlock Grid.Row="2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Negotiation" />
                    <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.NegotiationStatusText, Mode=OneWay}" TextWrapping="Wrap" />
                    </Grid>
                </Grid>
            </Border>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="240" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Live device diagnostics" />
                        <Button
                            Grid.Column="1"
                            AutomationProperties.HelpText="Query current health using the negotiated session"
                            Command="{x:Bind ViewModel.RefreshHealthCommand}"
                            Content="Refresh health" />
                    </Grid>

                    <InfoBar
                        IsClosable="False"
                        IsOpen="True"
                        Message="{x:Bind ViewModel.CapabilityStatusText, Mode=OneWay}"
                        Severity="Informational" />

                    <Grid ColumnSpacing="24" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Device" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DeviceIdentityText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Adapter" />
                        <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.AdapterIdentityText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Row="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Protocol" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.ProtocolVersionText, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Firmware" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{x:Bind ViewModel.FirmwareVersionText, Mode=OneWay}" />

                        <TextBlock Grid.Row="2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Resolution" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.ResolutionText, Mode=OneWay}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Region limit" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{x:Bind ViewModel.RegionLimitText, Mode=OneWay}" />

                        <TextBlock Grid.Row="3" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Pixel formats" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.PixelFormatsText, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Rotations" />
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="{x:Bind ViewModel.RotationsText, Mode=OneWay}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Health" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{x:Bind ViewModel.HealthText, Mode=OneWay}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Test and optional commands" />

                    <StackPanel Spacing="4">
                        <Button
                            HorizontalAlignment="Left"
                            AutomationProperties.HelpText="Send the protocol v1 standard RGB565 pattern using the negotiated dimensions"
                            Command="{x:Bind ViewModel.SendStandardTestPatternCommand}"
                            Content="Send standard test pattern" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.StandardPatternAvailabilityText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <Button
                            HorizontalAlignment="Left"
                            AutomationProperties.HelpText="Ask the device adapter to render its optional built-in pattern"
                            Command="{x:Bind ViewModel.RenderBuiltInTestPatternCommand}"
                            Content="Render device test pattern" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.BuiltInPatternAvailabilityText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <NumberBox
                                Width="220"
                                AutomationProperties.HelpText="Brightness percentage from zero through one hundred"
                                Header="Brightness percentage"
                                IsEnabled="{x:Bind ViewModel.CanSetBrightness, Mode=OneWay}"
                                Maximum="100"
                                Minimum="0"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.BrightnessPercentage, Mode=TwoWay}" />
                            <Button
                                Margin="0,24,0,0"
                                VerticalAlignment="Top"
                                Command="{x:Bind ViewModel.ApplyBrightnessCommand}"
                                Content="Apply brightness" />
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.BrightnessAvailabilityText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Last result" />
                    <TextBlock Text="{x:Bind ViewModel.LastResultText, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
