<Page
    x:Class="Moba.WinUI.View.DisplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModel="using:Moba.WinUI.ViewModel"
    DataContext="{x:Bind ViewModel}">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Display" />

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="10">
                <NumberBox
                    Header="Gleisnummer"
                    Minimum="0"
                    Maximum="99"
                    SpinButtonPlacementMode="Inline"
                    Value="{x:Bind ViewModel.TrackNumber, Mode=TwoWay}" />
                <TextBox Header="ESP32 IP-Adresse" Text="{x:Bind ViewModel.EspIpAddress, Mode=TwoWay}" />
                <NumberBox Header="UDP Port" Minimum="1" Maximum="65535" Value="{x:Bind ViewModel.UdpPort, Mode=TwoWay}" />
                <NumberBox Header="Refresh Hz" Minimum="1" Maximum="60" Value="{x:Bind ViewModel.RefreshHz, Mode=TwoWay}" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.StartCommand}" Content="Start" />
                    <Button Command="{x:Bind ViewModel.StopCommand}" Content="Stop" />
                </StackPanel>

                <TextBlock Text="{x:Bind ViewModel.ActivityStatusText, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.FramesSentStatusText, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.LastFrameTimeText, Mode=OneWay}" />
            </StackPanel>

            <Border
                Grid.Column="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">
                <!-- Preview matches the physical size of the 1.69" 240x280 LCD (~218 PPI): ~1.10" x 1.28" -> 106 x 123 EP at 96 EP/inch. -->
                <Image
                    Width="106"
                    Height="123"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Stretch="Fill"
                    Source="{x:Bind ViewModel.PreviewImage, Mode=OneWay}" />
            </Border>
        </Grid>
    </Grid>
</Page>
