<Page
    x:Class="Moba.WinUI.View.SignalMultiplexTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:Moba.Backend.Model"
    x:Name="Root">

    <ScrollViewer>
        <Grid Padding="12" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Signal Multiplex Test" />
                <TextBlock
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Gezielte Testseite für Viessmann 4046 / 5229 bzw. 52292. Du kannst rohe Z21-Turnout-Befehle senden und vordefinierte 4046-Presets ausprobieren."
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="12"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Z21" />
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.ConnectCommand}" Content="Verbinden" />
                            <Button Command="{x:Bind ViewModel.DisconnectCommand}" Content="Trennen" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OnTrackPowerOnClick" Content="Track Power Ein" />
                            <Button Click="OnTrackPowerOffClick" Content="Track Power Aus" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="12"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Beobachtete 4046-Zuordnung" />
                        <TextBlock Text="200: O1/0 = Hp0, O1/1 = Ks1" TextWrapping="WrapWholeWords" />
                        <TextBlock Text="201: O0/1 = Ra12 / Sh1, O1/1 = Ks1 plus Zs (oben)" TextWrapping="WrapWholeWords" />
                        <TextBlock Text="202: O0/1 = Ks2 plus weiß oben links, O1/1 = Ks2 plus weiß oben links plus Z2 (oben)" TextWrapping="WrapWholeWords" />
                        <TextBlock Text="203 und 204 sind noch offen." TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="2"
                    Padding="12"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Letzter Test" />
                        <TextBlock
                            x:Name="CommandStatusText"
                            Text="Noch kein Befehl gesendet."
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="12"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="8">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Rohbefehl" />

                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Text="Decoderadresse" />
                        <NumberBox
                            x:Name="DecoderAddressBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            LargeChange="1"
                            Maximum="2044"
                            Minimum="1"
                            SmallChange="1"
                            Value="200" />

                        <TextBlock
                            Grid.Row="2"
                            VerticalAlignment="Center"
                            Text="Hinweis" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Text="Für die Konfigurationsmatrix unten werden die Adressen 200 bis 204 direkt getestet."
                            TextWrapping="WrapWholeWords" />

                        <TextBlock
                            Grid.Row="3"
                            VerticalAlignment="Center"
                            Text="Output" />
                        <ComboBox
                            x:Name="OutputComboBox"
                            Grid.Row="3"
                            Grid.Column="1"
                            SelectedIndex="1">
                            <ComboBoxItem Content="0" Tag="0" />
                            <ComboBoxItem Content="1" Tag="1" />
                        </ComboBox>

                        <StackPanel
                            Grid.Row="4"
                            Grid.ColumnSpan="2"
                            Spacing="8">
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Der Rohbefehl sendet direkt an die gewählte DCC-Decoderadresse."
                                TextWrapping="WrapWholeWords" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ToggleSwitch
                                    x:Name="ActivateToggle"
                                    Header="Activate"
                                    IsOn="False" />
                                <ToggleSwitch
                                    x:Name="QueueToggle"
                                    Header="Queue"
                                    IsOn="False" />
                                <Button Click="OnSendRawClick" Content="Senden" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="12"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="4046-Presets" />
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Click="OnSendPresetClick"
                                    Content="200: Hp0"
                                    Tag="200: Hp0|200|1|false" />
                                <Button
                                    Click="OnSendPresetClick"
                                    Content="200: Ks1"
                                    Tag="200: Ks1|200|1|true" />
                                <Button
                                    Click="OnSendPresetClick"
                                    Content="201: Ra12 / Sh1"
                                    Tag="201: Ra12 / Sh1|201|0|true" />
                                <Button
                                    Click="OnSendPresetClick"
                                    Content="201: Ks1 + Zs"
                                    Tag="201: Ks1 + Zs|201|1|true" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Click="OnSendPresetClick"
                                    Content="202: Ks2 + weiß"
                                    Tag="202: Ks2 + weiß|202|0|true" />
                                <Button
                                    Click="OnSendPresetClick"
                                    Content="202: Ks2 + weiß + Z2"
                                    Tag="202: Ks2 + weiß + Z2|202|1|true" />
                                <Button
                                    Click="OnSendPresetClick"
                                    Content="203: O0"
                                    Tag="203: O0|203|0|true" />
                                <Button
                                    Click="OnSendPresetClick"
                                    Content="203: O1"
                                    Tag="203: O1|203|1|true" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Die Presets senden direkt an die beobachteten Testadressen."
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border
                Grid.Row="3"
                Padding="12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Konfigurationsmatrix 200-204" />
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Click="OnSendPresetClick"
                                Content="200 / O0 / false"
                                Tag="200 / O0 / false|200|0|false" />
                            <Button
                                Click="OnSendPresetClick"
                                Content="200 / O0 / true"
                                Tag="200 / O0 / true|200|0|true" />
                            <Button
                                Click="OnSendPresetClick"
                                Content="200 / O1 / false"
                                Tag="200 / O1 / false|200|1|false" />
                            <Button
                                Click="OnSendPresetClick"
                                Content="200 / O1 / true"
                                Tag="200 / O1 / true|200|1|true" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Click="OnSendPresetClick"
                                Content="201 / O0 / false"
                                Tag="201 / O0 / false|201|0|false" />
                            <Button
                                Click="OnSendPresetClick"
                                Content="201 / O0 / true"
                                Tag="201 / O0 / true|201|0|true" />
                            <Button
                                Click="OnSendPresetClick"
                                Content="201 / O1 / false"
                                Tag="201 / O1 / false|201|1|false" />
                            <Button
                                Click="OnSendPresetClick"
                                Content="201 / O1 / true"
                                Tag="201 / O1 / true|201|1|true" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Click="OnSendPresetClick"
                                Content="202 / O0 / false"
                                Tag="202 / O0 / false|202|0|false" />
                            <Button
                                Click="OnSendPresetClick"
                                Content="202 / O0 / true"
                                Tag="202 / O0 / true|202|0|true" />
                            <Button
                                Click="OnSendPresetClick"
                                Content="202 / O1 / false"
                                Tag="202 / O1 / false|202|1|false" />
                            <Button
                                Click="OnSendPresetClick"
                                Content="202 / O1 / true"
                                Tag="202 / O1 / true|202|1|true" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Click="OnSendPresetClick"
                                Content="203 / O0 / false"
                                Tag="203 / O0 / false|203|0|false" />
                            <Button
                                Click="OnSendPresetClick"
                                Content="203 / O0 / true"
                                Tag="203 / O0 / true|203|0|true" />
                            <Button
                                Click="OnSendPresetClick"
                                Content="203 / O1 / false"
                                Tag="203 / O1 / false|203|1|false" />
                            <Button
                                Click="OnSendPresetClick"
                                Content="203 / O1 / true"
                                Tag="203 / O1 / true|203|1|true" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Click="OnSendPresetClick"
                                Content="204 / O0 / false"
                                Tag="204 / O0 / false|204|0|false" />
                            <Button
                                Click="OnSendPresetClick"
                                Content="204 / O0 / true"
                                Tag="204 / O0 / true|204|0|true" />
                            <Button
                                Click="OnSendPresetClick"
                                Content="204 / O1 / false"
                                Tag="204 / O1 / false|204|1|false" />
                            <Button
                                Click="OnSendPresetClick"
                                Content="204 / O1 / true"
                                Tag="204 / O1 / true|204|1|true" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Grid.Row="4"
                Padding="12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="8">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Z21-Traffic" />
                        <Button Click="OnClearTrafficClick" Content="Traffic leeren" />
                    </StackPanel>

                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.TrafficPackets, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="model:Z21TrafficPacket">
                                <Grid Padding="8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        FontFamily="Consolas"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind TimestampFormatted}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontFamily="Consolas"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind DirectionIcon}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        FontFamily="Consolas"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind PacketType}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="0,2,0,0"
                                        FontFamily="Consolas"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind DataHex}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
