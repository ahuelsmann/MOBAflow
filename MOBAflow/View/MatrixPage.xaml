<Page
    x:Class="Moba.WinUI.View.MatrixPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Moba.WinUI.Controls"
    xmlns:ct="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:matrix="using:Moba.WinUI.Controls.Matrix"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                x:Name="ColColorPalette"
                Width="320"
                MinWidth="32" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition
                x:Name="ColImages"
                Width="*"
                MinWidth="100" />
        </Grid.ColumnDefinitions>

        <controls:CollapsibleColumnHelper
            x:Name="ColorPalettePanel"
            Grid.Column="0"
            Margin="0"
            Glyph="&#xE70F;"
            Header="Color Palette"
            IsExpanded="True">
            <controls:CollapsibleColumnHelper.PanelContent>
                <ScrollViewer
                    Padding="8,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ct:ColorPicker
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Color="{x:Bind ViewModel.SelectedColor, Mode=TwoWay}" />
                </ScrollViewer>
            </controls:CollapsibleColumnHelper.PanelContent>
        </controls:CollapsibleColumnHelper>

        <ct:GridSplitter
            Grid.Column="1"
            Width="4"
            HorizontalAlignment="Left"
            ResizeBehavior="PreviousAndNext" />

        <controls:CollapsibleColumnHelper
            x:Name="ImagesPanel"
            Grid.Column="2"
            Margin="0"
            Glyph="&#xE70F;"
            Header="Matrix Images"
            IsExpanded="True">
            <controls:CollapsibleColumnHelper.PanelContent>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <SelectorBar Grid.Row="0">
                        <SelectorBarItem IsSelected="True" Text="5x5 Matrix" />
                    </SelectorBar>

                    <matrix:Matrix5x5ConfigurationView Grid.Row="1" DataContext="{x:Bind ViewModel, Mode=OneWay}" />
                </Grid>
            </controls:CollapsibleColumnHelper.PanelContent>
        </controls:CollapsibleColumnHelper>
    </Grid>
</Page>