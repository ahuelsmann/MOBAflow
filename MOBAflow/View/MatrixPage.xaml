<Page
    x:Class="Moba.WinUI.View.MatrixPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Moba.WinUI.Controls"
    xmlns:ct="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:matrix="using:Moba.WinUI.Controls.Matrix"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <controls:CollapsibleColumnHelper
            Grid.Column="0"
            Margin="0"
            Glyph="&#xE70F;"
            Header="Color Palette"
            IsExpanded="True">
            <controls:CollapsibleColumnHelper.PanelContent>
                <ScrollViewer
                    Padding="8,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ct:ColorPicker
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Color="{x:Bind ViewModel.SelectedColor, Mode=TwoWay}" />
                </ScrollViewer>
            </controls:CollapsibleColumnHelper.PanelContent>
        </controls:CollapsibleColumnHelper>

        <ct:GridSplitter
            Grid.Column="1"
            Width="4"
            HorizontalAlignment="Left"
            ResizeBehavior="PreviousAndNext" />

        <controls:CollapsibleColumnHelper
            Grid.Column="2"
            Margin="0"
            Glyph="&#xE70F;"
            Header="5x5 Matrix"
            IsExpanded="True">
            <controls:CollapsibleColumnHelper.PanelContent>
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <CommandBar
                        Grid.Row="0"
                        DefaultLabelPosition="Right"
                        IsDynamicOverflowEnabled="False">
                        <AppBarButton
                            Command="{x:Bind ViewModel.AddMatrixCommand}"
                            Icon="Add"
                            Label="Add matrix" />

                    </CommandBar>

                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Matrices}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="12" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="matrix:ViewModel5x5">
                                    <Border
                                        Padding="12"
                                        HorizontalAlignment="Center"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <Grid RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Button
                                                Grid.Row="0"
                                                HorizontalAlignment="Right"
                                                Command="{x:Bind DeleteCommand}"
                                                CommandParameter="{x:Bind}"
                                                Content="Delete" />

                                            <matrix:View5x5
                                                Grid.Row="1"
                                                Width="200"
                                                Height="250"
                                                CellRightTappedCommand="{x:Bind ClearCellCommand}"
                                                CellTappedCommand="{x:Bind PaintCellCommand}"
                                                ViewModel="{x:Bind}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Grid>
            </controls:CollapsibleColumnHelper.PanelContent>
        </controls:CollapsibleColumnHelper>
    </Grid>
</Page>