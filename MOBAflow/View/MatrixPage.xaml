<Page
    x:Class="Moba.WinUI.View.MatrixPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Moba.WinUI.Controls"
    xmlns:ct="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:matrix="using:Moba.WinUI.Controls.Matrix"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <controls:CollapsibleColumnHelper
            Grid.Column="0"
            Margin="0"
            Glyph="&#xE70F;"
            Header="Color Palette"
            IsExpanded="True">
            <controls:CollapsibleColumnHelper.PanelContent>
                <ScrollViewer
                    Padding="8,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ct:ColorPicker
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Color="{x:Bind ViewModel.SelectedColor, Mode=TwoWay}" />
                </ScrollViewer>
            </controls:CollapsibleColumnHelper.PanelContent>
        </controls:CollapsibleColumnHelper>

        <ct:GridSplitter
            Grid.Column="1"
            Width="4"
            HorizontalAlignment="Left"
            ResizeBehavior="PreviousAndNext" />

        <controls:CollapsibleColumnHelper
            Grid.Column="2"
            Margin="0"
            Glyph="&#xE70F;"
            Header="5x5 Matrix"
            IsExpanded="True">
            <controls:CollapsibleColumnHelper.PanelContent>
                <Grid>
                    <Border
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <matrix:View5x5
                            x:Name="MatrixView"
                            Width="300"
                            Height="300"
                            CellRightTappedCommand="{x:Bind ViewModel.ClearCellCommand}"
                            CellTappedCommand="{x:Bind ViewModel.CellClickedCommand}"
                            ViewModel="{x:Bind ViewModel.MatrixViewModel, Mode=OneWay}" />
                    </Border>
                </Grid>
            </controls:CollapsibleColumnHelper.PanelContent>
        </controls:CollapsibleColumnHelper>
    </Grid>
</Page>