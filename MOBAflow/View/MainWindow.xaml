<Window
    x:Class="Moba.WinUI.View.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MOBAflow"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  TitleBar  -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="MOBAflow"
            Grid.Row="0"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False"
            Subtitle="{x:Bind AppVersion, Mode=OneTime}">
            <TitleBar.IconSource>
                <FontIconSource FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7C0;" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--  NavigationView with Auto pane display mode for responsive behavior  -->
        <!--  See class NavigationRegistration  -->
        <NavigationView
            x:Name="MainNavigation"
            Grid.Row="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            CompactModeThresholdWidth="600"
            IsSettingsVisible="False"
            ItemInvoked="NavigationView_ItemInvoked"
            OpenPaneLength="240"
            PaneDisplayMode="Auto">
            <!--  Content area with Toolbar and Pages  -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Theme Toggle and CommandBar on same row  -->
                <Grid
                    Grid.Row="0"
                    MinHeight="48"
                    Padding="8,4,16,4"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Theme Toggle (left)  -->
                    <ToggleSwitch
                        Grid.Column="0"
                        Margin="0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        IsOn="{x:Bind ViewModel.IsDarkMode, Mode=TwoWay}"
                        OffContent="Light"
                        OnContent="Dark"
                        Toggled="ThemeToggleSwitch_Toggled" />

                    <!--  Compact CommandBar (right side)  -->
                    <CommandBar
                        Grid.Column="2"
                        MaxWidth="720"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        DefaultLabelPosition="Right"
                        IsOpen="False"
                        OverflowButtonVisibility="Auto">
                        <!--  File Operations  -->
                        <AppBarButton Command="{x:Bind ViewModel.NewSolutionCommand}" Label="New">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE729;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Command="{x:Bind ViewModel.LoadSolutionCommand}" Label="Open">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE838;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarSeparator />
                        <!--  Simulation  -->
                        <AppBarButton
                            Command="{x:Bind ViewModel.SimulateFeedbackCommand}"
                            Icon="Play"
                            Label="Simulate" />
                        <AppBarElementContainer VerticalAlignment="Center">
                            <NumberBox
                                Width="128"
                                MinWidth="96"
                                MaxWidth="144"
                                Minimum="1"
                                SpinButtonPlacementMode="Inline"
                                ToolTipService.ToolTip="Feedback Point (InPort)"
                                Value="{x:Bind ViewModel.SimulateInPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </AppBarElementContainer>
                        <AppBarSeparator />
                        <AppBarButton
                            Command="{x:Bind ViewModel.ResetJourneyCommand}"
                            Icon="Refresh"
                            Label="Reset" />
                    </CommandBar>
                </Grid>

                <!--  Content Frame for page navigation  -->
                <Frame
                    x:Name="ContentFrame"
                    Grid.Row="1"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
            </Grid>
        </NavigationView>

        <!--  Structured project diagnostics (state-based, unlike the continuous Monitor logs)  -->
        <Expander
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            IsExpanded="{x:Bind ViewModel.IsDiagnosticsExpanded, Mode=TwoWay}">
            <Expander.Header>
                <Grid MinHeight="36" Padding="8,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Messages" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.DiagnosticsSummary, Mode=OneWay}" />
                    <ToggleButton
                        Grid.Column="2"
                        Margin="4,0"
                        IsChecked="{x:Bind ViewModel.ShowDiagnosticErrors, Mode=TwoWay}"
                        ToolTipService.ToolTip="Show or hide errors">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xEA39;" />
                            <TextBlock Text="Errors" />
                            <TextBlock Text="{x:Bind ViewModel.DiagnosticErrorCount, Mode=OneWay}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton
                        Grid.Column="3"
                        Margin="4,0"
                        IsChecked="{x:Bind ViewModel.ShowDiagnosticWarnings, Mode=TwoWay}"
                        ToolTipService.ToolTip="Show or hide warnings">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE7BA;" />
                            <TextBlock Text="Warnings" />
                            <TextBlock Text="{x:Bind ViewModel.DiagnosticWarningCount, Mode=OneWay}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton
                        Grid.Column="4"
                        Margin="4,0"
                        IsChecked="{x:Bind ViewModel.ShowDiagnosticInformation, Mode=TwoWay}"
                        ToolTipService.ToolTip="Show or hide information">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE946;" />
                            <TextBlock Text="Information" />
                            <TextBlock Text="{x:Bind ViewModel.DiagnosticInformationCount, Mode=OneWay}" />
                        </StackPanel>
                    </ToggleButton>
                    <Button
                        Grid.Column="5"
                        Margin="8,0,0,0"
                        Command="{x:Bind ViewModel.RefreshProjectDiagnosticsCommand}"
                        Content="Refresh"
                        ToolTipService.ToolTip="Analyze the selected project again" />
                </Grid>
            </Expander.Header>
            <Border
                MaxHeight="240"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <ListView ItemsSource="{x:Bind ViewModel.VisibleProjectDiagnostics, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    FontWeight="SemiBold"
                                    Text="{Binding SeverityLabel}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Source}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding Message}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Expander>

        <!--  StatusBar (classic segmented layout)  -->
        <Grid
            Grid.Row="3"
            MinHeight="36"
            Padding="12,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Solution path  -->
            <StackPanel
                Grid.Column="0"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Solution:" />
                <TextBlock
                    MaxWidth="520"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.CurrentSolutionPath, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind ViewModel.CurrentSolutionPath, Mode=OneWay}" />
            </StackPanel>

            <!--  Z21 status + Track Power  -->
            <StackPanel
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Border
                    Width="1"
                    Height="16"
                    Margin="0,0,4,0"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Image
                    x:Name="Z21StatusIcon"
                    Width="18"
                    Height="18"
                    VerticalAlignment="Center"
                    Opacity="0.4"
                    Source="ms-appx:///Assets/FunctionSymbols/dark/32/track_power.png" />
                <TextBlock
                    MaxWidth="260"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Track Power" />
                <ToggleSwitch
                    MinWidth="0"
                    Margin="0"
                    VerticalAlignment="Center"
                    IsEnabled="{x:Bind ViewModel.IsOperationalControlEnabled, Mode=OneWay}"
                    IsOn="{x:Bind ViewModel.IsTrackPowerOn, Mode=OneWay}"
                    OffContent="{x:Null}"
                    OnContent="{x:Null}"
                    Toggled="TrackPower_Toggled" />
            </StackPanel>

            <!--  REST API status  -->
            <StackPanel
                Grid.Column="2"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Border
                    Width="1"
                    Height="16"
                    Margin="0,0,4,0"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="REST API:" />
                <TextBlock
                    MaxWidth="180"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.RestApiStatusText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind ViewModel.RestApiStatusText, Mode=OneWay}" />
            </StackPanel>

            <!--  Speech selection + health status  -->
            <StackPanel
                Grid.Column="3"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Border
                    Width="1"
                    Height="16"
                    Margin="0,0,4,0"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Speech:" />
                <DropDownButton
                    Padding="8,4"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0">
                    <DropDownButton.Content>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.SelectedSpeechEngine, Mode=OneWay}" />
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Command="{x:Bind ViewModel.SelectSpeechEngineCommand}"
                                CommandParameter="System Speech (Windows SAPI)"
                                Text="System Speech (Windows SAPI)" />
                            <MenuFlyoutItem
                                Command="{x:Bind ViewModel.SelectSpeechEngineCommand}"
                                CommandParameter="Piper TTS"
                                Text="Piper TTS" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                    Glyph="{x:Bind ViewModel.SpeechHealthIcon, Mode=OneWay}" />
                <TextBlock
                    MaxWidth="220"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.SpeechStatusDisplayText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind ViewModel.SpeechStatusDisplayText, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
