<Page
    x:Class="Moba.WinUI.View.HelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Moba.WinUI.Controls"
    xmlns:controls1="using:CommunityToolkit.WinUI.Controls">

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                x:Name="ColNavigation"
                Width="280"
                MinWidth="32" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition
                x:Name="ColDocumentation"
                Width="*"
                MinWidth="100" />
        </Grid.ColumnDefinitions>

        <!--  Navigation Panel  -->
        <controls:CollapsibleColumnCollection
            x:Name="NavigationPanel"
            Grid.Column="0"
            Glyph="&#xE8A5;"
            x:Uid="HelpWiki"
            Header="MOBAflow Wiki"
            IsExpanded="True">
            <controls:CollapsibleColumnCollection.PanelContent>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="20"
                                FontWeight="SemiBold"
                                x:Uid="HelpWikiTitle"
                                Text="MOBAflow Wiki" />
                            <TextBlock x:Uid="HelpCaption" Style="{ThemeResource CaptionTextBlockStyle}" Text="Documentation" />
                        </StackPanel>

                        <TreeView
                            x:Name="NavigationTreeView"
                            ItemInvoked="OnNavigationItemInvoked"
                            SelectionMode="Single" />
                    </StackPanel>
                </ScrollViewer>
            </controls:CollapsibleColumnCollection.PanelContent>
        </controls:CollapsibleColumnCollection>

        <controls1:GridSplitter
            Grid.Column="1"
            Width="4"
            HorizontalAlignment="Left"
            ResizeBehavior="PreviousAndNext" />

        <!--  Content Panel  -->
        <controls:CollapsibleColumnHelper
            x:Name="DocumentationPanel"
            Grid.Column="2"
            Glyph="&#xE8A5;"
            x:Uid="HelpDocumentation"
            Header="Documentation"
            IsExpanded="True">
            <controls:CollapsibleColumnHelper.PanelContent>
                <ScrollViewer Padding="8" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <TextBlock
                            x:Name="HeaderTextBlock"
                            FontSize="32"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            x:Uid="HelpWelcome"
                            Text="Welcome" />
                        <RichTextBlock
                            x:Name="ContentRichTextBlock"
                            FontSize="15"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </controls:CollapsibleColumnHelper.PanelContent>
        </controls:CollapsibleColumnHelper>
    </Grid>
</Page>
