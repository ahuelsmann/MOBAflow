<Page
    x:Class="Moba.WinUI.View.TrainsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Moba.WinUI.Controls"
    xmlns:controls1="using:CommunityToolkit.WinUI.Controls"
    xmlns:converter="using:Moba.WinUI.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="using:Moba.SharedUI.ViewModel"
    DataContext="{x:Bind ViewModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converter:NullableConverter x:Key="NullableConverter" />
    </Page.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="220" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColTrains" Width="1.1*" MinWidth="32" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="ColLocomotives" Width="1*" MinWidth="32" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="ColPassengerWagons" Width="1*" MinWidth="32" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="ColGoodsWagons" Width="1*" MinWidth="32" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="ColProperties" Width="1.25*" MinWidth="32" />
            </Grid.ColumnDefinitions>

            <controls:CollapsibleColumnCollection
                Grid.Column="0"
                Header="Trains"
                Glyph="&#xE7C0;"
                IsExpanded="{x:Bind ViewModel.IsTrainsListExpanded, Mode=TwoWay}">
                <controls:CollapsibleColumnCollection.HeaderActions>
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button
                            Padding="4"
                            Command="{x:Bind ViewModel.AddTrainCommand}"
                            ToolTipService.ToolTip="Add a new train">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                        </Button>
                        <Button
                            Padding="4"
                            Command="{x:Bind ViewModel.DeleteTrainCommand}"
                            ToolTipService.ToolTip="Delete the selected train">
                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        </Button>
                    </StackPanel>
                </controls:CollapsibleColumnCollection.HeaderActions>
                <controls:CollapsibleColumnCollection.PanelContent>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <AutoSuggestBox
                            Grid.Row="0"
                            Margin="0,0,0,8"
                            PlaceholderText="Search trains..."
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.TrainSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ListView
                            x:Name="TrainsListView"
                            Grid.Row="1"
                            IsItemClickEnabled="True"
                            ItemsSource="{x:Bind ViewModel.FilteredTrains, Mode=OneWay}"
                            KeyDown="TrainsListView_KeyDown"
                            SelectedItem="{x:Bind ViewModel.SelectedTrain, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodel:TrainViewModel">
                                    <Grid Padding="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Grid.Column="0"
                                            Margin="0,0,8,0"
                                            FontSize="16"
                                            Glyph="&#xE7C0;" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name, Mode=OneWay}" />
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind VehicleItems.Count, Mode=OneWay}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="vehicles" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </controls:CollapsibleColumnCollection.PanelContent>
            </controls:CollapsibleColumnCollection>

            <controls1:GridSplitter
                Grid.Column="1"
                Width="4"
                HorizontalAlignment="Left"
                ResizeBehavior="PreviousAndNext" />

            <controls:CollapsibleColumnHelper
                Grid.Column="2"
                Header="Locomotive Library"
                Glyph="&#xE7C0;"
                IsExpanded="{x:Bind ViewModel.IsTrainsLocomotiveLibraryExpanded, Mode=TwoWay}">
                <controls:CollapsibleColumnHelper.PanelContent>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <AutoSuggestBox
                            Grid.Row="0"
                            Margin="0,0,0,8"
                            PlaceholderText="Search locomotives..."
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.LocomotiveSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ListView
                            x:Name="LocomotiveLibraryListView"
                            Grid.Row="1"
                            CanDragItems="True"
                            DragItemsStarting="LocomotiveLibraryListView_DragItemsStarting"
                            ItemsSource="{x:Bind ViewModel.FilteredLocomotiveLibrary, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedLocomotive, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodel:LocomotiveViewModel">
                                    <Grid Padding="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Grid.Column="0"
                                            Margin="0,0,8,0"
                                            FontSize="16"
                                            Glyph="&#xE7C0;" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Name, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </controls:CollapsibleColumnHelper.PanelContent>
            </controls:CollapsibleColumnHelper>

            <controls1:GridSplitter
                Grid.Column="3"
                Width="4"
                HorizontalAlignment="Left"
                ResizeBehavior="PreviousAndNext" />

            <controls:CollapsibleColumnHelper
                Grid.Column="4"
                Header="Passenger Wagon Library"
                Glyph="&#xE8D5;"
                IsExpanded="{x:Bind ViewModel.IsTrainsPassengerLibraryExpanded, Mode=TwoWay}">
                <controls:CollapsibleColumnHelper.PanelContent>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <AutoSuggestBox
                            Grid.Row="0"
                            Margin="0,0,0,8"
                            PlaceholderText="Search passenger wagons..."
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.PassengerWagonSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ListView
                            x:Name="PassengerWagonLibraryListView"
                            Grid.Row="1"
                            CanDragItems="True"
                            DragItemsStarting="PassengerWagonLibraryListView_DragItemsStarting"
                            ItemsSource="{x:Bind ViewModel.FilteredPassengerWagonLibrary, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedPassengerWagon, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodel:PassengerWagonViewModel">
                                    <Grid Padding="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Grid.Column="0"
                                            Width="18"
                                            Height="12"
                                            Margin="0,0,8,0"
                                            BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Name, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </controls:CollapsibleColumnHelper.PanelContent>
            </controls:CollapsibleColumnHelper>

            <controls1:GridSplitter
                Grid.Column="5"
                Width="4"
                HorizontalAlignment="Left"
                ResizeBehavior="PreviousAndNext" />

            <controls:CollapsibleColumnHelper
                Grid.Column="6"
                Header="Goods Wagon Library"
                Glyph="&#xE7C0;"
                IsExpanded="{x:Bind ViewModel.IsTrainsGoodsLibraryExpanded, Mode=TwoWay}">
                <controls:CollapsibleColumnHelper.PanelContent>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <AutoSuggestBox
                            Grid.Row="0"
                            Margin="0,0,0,8"
                            PlaceholderText="Search goods wagons..."
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.GoodsWagonSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ListView
                            x:Name="GoodsWagonLibraryListView"
                            Grid.Row="1"
                            CanDragItems="True"
                            DragItemsStarting="GoodsWagonLibraryListView_DragItemsStarting"
                            ItemsSource="{x:Bind ViewModel.FilteredGoodsWagonLibrary, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedGoodsWagon, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodel:GoodsWagonViewModel">
                                    <Grid Padding="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Grid.Column="0"
                                            Width="18"
                                            Height="12"
                                            Margin="0,0,8,0"
                                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                            BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Name, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </controls:CollapsibleColumnHelper.PanelContent>
            </controls:CollapsibleColumnHelper>

            <controls1:GridSplitter
                Grid.Column="7"
                Width="4"
                HorizontalAlignment="Left"
                ResizeBehavior="PreviousAndNext" />

            <controls:CollapsibleColumnProperties
                Grid.Column="8"
                Header="Properties"
                Glyph="&#xE946;"
                IsExpanded="{x:Bind ViewModel.IsTrainsPropertiesExpanded, Mode=TwoWay}">
                <controls:CollapsibleColumnProperties.PanelContent>
                    <ContentControl
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Content="{x:Bind ViewModel.SelectedTrain, Mode=OneWay}"
                        ContentTemplateSelector="{StaticResource EntityTemplateSelector}"
                        Visibility="{x:Bind ViewModel.SelectedTrain, Mode=OneWay, Converter={StaticResource NullableConverter}}" />
                </controls:CollapsibleColumnProperties.PanelContent>
            </controls:CollapsibleColumnProperties>
        </Grid>

        <TextBlock
            Grid.Row="1"
            Style="{ThemeResource SubtitleTextBlockStyle}"
            Text="{x:Bind ViewModel.TrainsCompositionTitle, Mode=OneWay}" />

        <Border
            Grid.Row="2"
            Padding="12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="Drag locomotives and wagons into this row. Reorder directly and remove via X or Delete." />

                <Grid Grid.Row="1">
                    <ListView
                        x:Name="VehicleListView"
                        Margin="0,8,0,0"
                        AllowDrop="True"
                        CanDragItems="True"
                        CanReorderItems="True"
                        DragItemsCompleted="VehicleListView_DragItemsCompleted"
                        DragOver="VehicleListView_DragOver"
                        Drop="VehicleListView_Drop"
                        ItemsSource="{x:Bind ViewModel.SelectedVehicles, Mode=OneWay}"
                        KeyDown="VehicleListView_KeyDown"
                        SelectedItem="{x:Bind ViewModel.SelectedVehicle, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,0" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodel:VehicleItemViewModel">
                                <Grid Width="72" Margin="0,0,4,0" ToolTipService.ToolTip="{x:Bind DisplayName}">
                                    
                                    <!-- Visual connector to next vehicle -->
                                    <Border Width="6" Height="2" Background="{ThemeResource CardStrokeColorDefaultBrush}" HorizontalAlignment="Right" Margin="0,32,-4,0" />
                                    
                                    <Border
                                        Padding="4"
                                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="32" />
                                            </Grid.RowDefinitions>

                                            <Button
                                                Grid.Row="0"
                                                HorizontalAlignment="Left"
                                                Width="20"
                                                Height="20"
                                                Padding="0"
                                                Margin="-2,-2,0,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{x:Bind ToggleDirectionCommand}"
                                                ToolTipService.ToolTip="Toggle direction">
                                                <FontIcon Glyph="&#xE72C;" FontSize="9" />
                                            </Button>
                                            
                                            <Button
                                                Grid.Row="0"
                                                HorizontalAlignment="Right"
                                                Width="20"
                                                Height="20"
                                                Padding="0"
                                                Margin="0,-2,-2,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{x:Bind RemoveCommand}"
                                                ToolTipService.ToolTip="Remove vehicle from consist">
                                                <FontIcon Glyph="&#xE711;" FontSize="9" />
                                            </Button>

                                            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                                
                                                <!-- Locomotive Shape -->
                                                <Grid Visibility="{x:Bind IsLocomotive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <ScaleTransform ScaleX="{x:Bind ScaleX, Mode=OneWay}" />
                                                    </Grid.RenderTransform>
                                                    <!-- ICE-like engine profile, facing left -->
                                                    <Path
                                                        Data="M 12,0 L 40,0 L 40,16 L 2,16 Q 0,16 0,14 L 6,4 Q 8,0 12,0 Z"
                                                        Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    <StackPanel
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="0,0,4,-3"
                                                        Orientation="Horizontal"
                                                        Spacing="16">
                                                        <Border Width="6" Height="3" CornerRadius="0,0,3,3" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                                        <Border Width="6" Height="3" CornerRadius="0,0,3,3" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                                
                                                <!-- Passenger Wagon Shape -->
                                                <Grid Visibility="{x:Bind IsPassengerWagon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <ScaleTransform ScaleX="{x:Bind ScaleX, Mode=OneWay}" />
                                                    </Grid.RenderTransform>
                                                    <Border
                                                        Width="40"
                                                        Height="16"
                                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                                        BorderBrush="{ThemeResource TextFillColorSecondaryBrush}"
                                                        BorderThickness="1.5"
                                                        CornerRadius="2" />
                                                    <StackPanel
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Bottom"
                                                        Margin="0,0,0,-3"
                                                        Orientation="Horizontal"
                                                        Spacing="16">
                                                        <Border Width="6" Height="3" CornerRadius="0,0,3,3" Background="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <Border Width="6" Height="3" CornerRadius="0,0,3,3" Background="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Goods Wagon Shape -->
                                                <Grid Visibility="{x:Bind IsGoodsWagon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <ScaleTransform ScaleX="{x:Bind ScaleX, Mode=OneWay}" />
                                                    </Grid.RenderTransform>
                                                    <Border
                                                        Width="40"
                                                        Height="3"
                                                        Margin="0,0,0,1"
                                                        VerticalAlignment="Bottom"
                                                        Background="{ThemeResource TextFillColorSecondaryBrush}"
                                                        CornerRadius="1" />
                                                    <StackPanel
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Bottom"
                                                        Margin="0,0,0,-3"
                                                        Orientation="Horizontal"
                                                        Spacing="16">
                                                        <Border Width="6" Height="3" CornerRadius="0,0,3,3" Background="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <Border Width="6" Height="3" CornerRadius="0,0,3,3" Background="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>

                                            <TextBlock
                                                Grid.Row="2"
                                                Margin="0,2,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="10"
                                                MaxLines="2"
                                                Text="{x:Bind DisplayName, Mode=OneWay}"
                                                TextAlignment="Center"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsHitTestVisible="False"
                        Text="Select a train and drag rolling stock into the composition row."
                        Visibility="{x:Bind ViewModel.SelectedTrain, Mode=OneWay, Converter={StaticResource NullableConverter}, ConverterParameter=Invert}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
