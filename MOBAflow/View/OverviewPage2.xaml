<Page
    x:Class="Moba.WinUI.View.OverviewPage2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Moba.SharedUI.ViewModel"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="32,24,32,32" Spacing="24">

            <!-- Page Header -->
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Overview Dashboard" />

            <!-- Quick Actions Bar -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Spacing="16" Grid.Column="0">
                        <TextBlock Text="Quick Actions" VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,16,0" />
                        
                        <Button Command="{x:Bind ViewModel.SetTrackPowerCommand}" 
                                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                Foreground="White">
                            <Button.CommandParameter>
                                <x:Boolean>False</x:Boolean>
                            </Button.CommandParameter>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE711;" FontSize="16"/>
                                <TextBlock Text="Gleisspannung AUS" />
                            </StackPanel>
                        </Button>
                        
                        <Button Command="{x:Bind ViewModel.SetTrackPowerCommand}">
                            <Button.CommandParameter>
                                <x:Boolean>True</x:Boolean>
                            </Button.CommandParameter>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE73E;" FontSize="16"/>
                                <TextBlock Text="Gleisspannung EIN" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Button Grid.Column="2" 
                            Command="{x:Bind ViewModel.AcknowledgeOperatingStateCommand}"
                            Visibility="{x:Bind ViewModel.IsOperatorAckRequired, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BA;" FontSize="16"/>
                            <TextBlock Text="Fehler quittieren" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Dashboard Grid -->
            <Grid ColumnSpacing="24" RowSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                
                <!-- Card 1: Z21 System State -->
                <Border Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24"
                        VerticalAlignment="Top">
                    <StackPanel Spacing="24">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="24" Glyph="&#xE945;" />
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Z21 System" VerticalAlignment="Center" />
                        </StackPanel>
                        
                        <Grid ColumnSpacing="24" RowSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            
                            <!-- Gauge: Current -->
                            <StackPanel Grid.Column="0" Spacing="12" HorizontalAlignment="Center">
                                <Grid Width="120" Height="120">
                                    <ProgressRing Width="120" Height="120" 
                                                  Maximum="3200" 
                                                  Value="{x:Bind ViewModel.MainCurrent, Mode=OneWay}" 
                                                  IsIndeterminate="False" />
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.MainCurrent, Mode=OneWay}" 
                                                   Style="{StaticResource TitleTextBlockStyle}" 
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="mA" 
                                                   Style="{StaticResource CaptionTextBlockStyle}" 
                                                   HorizontalAlignment="Center" 
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Main Current" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>

                            <!-- Gauge: Temperature -->
                            <StackPanel Grid.Column="1" Spacing="12" HorizontalAlignment="Center">
                                <Grid Width="120" Height="120">
                                    <ProgressRing Width="120" Height="120" 
                                                  Maximum="60" 
                                                  Value="{x:Bind ViewModel.Temperature, Mode=OneWay}" 
                                                  IsIndeterminate="False" />
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.Temperature, Mode=OneWay}" 
                                                   Style="{StaticResource TitleTextBlockStyle}" 
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="°C" 
                                                   Style="{StaticResource CaptionTextBlockStyle}" 
                                                   HorizontalAlignment="Center" 
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Temperature" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>

                        <MenuFlyoutSeparator />

                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Supply Voltage:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.SupplyVoltage, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="VCC Voltage:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.VccVoltage, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Firmware:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.FirmwareVersion, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 2: REST API & Clients -->
                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24"
                        VerticalAlignment="Top">
                    <StackPanel Spacing="24">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="24" Glyph="&#xE968;" />
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="API &amp; Clients" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Ellipse Width="16" Height="16" 
                                     VerticalAlignment="Center"
                                     Fill="{x:Bind ViewModel.RestApiIsReachable, Mode=OneWay, Converter={StaticResource BoolToAccentBrushConverter}}" />
                            <TextBlock VerticalAlignment="Center" 
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Text="{x:Bind ViewModel.RestApiStatusText, Mode=OneWay}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" 
                                   Text="{x:Bind ViewModel.AutoStartWebApp, Mode=OneWay, Converter={StaticResource BoolToAutoStartLabelConverter}}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <MenuFlyoutSeparator />

                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Connected Devices" />
                        
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.RestApiConnectedClients, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:RestApiClientInfo">
                                    <Border Margin="0,0,0,8"
                                            Padding="12,12"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            CornerRadius="4">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE8EA;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind DeviceName}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        
                        <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontStyle="Italic"
                                   Text="No clients connected"
                                   Visibility="{x:Bind ViewModel.RestApiConnectedClientsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <!-- Card 3: Counter Settings -->
                <Border Grid.Column="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24"
                        VerticalAlignment="Top">
                    <StackPanel Spacing="24">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="24" Glyph="&#xE823;" />
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Counter Settings" VerticalAlignment="Center" />
                        </StackPanel>

                        <NumberBox HorizontalAlignment="Stretch"
                                   Header="Target Lap Count"
                                   Minimum="1"
                                   SpinButtonPlacementMode="Inline"
                                   Value="{x:Bind ViewModel.GlobalTargetLapCount, Mode=TwoWay}" />

                        <StackPanel Spacing="8">
                            <CheckBox Content="Use Timer Filter" IsChecked="{x:Bind ViewModel.UseTimerFilter, Mode=TwoWay}" />
                            <TextBlock Margin="32,0,0,0"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Prevents multiple counts from the same train pass"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <NumberBox HorizontalAlignment="Stretch"
                                   Header="Timer Interval (seconds)"
                                   IsEnabled="{x:Bind ViewModel.UseTimerFilter, Mode=OneWay}"
                                   Minimum="1"
                                   SpinButtonPlacementMode="Inline"
                                   Value="{x:Bind ViewModel.TimerIntervalSeconds, Mode=TwoWay}" />

                    </StackPanel>
                </Border>
            </Grid>

            <!-- Track Statistics Cards -->
            <StackPanel Spacing="16" Margin="0,24,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="20" Glyph="&#xE9D9;" />
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Track Statistics" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            Command="{x:Bind ViewModel.ResetCountersCommand}"
                            Content="Reset Counters" />
                </Grid>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Statistics, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="300" MinRowSpacing="16" MinColumnSpacing="16" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:InPortStatistic">
                            <Border Padding="16"
                                    Background="{x:Bind BackgroundColorName, Mode=OneWay, Converter={StaticResource HexColorToBrushConverter}}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Title & InPort -->
                                    <StackPanel Grid.Row="0">
                                        <TextBlock FontWeight="Bold"
                                                   Foreground="White"
                                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                                   Text="{x:Bind DisplayName, Mode=OneWay}" />
                                        <TextBlock Foreground="White"
                                                   Opacity="0.8"
                                                   Style="{StaticResource CaptionTextBlockStyle}">
                                            <Run Text="InPort " />
                                            <Run Text="{x:Bind InPort, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Progress -->
                                    <StackPanel Grid.Row="1" Spacing="4">
                                        <TextBlock Foreground="White"
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   Text="{x:Bind LapCountFormatted, Mode=OneWay}" />
                                        <ProgressBar Maximum="1"
                                                     ShowError="False"
                                                     ShowPaused="False"
                                                     Value="{x:Bind Progress, Mode=OneWay}" />
                                    </StackPanel>

                                    <!-- Timestamps -->
                                    <Grid Grid.Row="2" ColumnSpacing="16" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon FontSize="12" Foreground="White" Glyph="&#xE916;" />
                                                <TextBlock Foreground="White" Opacity="0.8" FontSize="12" Text="Last lap" />
                                            </StackPanel>
                                            <TextBlock FontWeight="SemiBold" Foreground="White" Text="{x:Bind LastLapTimeFormatted, Mode=OneWay}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon FontSize="12" Foreground="White" Glyph="&#xE890;" />
                                                <TextBlock Foreground="White" Opacity="0.8" FontSize="12" Text="Last seen" />
                                            </StackPanel>
                                            <TextBlock FontWeight="SemiBold" Foreground="White" Text="{x:Bind LastFeedbackTimeFormatted, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
