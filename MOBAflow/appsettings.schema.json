{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "MOBAflow Appsettings Schema",
    "description": "JSON Schema für die WinUI-Konfiguration (appsettings.json)",
    "type": "object",
    "properties": {
        "Logging": {
            "type": "object",
            "properties": {
                "LogLevel": {
                    "type": "object",
                    "properties": {
                        "Default": { "type": "string" },
                        "Microsoft": { "type": "string" },
                        "Moba": { "type": "string" }
                    }
                }
            }
        },
        "Z21": {
            "type": "object",
            "properties": {
                "AutoConnectRetryIntervalSeconds": { "type": "integer" }
            }
        },
        "RestApi": {
            "type": "object",
            "properties": {
                "CurrentIpAddress": { "type": "string" },
                "Port": { "type": [ "integer", "string" ] },
                "RecentIpAddresses": {
                    "type": "array",
                    "items": { "type": "string" }
                }
            }
        },
        "Speech": {
            "type": "object",
            "properties": {
                "CacheSizeLimitMegabytes": { "type": "integer", "minimum": 0, "default": 500 },
                "Rate": { "type": "number" },
                "Volume": { "type": "number" },
                "VoiceName": { "type": "string" },
                "TestMessage": { "type": "string" },
                "ProviderId": {
                    "type": "string",
                    "enum": [
                        "system-speech",
                        "piper"
                    ],
                    "default": "system-speech"
                },
                "Language": { "type": "string", "default": "" },
                "Piper": {
                    "type": "object",
                    "properties": {
                        "ExecutablePath": { "type": "string" },
                        "ModelPath": { "type": "string" },
                        "ConfigPath": { "type": "string" },
                        "TimeoutSeconds": { "type": "integer", "minimum": 1, "default": 30 }
                    }
                },
                "SystemSpeech": {
                    "type": "object",
                    "properties": {
                        "DefaultVoiceName": { "type": "string", "default": "" }
                    }
                }
            },
            "required": []
        },
        "Application": {
            "type": "object",
            "properties": {
                "ResetWindowLayoutOnStart": { "type": "boolean" },
                "UiLanguage": { "type": "string", "enum": [ "system", "en-US", "de-DE" ] },
                "AutoLoadLastSolution": { "type": "boolean" },
                "AutoStartWebApp": { "type": "boolean" },
                "LastSolutionPath": { "type": [ "string", "null" ] },
                "PhotoStoragePath": { "type": "string" }
            }
        },
        "Counter": {
            "type": "object",
            "properties": {
                "CountOfFeedbackPoints": { "type": "integer" },
                "TargetLapCount": { "type": "integer" },
                "UseTimerFilter": { "type": "boolean" },
                "TimerIntervalSeconds": { "type": "integer" }
            }
        },
        "HealthCheck": {
            "type": "object",
            "properties": {
                "Enabled": { "type": "boolean" },
                "IntervalSeconds": { "type": "integer" }
            }
        },
        "Display": {
            "type": "object",
            "properties": {
                "Esp32IpAddress": { "type": "string" },
                "Port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
        },
        "FeatureToggles": {
            "type": "object",
            "additionalProperties": { "type": [ "string", "boolean", "number" ] }
        }
    },
    "additionalProperties": true
}
