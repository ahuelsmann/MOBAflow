<Application
    x:Class="Moba.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:Moba.WinUI.Converter">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  WinUI 3 Controls Resources - required for theme resources and control styles  -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="/Resources/SignalBoxColors.xaml" />
                <ResourceDictionary Source="/Resources/EntityTemplates.xaml" />
                <ResourceDictionary Source="/Resources/ControlStyles.xaml" />
                <ResourceDictionary Source="/Resources/TrackGraphics.xaml" />
                <ResourceDictionary Source="/Resources/SignalGraphics.xaml" />
                <ResourceDictionary Source="/Resources/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#FFF3F3F3" />
                    <SolidColorBrush x:Key="SurfaceBackgroundFillColorDefaultBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="MobaTextLabelMutedBrush" Color="#FF616161" />
                    <SolidColorBrush x:Key="FunctionButtonOffBackgroundBrush" Color="#FFEEEEEE" />
                    <SolidColorBrush x:Key="FunctionButtonOffBorderBrush" Color="#FFD0D0D0" />
                    <SolidColorBrush x:Key="SignalHousingBackgroundBrush" Color="#FFE8E8E8" />
                    <SolidColorBrush x:Key="SignalLampOffBrush" Color="#663C4040" />
                    <SolidColorBrush x:Key="SignalBoxTrackBrush" Color="#FFC8C8C8" />
                    <SolidColorBrush x:Key="SignalPreviewBackgroundBrush" Color="#FFE8E8E8" />
                    <SolidColorBrush x:Key="MobaDangerButtonBackgroundBrush" Color="#FFE81123" />
                    <SolidColorBrush x:Key="MobaDangerButtonForegroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="MobaDangerButtonBorderBrush" Color="#FFC41019" />
                    <SolidColorBrush x:Key="MobaDangerButtonBackgroundPointerOverBrush" Color="#FFFF1C2C" />
                    <SolidColorBrush x:Key="MobaDangerButtonBackgroundPressedBrush" Color="#FFC41019" />
                    <SolidColorBrush x:Key="MobaDangerButtonBackgroundDisabledBrush" Color="#FF7A0B11" />
                    <SolidColorBrush x:Key="MobaDangerButtonForegroundDisabledBrush" Color="#80FFFFFF" />
                    <SolidColorBrush x:Key="MobaPreviewBadgeBackgroundBrush" Color="#30FF8A00" />
                    <SolidColorBrush x:Key="MobaPreviewBadgeBorderBrush" Color="#80FF8A00" />
                    <SolidColorBrush x:Key="MobaPreviewBadgeForegroundBrush" Color="#FFCC7000" />
                    <SolidColorBrush x:Key="MobaFeedbackCardForegroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="MatrixCellOffBrush" Color="#FFD3D3D3" />
                    <!--  TrackPlan: strong dark stroke on light background (Fluent: good contrast)  -->
                    <SolidColorBrush x:Key="TrackPlanStrokeBrush" Color="#FF121212" />
                    <SolidColorBrush x:Key="TrackPlanStrokeSelectedBrush" Color="#FF0078D4" />
                    <!--  TrackPlan grid lines  -->
                    <SolidColorBrush x:Key="TrackPlanGridMinorBrush" Color="#FFECECEC" />
                    <SolidColorBrush x:Key="TrackPlanGridMajorBrush" Color="#FFD0D0D0" />
                    <!--  Icons (Icons.xaml): schwarz im Light-Theme  -->
                    <SolidColorBrush x:Key="IconStrokeBrush" Color="#FF000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#FF1F1F1F" />
                    <SolidColorBrush x:Key="SurfaceBackgroundFillColorDefaultBrush" Color="#FF202020" />
                    <SolidColorBrush x:Key="MobaTextLabelMutedBrush" Color="#FF9A9A9A" />
                    <SolidColorBrush x:Key="FunctionButtonOffBackgroundBrush" Color="#FF2C2C2C" />
                    <SolidColorBrush x:Key="FunctionButtonOffBorderBrush" Color="#FF404040" />
                    <SolidColorBrush x:Key="SignalHousingBackgroundBrush" Color="#FF1E1E1E" />
                    <SolidColorBrush x:Key="SignalLampOffBrush" Color="#663C4040" />
                    <SolidColorBrush x:Key="SignalBoxTrackBrush" Color="#FF505050" />
                    <SolidColorBrush x:Key="SignalPreviewBackgroundBrush" Color="#FF1E1E1E" />
                    <SolidColorBrush x:Key="MobaDangerButtonBackgroundBrush" Color="#FFE81123" />
                    <SolidColorBrush x:Key="MobaDangerButtonForegroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="MobaDangerButtonBorderBrush" Color="#FFC41019" />
                    <SolidColorBrush x:Key="MobaDangerButtonBackgroundPointerOverBrush" Color="#FFFF1C2C" />
                    <SolidColorBrush x:Key="MobaDangerButtonBackgroundPressedBrush" Color="#FFC41019" />
                    <SolidColorBrush x:Key="MobaDangerButtonBackgroundDisabledBrush" Color="#FF7A0B11" />
                    <SolidColorBrush x:Key="MobaDangerButtonForegroundDisabledBrush" Color="#80FFFFFF" />
                    <SolidColorBrush x:Key="MobaPreviewBadgeBackgroundBrush" Color="#30FF8A00" />
                    <SolidColorBrush x:Key="MobaPreviewBadgeBorderBrush" Color="#80FF8A00" />
                    <SolidColorBrush x:Key="MobaPreviewBadgeForegroundBrush" Color="#FFFF8A00" />
                    <SolidColorBrush x:Key="MobaFeedbackCardForegroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="MatrixCellOffBrush" Color="#FF404040" />
                    <!--  TrackPlan: heller Strich auf dunklem Hintergrund (Fluent: Lesbarkeit im Dark Mode)  -->
                    <SolidColorBrush x:Key="TrackPlanStrokeBrush" Color="#FFEBEBEB" />
                    <SolidColorBrush x:Key="TrackPlanStrokeSelectedBrush" Color="#FF60CDFF" />
                    <!--  TrackPlan grid lines (gedämpftes Grau auf dunklem Canvas)  -->
                    <SolidColorBrush x:Key="TrackPlanGridMinorBrush" Color="#FF2A2A2A" />
                    <SolidColorBrush x:Key="TrackPlanGridMajorBrush" Color="#FF3F3F3F" />
                    <!--  Icons (Icons.xaml): white in dark theme  -->
                    <SolidColorBrush x:Key="IconStrokeBrush" Color="#FFFFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--  TextBlock Styles (Fluent Design 2 Typography)  -->
            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style
                x:Key="BodyStrongTextBlockStyle"
                BasedOn="{StaticResource CaptionTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="AccentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                <Setter Property="Padding" Value="12,6,12,7" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <!--  TrackPlan Section Colors (used by section editor in TrackPlanPage)  -->
            <SolidColorBrush x:Key="TrackPlanSectionColor1" Color="#FF5733" />
            <SolidColorBrush x:Key="TrackPlanSectionColor2" Color="#33FF57" />
            <SolidColorBrush x:Key="TrackPlanSectionColor3" Color="#3357FF" />
            <SolidColorBrush x:Key="TrackPlanSectionColor4" Color="#FFFF33" />
            <SolidColorBrush x:Key="TrackPlanSectionColor5" Color="#FF33FF" />
            <SolidColorBrush x:Key="TrackPlanSectionColor6" Color="#33FFFF" />
            <SolidColorBrush x:Key="TrackPlanSectionColor7" Color="#FF9933" />
            <SolidColorBrush x:Key="TrackPlanSectionColor8" Color="#9933FF" />

            <!--  Global Converters  -->
            <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converter:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <converter:StringToInfoBarSeverityConverter x:Key="StringToInfoBarSeverityConverter" />
            <converter:NullableConverter x:Key="NullableConverter" />
            <converter:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
            <converter:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
            <converter:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter" />
            <converter:BoolToAccentBrushConverter x:Key="BoolToAccentBrushConverter" />
            <converter:TrackNumberConverter x:Key="TrackNumberConverter" />
            <converter:BoolToStringConverter
                x:Key="ExitSideConverter"
                FalseValue="Exit Right"
                TrueValue="Exit Left" />
            <converter:NullableUIntConverter x:Key="NullableUIntConverter" />
            <converter:DateTimeToTimeSpanConverter x:Key="DateTimeToTimeSpanConverter" />
            <converter:DateTimeOffsetConverter x:Key="DateTimeOffsetConverter" />
            <converter:PhotoPathToImageConverter x:Key="PhotoPathToImageConverter" />
            <converter:BoolToStringConverter
                x:Key="PinTooltipConverter"
                FalseValue="Pin panel"
                TrueValue="Unpin panel" />
            <converter:BoolToStringConverter
                x:Key="BoolToAutoStartLabelConverter"
                FalseValue="Auto-start with MOBAflow: Off"
                TrueValue="Auto-start with MOBAflow: On" />
            <converter:DoubleToGridLengthConverter x:Key="DoubleToGridLengthConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
