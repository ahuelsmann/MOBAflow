{
  "mcpServers": {
    "nuget": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-nuget@latest"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@latest",
        "."
      ],
      "env": {
        "MCP_FILESYSTEM_ROOT": ".",
        "MCP_FILESYSTEM_ENABLE_DELETE": "false"
      }
    },
    "ripgrep": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-ripgrep@latest"
      ]
    },
    "documents": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-documents@latest"
      ]
    },
    "markitdown": {
      "command": "npx",
      "args": [
        "-y",
        "@phdcoder/markitdown-mcp@latest"
      ]
    },
    "openapi": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-openapi@latest"
      ],
      "env": {
        "OPENAPI_SPEC_URLS": "https://localhost:5001/swagger/v1/swagger.json"
      }
    },
    "azure-devops": {
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp@latest",
        "ahuelsmann",
        "-d",
        "all",
        "-a",
        "interactive"
      ],
      "env": {
        "AZURE_DEVOPS_ORG_URL": "https://dev.azure.com/ahuelsmann"
      }
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp"
    },
    "slack": {
      "url": "https://mcp.slack.com/mcp"
    },
    "stack-mcp-server": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "mcp.stackoverflow.com"
      ]
    },
    "fetch": {
      "command": "python",
      "args": [
        "-m",
        "mcp_server_fetch"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    }
  }
}