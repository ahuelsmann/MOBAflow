<Project Sdk="Microsoft.NET.Sdk.Web">
    <!--
      MOBAdemo web showcase host. Serves the prepared static files of wwwroot and a health response only.
      It references no repository project and runs no npm or Node step; the build script of a later slice
      produces wwwroot.
    -->
    <PropertyGroup>
        <RootNamespace>Moba.Demo</RootNamespace>
        <AssemblyName>MOBAdemo</AssemblyName>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <ItemGroup>
        <!-- A local run from the build output serves the same files as the published host. -->
        <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
        <Content Remove="wwwroot\.mobademo-build-owned;wwwroot\**\.mobademo-build-owned;wwwroot\.mobademo-webroot;wwwroot\**\.mobademo-webroot" />
    </ItemGroup>
    <!--
      MOBAdemo\build.ps1 writes the built app to wwwroot-build (ignored by Git). When that folder exists it
      replaces the committed placeholder wwwroot: the output and the publish folder get it as wwwroot.
    -->
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\wwwroot-build\index.html')">
        <Content Remove="wwwroot\**" />
        <None Remove="wwwroot-build\**" />
        <Content Include="wwwroot-build\**"
                 Exclude="wwwroot-build\.mobademo-build-owned;wwwroot-build\**\.mobademo-build-owned;wwwroot-build\.mobademo-webroot;wwwroot-build\**\.mobademo-webroot"
                 Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <!--
      A reused output or publish folder keeps no web root of an earlier build: PreserveNewest alone would leave
      hashed assets of an older build behind, and a built index.html that is newer than the placeholder would win
      after the built app was removed. Generated output/publish wwwroot folders carry a .mobademo-webroot marker
      so cleanup only deletes MOBAdemo-owned or empty wwwroot folders and warns instead of deleting foreign content.
      Builds/publishes whose OutDir, OutputPath, or PublishDir resolves (even across symlinks or junctions) to the
      project directory, tracked wwwroot, or wwwroot-build are rejected before cleanup or copying.
      Link resolution uses Directory.ResolveLinkTarget on .NET 6+ and falls back to Windows GetFinalPathNameByHandleW
      under Visual Studio's .NET Framework MSBuild so junctions and symlinks are resolved in both hosts.
    -->
    <UsingTask TaskName="ResolveCanonicalPathTask"
               TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <BaseDirectory ParameterType="System.String" Required="true" />
            <TargetPath ParameterType="System.String" Required="true" />
            <ProjectDirectory ParameterType="System.String" Required="true" />
            <CanonicalPath ParameterType="System.String" Output="true" />
            <OverlapsProjectOrWebRoot ParameterType="System.Boolean" Output="true" />
        </ParameterGroup>
        <Task>
            <Code Type="Class" Language="cs">
                <![CDATA[
                using System;
                using System.IO;
                using System.Reflection;
                using System.Runtime.InteropServices;
                using System.Text;
                using Microsoft.Build.Framework;
                using Microsoft.Build.Utilities;
                using Microsoft.Win32.SafeHandles;

                public sealed class ResolveCanonicalPathTask : Task
                {
                    private const uint FileFlagBackupSemantics = 0x02000000;
                    private const uint FileShareAll = 0x00000007;
                    private const uint OpenExisting = 3;

                    private static readonly MethodInfo ResolveDirLink =
                        typeof(Directory).GetMethod("ResolveLinkTarget", new[] { typeof(string), typeof(bool) });

                    private static readonly MethodInfo ResolveFileLink =
                        typeof(File).GetMethod("ResolveLinkTarget", new[] { typeof(string), typeof(bool) });

                    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
                    private static extern SafeFileHandle CreateFileW(
                        string lpFileName,
                        uint dwDesiredAccess,
                        uint dwShareMode,
                        IntPtr lpSecurityAttributes,
                        uint dwCreationDisposition,
                        uint dwFlagsAndAttributes,
                        IntPtr hTemplateFile);

                    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
                    private static extern uint GetFinalPathNameByHandleW(
                        SafeFileHandle hFile,
                        StringBuilder lpszFilePath,
                        uint cchFilePath,
                        uint dwFlags);

                    [Required]
                    public string BaseDirectory { get; set; } = string.Empty;

                    [Required]
                    public string TargetPath { get; set; } = string.Empty;

                    [Required]
                    public string ProjectDirectory { get; set; } = string.Empty;

                    [Output]
                    public string CanonicalPath { get; set; } = string.Empty;

                    [Output]
                    public bool OverlapsProjectOrWebRoot { get; set; }

                    private bool _hasResolutionError;

                    public override bool Execute()
                    {
                        _hasResolutionError = false;
                        CanonicalPath = ResolveCanonical(BaseDirectory, TargetPath, 0);
                        string canonProject = ResolveCanonical(ProjectDirectory, ".", 0);
                        string canonProjectWebRoot = ResolveCanonical(canonProject, "wwwroot", 0);
                        string canonProjectBuildWebRoot = ResolveCanonical(canonProject, "wwwroot-build", 0);
                        string canonTargetWebRoot = ResolveCanonical(CanonicalPath, "wwwroot", 0);

                        if (_hasResolutionError)
                        {
                            return false;
                        }

                        StringComparison comparison = Path.DirectorySeparatorChar == '\\'
                            ? StringComparison.OrdinalIgnoreCase
                            : StringComparison.Ordinal;

                        OverlapsProjectOrWebRoot =
                            string.Equals(CanonicalPath, canonProject, comparison)
                            || IsSameOrChild(CanonicalPath, canonProjectWebRoot, comparison)
                            || IsSameOrChild(canonTargetWebRoot, canonProjectWebRoot, comparison)
                            || IsSameOrChild(CanonicalPath, canonProjectBuildWebRoot, comparison)
                            || IsSameOrChild(canonTargetWebRoot, canonProjectBuildWebRoot, comparison);

                        return true;
                    }

                    private static bool IsSameOrChild(string candidate, string parent, StringComparison comparison)
                    {
                        if (string.Equals(candidate, parent, comparison))
                        {
                            return true;
                        }

                        string sep = Path.DirectorySeparatorChar.ToString();
                        string prefix = parent.EndsWith(sep, StringComparison.Ordinal) ? parent : parent + sep;
                        return candidate.StartsWith(prefix, comparison);
                    }

                    private string ResolveCanonical(string baseDir, string target, int depth)
                    {
                        string combined = Path.IsPathRooted(target) ? target : Path.Combine(baseDir, target);
                        string full = TrimTrailingSeparator(Path.GetFullPath(combined));
                        if (depth > 16)
                        {
                            _hasResolutionError = true;
                            Log.LogError("Cannot resolve '{0}': symbolic link nesting depth exceeded 16.", full);
                            return full;
                        }

                        string root = Path.GetPathRoot(full) ?? string.Empty;
                        string current = root;
                        string suffix = full.Length > root.Length ? full.Substring(root.Length) : string.Empty;
                        string[] segments = suffix.Split(
                            new[] { Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar },
                            StringSplitOptions.RemoveEmptyEntries);

                        foreach (string segment in segments)
                        {
                            current = string.IsNullOrEmpty(current) ? segment : Path.Combine(current, segment);
                            string linkTarget = TryResolveLink(current);
                            if (!string.IsNullOrEmpty(linkTarget))
                            {
                                string linkBase = Path.GetDirectoryName(current) ?? baseDir;
                                current = ResolveCanonical(linkBase, linkTarget, depth + 1);
                            }
                        }

                        return TrimTrailingSeparator(Path.GetFullPath(current));
                    }

                    private string TryResolveLink(string path)
                    {
                        try
                        {
                            if (Directory.Exists(path))
                            {
                                if (ResolveDirLink != null)
                                {
                                    var info = ResolveDirLink.Invoke(null, new object[] { path, true }) as FileSystemInfo;
                                    return info == null ? null : info.FullName;
                                }

                                return TryResolveWindowsReparsePoint(path);
                            }

                            if (File.Exists(path))
                            {
                                if (ResolveFileLink != null)
                                {
                                    var info = ResolveFileLink.Invoke(null, new object[] { path, true }) as FileSystemInfo;
                                    return info == null ? null : info.FullName;
                                }

                                return TryResolveWindowsReparsePoint(path);
                            }
                        }
                        catch (IOException)
                        {
                        }
                        catch (UnauthorizedAccessException)
                        {
                        }
                        catch (TargetInvocationException)
                        {
                        }

                        return null;
                    }

                    private string TryResolveWindowsReparsePoint(string path)
                    {
                        if ((File.GetAttributes(path) & FileAttributes.ReparsePoint) == 0)
                        {
                            return null;
                        }

                        if (Path.DirectorySeparatorChar != '\\')
                        {
                            Log.LogWarning(
                                "Cannot resolve reparse point '{0}' because Directory.ResolveLinkTarget is unavailable on this MSBuild runtime.",
                                path);
                            return null;
                        }

                        using (SafeFileHandle handle = CreateFileW(
                            path,
                            0,
                            FileShareAll,
                            IntPtr.Zero,
                            OpenExisting,
                            FileFlagBackupSemantics,
                            IntPtr.Zero))
                        {
                            if (handle.IsInvalid)
                            {
                                Log.LogWarning(
                                    "Unable to resolve Windows link '{0}' (Win32 error {1}).",
                                    path,
                                    Marshal.GetLastWin32Error());
                                return null;
                            }

                            var buffer = new StringBuilder(512);
                            uint length = GetFinalPathNameByHandleW(handle, buffer, (uint)buffer.Capacity, 0);
                            if (length >= buffer.Capacity)
                            {
                                buffer.EnsureCapacity((int)length + 1);
                                length = GetFinalPathNameByHandleW(handle, buffer, (uint)buffer.Capacity, 0);
                            }

                            if (length == 0 || length >= buffer.Capacity)
                            {
                                Log.LogWarning(
                                    "Unable to resolve final path for Windows link '{0}' (Win32 error {1}).",
                                    path,
                                    Marshal.GetLastWin32Error());
                                return null;
                            }

                            string resolved = buffer.ToString();
                            if (resolved.StartsWith(@"\\?\UNC\", StringComparison.OrdinalIgnoreCase))
                            {
                                return @"\\" + resolved.Substring(8);
                            }

                            if (resolved.StartsWith(@"\\?\", StringComparison.OrdinalIgnoreCase))
                            {
                                return resolved.Substring(4);
                            }

                            return resolved;
                        }
                    }

                    private static string TrimTrailingSeparator(string path)
                    {
                        string root = Path.GetPathRoot(path) ?? string.Empty;
                        if (path.Length <= root.Length)
                        {
                            return path;
                        }

                        return path.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
                    }
                }
                ]]>
            </Code>
        </Task>
    </UsingTask>
    <UsingTask TaskName="InspectWebRootOwnershipTask"
               TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <WebRootPath ParameterType="System.String" Required="true" />
            <MarkerFileName ParameterType="System.String" Required="true" />
            <WebRootExists ParameterType="System.Boolean" Output="true" />
            <CanClean ParameterType="System.Boolean" Output="true" />
            <HasForeignContent ParameterType="System.Boolean" Output="true" />
        </ParameterGroup>
        <Task>
            <Code Type="Class" Language="cs">
                <![CDATA[
                using System.IO;
                using System.Linq;
                using Microsoft.Build.Framework;
                using Microsoft.Build.Utilities;

                public sealed class InspectWebRootOwnershipTask : Task
                {
                    [Required]
                    public string WebRootPath { get; set; } = string.Empty;

                    [Required]
                    public string MarkerFileName { get; set; } = string.Empty;

                    [Output]
                    public bool WebRootExists { get; set; }

                    [Output]
                    public bool CanClean { get; set; }

                    [Output]
                    public bool HasForeignContent { get; set; }

                    public override bool Execute()
                    {
                        if (!Directory.Exists(WebRootPath))
                        {
                            WebRootExists = File.Exists(WebRootPath);
                            CanClean = false;
                            HasForeignContent = WebRootExists;
                            return true;
                        }

                        WebRootExists = true;
                        if ((File.GetAttributes(WebRootPath) & FileAttributes.ReparsePoint) != 0)
                        {
                            CanClean = false;
                            HasForeignContent = true;
                            return true;
                        }

                        if (!Directory.EnumerateFileSystemEntries(WebRootPath).Any())
                        {
                            CanClean = true;
                            HasForeignContent = false;
                            return true;
                        }

                        string markerPath = Path.Combine(WebRootPath, MarkerFileName);
                        bool hasValidMarker = File.Exists(markerPath)
                            && (File.GetAttributes(markerPath) & FileAttributes.ReparsePoint) == 0;
                        CanClean = hasValidMarker;
                        HasForeignContent = !hasValidMarker;
                        return true;
                    }
                }
                ]]>
            </Code>
        </Task>
    </UsingTask>
    <Target Name="ValidateDemoOutputDirectories"
            BeforeTargets="BeforeBuild;AssignTargetPaths;RemoveStaleWebRootFromOutput;RemoveStaleWebRootFromPublish;PrepareForPublish">
        <ResolveCanonicalPathTask BaseDirectory="$(MSBuildProjectDirectory)"
                                  TargetPath="$(OutDir)"
                                  ProjectDirectory="$(MSBuildProjectDirectory)"
                                  Condition="'$(OutDir)' != '' and '$([System.String]::IsNullOrWhiteSpace(&quot;$(OutDir)&quot;))' == 'false'">
            <Output TaskParameter="CanonicalPath" PropertyName="_CanonicalOutDir" />
            <Output TaskParameter="OverlapsProjectOrWebRoot" PropertyName="_OutDirOverlapsSource" />
        </ResolveCanonicalPathTask>
        <Error Condition="'$(_OutDirOverlapsSource)' == 'true'"
               Text="Refusing to build MOBAdemo into OutDir '$(OutDir)' because it resolves to '$(_CanonicalOutDir)', overlapping the project directory, tracked wwwroot, or wwwroot-build." />

        <ResolveCanonicalPathTask BaseDirectory="$(MSBuildProjectDirectory)"
                                  TargetPath="$(OutputPath)"
                                  ProjectDirectory="$(MSBuildProjectDirectory)"
                                  Condition="'$(OutputPath)' != '' and '$([System.String]::IsNullOrWhiteSpace(&quot;$(OutputPath)&quot;))' == 'false'">
            <Output TaskParameter="CanonicalPath" PropertyName="_CanonicalOutputPath" />
            <Output TaskParameter="OverlapsProjectOrWebRoot" PropertyName="_OutputPathOverlapsSource" />
        </ResolveCanonicalPathTask>
        <Error Condition="'$(_OutputPathOverlapsSource)' == 'true'"
               Text="Refusing to build MOBAdemo into OutputPath '$(OutputPath)' because it resolves to '$(_CanonicalOutputPath)', overlapping the project directory, tracked wwwroot, or wwwroot-build." />

        <ResolveCanonicalPathTask BaseDirectory="$(MSBuildProjectDirectory)"
                                  TargetPath="$(PublishDir)"
                                  ProjectDirectory="$(MSBuildProjectDirectory)"
                                  Condition="'$(PublishDir)' != '' and '$([System.String]::IsNullOrWhiteSpace(&quot;$(PublishDir)&quot;))' == 'false'">
            <Output TaskParameter="CanonicalPath" PropertyName="_CanonicalPublishDir" />
            <Output TaskParameter="OverlapsProjectOrWebRoot" PropertyName="_PublishDirOverlapsSource" />
        </ResolveCanonicalPathTask>
        <Error Condition="'$(_PublishDirOverlapsSource)' == 'true'"
               Text="Refusing to publish MOBAdemo into PublishDir '$(PublishDir)' because it resolves to '$(_CanonicalPublishDir)', overlapping the project directory, tracked wwwroot, or wwwroot-build." />
    </Target>
    <Target Name="RemoveStaleWebRootFromOutput"
            DependsOnTargets="ValidateDemoOutputDirectories"
            BeforeTargets="BeforeBuild"
            Condition="'$(OutDir)' != '' and '$([System.String]::IsNullOrWhiteSpace(&quot;$(OutDir)&quot;))' == 'false'">
        <PropertyGroup>
            <_NormalizedOutWebRoot>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(OutDir)', 'wwwroot'))</_NormalizedOutWebRoot>
        </PropertyGroup>
        <InspectWebRootOwnershipTask WebRootPath="$(_NormalizedOutWebRoot)"
                                     MarkerFileName=".mobademo-webroot"
                                     Condition="'$(_OutDirOverlapsSource)' != 'true'">
            <Output TaskParameter="WebRootExists" PropertyName="_OutWebRootExists" />
            <Output TaskParameter="CanClean" PropertyName="_OutWebRootCanClean" />
            <Output TaskParameter="HasForeignContent" PropertyName="_OutWebRootHasForeignContent" />
        </InspectWebRootOwnershipTask>
        <Warning Condition="'$(_OutDirOverlapsSource)' != 'true' and '$(_OutWebRootHasForeignContent)' == 'true'"
                 Text="Skipping cleanup of '$(_NormalizedOutWebRoot)' because it contains non-MOBAdemo content (missing '.mobademo-webroot' marker)." />
        <RemoveDir Directories="$(_NormalizedOutWebRoot)"
                   Condition="'$(_OutDirOverlapsSource)' != 'true' and '$(_OutWebRootExists)' == 'true' and '$(_OutWebRootCanClean)' == 'true'" />
    </Target>
    <Target Name="WriteWebRootMarkerToOutput"
            AfterTargets="CopyFilesToOutputDirectory"
            Condition="'$(OutDir)' != '' and '$([System.String]::IsNullOrWhiteSpace(&quot;$(OutDir)&quot;))' == 'false' and '$(_OutDirOverlapsSource)' != 'true' and '$(_OutWebRootHasForeignContent)' != 'true'">
        <PropertyGroup>
            <_NormalizedOutWebRoot>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(OutDir)', 'wwwroot'))</_NormalizedOutWebRoot>
        </PropertyGroup>
        <WriteLinesToFile File="$(_NormalizedOutWebRoot)\.mobademo-webroot"
                          Lines="MOBAdemo generated web root"
                          Overwrite="true"
                          Encoding="utf-8"
                          WriteOnlyWhenDifferent="true"
                          Condition="Exists('$(_NormalizedOutWebRoot)')" />
    </Target>
    <Target Name="RemoveStaleWebRootFromPublish"
            DependsOnTargets="ValidateDemoOutputDirectories"
            BeforeTargets="PrepareForPublish"
            Condition="'$(PublishDir)' != '' and '$([System.String]::IsNullOrWhiteSpace(&quot;$(PublishDir)&quot;))' == 'false'">
        <PropertyGroup>
            <_NormalizedPublishWebRoot>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(PublishDir)', 'wwwroot'))</_NormalizedPublishWebRoot>
        </PropertyGroup>
        <InspectWebRootOwnershipTask WebRootPath="$(_NormalizedPublishWebRoot)"
                                     MarkerFileName=".mobademo-webroot"
                                     Condition="'$(_PublishDirOverlapsSource)' != 'true'">
            <Output TaskParameter="WebRootExists" PropertyName="_PublishWebRootExists" />
            <Output TaskParameter="CanClean" PropertyName="_PublishWebRootCanClean" />
            <Output TaskParameter="HasForeignContent" PropertyName="_PublishWebRootHasForeignContent" />
        </InspectWebRootOwnershipTask>
        <Warning Condition="'$(_PublishDirOverlapsSource)' != 'true' and '$(_PublishWebRootHasForeignContent)' == 'true'"
                 Text="Skipping cleanup of '$(_NormalizedPublishWebRoot)' because it contains non-MOBAdemo content (missing '.mobademo-webroot' marker)." />
        <RemoveDir Directories="$(_NormalizedPublishWebRoot)"
                   Condition="'$(_PublishDirOverlapsSource)' != 'true' and '$(_PublishWebRootExists)' == 'true' and '$(_PublishWebRootCanClean)' == 'true'" />
    </Target>
    <Target Name="WriteWebRootMarkerToPublish"
            AfterTargets="Publish"
            Condition="'$(PublishDir)' != '' and '$([System.String]::IsNullOrWhiteSpace(&quot;$(PublishDir)&quot;))' == 'false' and '$(_PublishDirOverlapsSource)' != 'true' and '$(_PublishWebRootHasForeignContent)' != 'true'">
        <PropertyGroup>
            <_NormalizedPublishWebRoot>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(PublishDir)', 'wwwroot'))</_NormalizedPublishWebRoot>
        </PropertyGroup>
        <WriteLinesToFile File="$(_NormalizedPublishWebRoot)\.mobademo-webroot"
                          Lines="MOBAdemo generated web root"
                          Overwrite="true"
                          Encoding="utf-8"
                          WriteOnlyWhenDifferent="true"
                          Condition="Exists('$(_NormalizedPublishWebRoot)')" />
    </Target>
</Project>
