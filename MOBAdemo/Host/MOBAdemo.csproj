<Project Sdk="Microsoft.NET.Sdk.Web">
    <!--
      MOBAdemo web showcase host. Serves the prepared static files of wwwroot and a health response only.
      It references no repository project and runs no npm or Node step; the build script of a later slice
      produces wwwroot.
    -->
    <PropertyGroup>
        <RootNamespace>Moba.Demo</RootNamespace>
        <AssemblyName>MOBAdemo</AssemblyName>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <ItemGroup>
        <!-- A local run from the build output serves the same files as the published host. -->
        <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <!--
      MOBAdemo\build.ps1 writes the built app to wwwroot-build (ignored by Git). When that folder exists it
      replaces the committed placeholder wwwroot: the output and the publish folder get it as wwwroot.
    -->
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\wwwroot-build\index.html')">
        <Content Remove="wwwroot\**" />
        <None Remove="wwwroot-build\**" />
        <Content Include="wwwroot-build\**"
                 Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <!--
      A reused output or publish folder keeps no web root of an earlier build: PreserveNewest alone would leave
      hashed assets of an older build behind, and a built index.html that is newer than the placeholder would win
      after the built app was removed. The web root folder is therefore recreated on every build and publish.
    -->
    <Target Name="RemoveStaleWebRootFromOutput" BeforeTargets="BeforeBuild">
        <RemoveDir Directories="$(OutDir)wwwroot" />
    </Target>
    <Target Name="RemoveStaleWebRootFromPublish" BeforeTargets="PrepareForPublish">
        <RemoveDir Directories="$(PublishDir)wwwroot" />
    </Target>
</Project>
