{
    "$schema": "https://aka.ms/vs/mcp/schema",
    "servers": {
        "azure-devops": {
            "command": "npx",
            "args": [ "-y", "@azure-devops/mcp@latest", "ahuelsmann", "-d", "all", "-a", "interactive" ],
            "type": "stdio",
            "env": { "AZURE_DEVOPS_ORG_URL": "https://dev.azure.com/ahuelsmann" }
        },
        "filesystem": {
            "command": "npx",
            "args": [ "-y", "@modelcontextprotocol/server-filesystem@latest", "." ],
            "type": "stdio",
            "env": {
                "MCP_FILESYSTEM_ROOT": ".",
                "MCP_FILESYSTEM_ENABLE_DELETE": "false"
            }
        },
        "github": {
            "url": "https://api.githubcopilot.com/mcp/"
        },
        "nuget": {
            "command": "dnx",
            "args": [ "NuGet.Mcp.Server", "--source", "https://api.nuget.org/v3/index.json", "--yes" ],
            "type": "stdio"
        },
        "azure": {
            "command": "npx",
            "args": [ "-y", "@azure/mcp@latest", "server", "start" ],
            "type": "stdio"
        }
    }
}