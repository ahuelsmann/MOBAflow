{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@latest",
        "."
      ],
      "env": {
        "MCP_FILESYSTEM_ROOT": ".",
        "MCP_FILESYSTEM_ENABLE_DELETE": "false"
      }
    },
    "ripgrep": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-ripgrep@latest"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "azure-devops": {
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp@latest",
        "ahuelsmann",
        "-d",
        "all",
        "-a",
        "interactive"
      ],
      "env": {
        "AZURE_DEVOPS_ORG_URL": "https://dev.azure.com/ahuelsmann"
      }
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp"
    },
    "slack": {
      "url": "https://mcp.slack.com/mcp"
    },
    "stack-mcp-server": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://mcp.stackoverflow.com"
      ]
    },
    "linear": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp"
      ]
    },
    "figma": {
      "url": "https://mcp.figma.com/mcp"
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "fetch": {
      "command": "python",
      "args": [
        "-m",
        "mcp_server_fetch"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    }
  }
}