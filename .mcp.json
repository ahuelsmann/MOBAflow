{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@latest",
        "C:\\Repo\\ahuelsmann\\MOBAflow"
      ],
      "env": {
        "MCP_FILESYSTEM_ROOT": "C:\\Repo\\ahuelsmann\\MOBAflow",
        "MCP_FILESYSTEM_ENABLE_DELETE": "false"
      }
    },
    "ripgrep": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-ripgrep@latest"
      ]
    },
    "azure-devops": {
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp@latest",
        "ahuelsmann",
        "-d",
        "all",
        "-a",
        "interactive"
      ],
      "env": {
        "AZURE_DEVOPS_ORG_URL": "https://dev.azure.com/ahuelsmann"
      }
    },
    "fetch": {
      "command": "python",
      "args": [
        "-m",
        "mcp_server_fetch"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    }
  }
}
