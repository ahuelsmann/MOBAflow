#!/bin/sh
# MOBAflow managed main protection hook
# Git runs pre-merge-commit instead of pre-commit for merge commits; fast-forwards create no commit.
branch=$(git symbolic-ref --quiet HEAD)
status=$?
if [ "$status" -gt 1 ]; then
    exit "$status"
fi
if [ "$branch" = refs/heads/main ]; then
    echo "Merge commits on main are blocked. Run 'git merge --abort'; update main only by fast-forward." >&2
    exit 1
fi
exit 0
