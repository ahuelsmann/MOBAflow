<Project>
  <!-- Source Link support is provided by the .NET SDK and uses RepositoryUrl from Directory.Build.props. -->

  <PropertyGroup Condition="'$(MobaAnalyzerGate)' == 'true' and '$(TargetFramework)' != ''">
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <!-- Keep existing IDE diagnostics visible in SARIF; the exact baseline ratchet owns their enforcement. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS0618;IDE0005;IDE0007;IDE0019;IDE0028;IDE0053;IDE0057;IDE0060;IDE0061;IDE0062;IDE0290;IDE0330;IDE0360;IDE2000;IDE2002</WarningsNotAsErrors>
    <_MobaAnalyzerSarifDirectory>$(BaseIntermediateOutputPath)analyzers\$(Configuration)\$(TargetFramework)</_MobaAnalyzerSarifDirectory>
    <_MobaAnalyzerSarifPath>$(_MobaAnalyzerSarifDirectory)\$(MSBuildProjectName).sarif</_MobaAnalyzerSarifPath>
    <ErrorLog>$(_MobaAnalyzerSarifPath),version=2.1</ErrorLog>
  </PropertyGroup>

  <Target
    Name="ValidateMobaAnalyzerGateConfiguration"
    BeforeTargets="CoreCompile"
    Condition="'$(MobaAnalyzerGate)' == 'true' and '$(TargetFramework)' != ''">
    <Error
      Condition="'$(RunAnalyzersDuringBuild)' != 'true'"
      Text="The MOBA analyzer gate requires RunAnalyzersDuringBuild=true." />
    <MakeDir Directories="$(_MobaAnalyzerSarifDirectory)" />
    <Message
      Importance="High"
      Text="MOBA analyzer gate: project=$(MSBuildProjectName), framework=$(TargetFramework), SARIF=$(ErrorLog)" />
  </Target>
</Project>
