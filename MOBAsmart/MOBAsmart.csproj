<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- .NET 10 with MAUI 10.0 workload -->
        <TargetFramework>net10.0-android</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>Moba.MAUI</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <!-- Suppress XC0103: BoolToObjectConverter requires attribute but is from external library (CommunityToolkit.Maui) -->
        <NoWarn>XC0103</NoWarn>
        <!-- Display name -->
        <ApplicationTitle>MOBAsmart</ApplicationTitle>
        <!-- App Identifier -->
        <ApplicationId>com.mobaflow.mobasmart</ApplicationId>
        <!-- Versions -->
        <ApplicationDisplayVersion>1.1</ApplicationDisplayVersion>
        <ApplicationVersion>5</ApplicationVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
        <!-- MOBAsmart uses NullSoundPlayer; workflow WAV assets are desktop-only -->
        <ExcludeSoundContentFromOutput>true</ExcludeSoundContentFromOutput>
    </PropertyGroup>
    <Import Project="Build\AndroidDevPerformance.props" />
    <!-- Visual Studio Android Options read Configuration|TargetFramework|Platform -->
    <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-android|AnyCPU' and '$(MobaReliableDeploy)' != 'true'">
        <EmbedAssembliesIntoApk>false</EmbedAssembliesIntoApk>
        <AndroidUseSharedRuntime>true</AndroidUseSharedRuntime>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='FastDebug|net10.0-android|AnyCPU' and '$(MobaReliableDeploy)' != 'true'">
        <EmbedAssembliesIntoApk>false</EmbedAssembliesIntoApk>
        <AndroidUseSharedRuntime>true</AndroidUseSharedRuntime>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-android|AnyCPU' and '$(MobaReliableDeploy)' == 'true'">
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
        <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='FastDebug|net10.0-android|AnyCPU' and '$(MobaReliableDeploy)' == 'true'">
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
        <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <!-- RELEASE OPTIMIZATIONS -->
        <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
        <AndroidLinkMode>SdkOnly</AndroidLinkMode>
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
        <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
        <AndroidPackageFormats>aab</AndroidPackageFormats>
        <AndroidCreateDebugSymbols>true</AndroidCreateDebugSymbols>
        <AndroidUseApkSigner>true</AndroidUseApkSigner>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
    <!-- Include Linker descriptor -->
    <ItemGroup>
        <TrimmerRootDescriptor Include="Linker.xml" />
    </ItemGroup>
    <ItemGroup>
        <!-- App Icon - PNG-basiert für bessere Android-Kompatibilität -->
        <MauiImage Include="Resources\AppIcon\modern_train_backup.png" Color="#512BD4" />
        <!-- Splash image as MauiImage for use in custom SplashPage -->
        <MauiImage Include="Resources\Splash\splash_background.png" />
        <!-- Static images only; function symbols come from FunctionSymbolMauiImages.props -->
        <MauiImage Include="Resources\Images\icon_camera.svg" />
        <!-- logo_train.png is 1024x1024 (~1.4 MB) and froze first layout when decoded on the UI thread -->
        <MauiImage Remove="Resources\Images\logo_train.png" />
        <!-- In-app branding logo (downsampled at build time; same asset as MauiIcon) -->
        <MauiImage Include="Resources\AppIcon\modern_train_backup.png" Link="Resources\Images\app_logo.png" BaseSize="56,56" />
        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />
        <!-- Raw Assets -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
    <Import Project="FunctionSymbolMauiImages.props" />
    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" />
        <!-- CommunityToolkit.Maui (UI features: Expander, Converters, Behaviors) -->
        <PackageReference Include="CommunityToolkit.Maui" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
        <PackageReference Include="Microsoft.Extensions.Http" />
        <!-- AndroidX Startup (required for initialization providers) -->
        <PackageReference Include="Xamarin.AndroidX.Startup.StartupRuntime" />
        <!-- Note: CommunityToolkit.Mvvm comes via SharedUI project reference -->
    </ItemGroup>
    <ItemGroup>
        <!-- SharedUI provides ViewModels and CommunityToolkit.Mvvm -->
        <ProjectReference Include="..\SharedUI\SharedUI.csproj" />
        <ProjectReference Include="..\Common\Common.csproj" />
        <ProjectReference Include="..\Sound\Sound.csproj">
            <AdditionalProperties>ExcludeSoundContentFromOutput=true</AdditionalProperties>
        </ProjectReference>
    </ItemGroup>
    <ItemGroup>
        <MauiXaml Update="AppShell.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="MainPage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Resources\Styles\DarkTheme.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Resources\Styles\FluentStyles.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Resources\Styles\MobaSmartControlStyles.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Resources\Styles\LightTheme.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="View\AppTabHostPage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Controls\AppBottomTabBar.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="View\SignalBoxPage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Controls\KsSignalScreen.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Controls\SignalAspectPicker.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Controls\LocomotivePickerItemView.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="View\ControlPage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="View\EnginePage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Controls\SpeedGaugeView.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Controls\FunctionToggleView.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Controls\CounterStepperButton.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Controls\ConnectionStatusPanel.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Controls\StatisticsPanel.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="View\SplashPage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
    </ItemGroup>
    <Target
        Name="RemoveSoundAssetsFromAndroidOutput"
        AfterTargets="CopyFilesToOutputDirectory"
        Condition="'$(TargetFramework)' == 'net10.0-android' and '$(ExcludeSoundContentFromOutput)' == 'true'">
        <RemoveDir Directories="$(OutputPath)Resources\Sounds" Condition="Exists('$(OutputPath)Resources\Sounds')" />
    </Target>
</Project>
