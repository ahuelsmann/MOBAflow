<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Moba.MAUI.View.SplashPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#0d0d1a"
    Shell.NavBarIsVisible="False">

    <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Logo Image  -->
        <Image
            Grid.Row="1"
            Aspect="AspectFit"
            HeightRequest="200"
            HorizontalOptions="Center"
            Source="splash_background.png"
            VerticalOptions="End" />

        <!--  App Name Text  -->
        <Label
            Grid.Row="2"
            Margin="0,24,0,0"
            FontAttributes="Bold"
            FontSize="32"
            HorizontalOptions="Center"
            Text="MOBAsmart"
            TextColor="White"
            VerticalOptions="Start" />

        <!--  Optional: Loading indicator or version  -->
        <VerticalStackLayout
            Grid.Row="3"
            Margin="0,0,0,48"
            HorizontalOptions="Center"
            Spacing="12"
            VerticalOptions="End">
            <ActivityIndicator
                HeightRequest="24"
                IsRunning="True"
                WidthRequest="24"
                Color="White" />
            <Label
                x:Name="StatusLabel"
                FontSize="13"
                HorizontalOptions="Center"
                Text="Starting..."
                TextColor="#CCCCCC" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
