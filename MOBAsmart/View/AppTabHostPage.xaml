<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Moba.MAUI.View.AppTabHostPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Moba.MAUI.Controls"
    xmlns:vm="clr-namespace:Moba.SharedUI.ViewModel;assembly=SharedUI"
    Shell.NavBarIsVisible="False"
    Title="MOBAsmart"
    BackgroundColor="{DynamicResource SurfaceBackground}">

    <Grid RowDefinitions="*,Auto,Auto">
        <Grid x:Name="TabContentGrid" Grid.Row="0" />

        <Label
            Grid.Row="1"
            Margin="0,4,0,4"
            FontSize="10"
            HorizontalOptions="Center"
            Text="© 2026 Andreas Huelsmann"
            TextColor="{DynamicResource TextSecondary}" />

        <controls:AppBottomTabBar
            x:Name="BottomTabBar"
            Grid.Row="2"
            TabSelected="OnTabSelected" />
    </Grid>
</ContentPage>
