<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Moba.MAUI.View.ControlPage"
    x:Name="ControlRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Moba.MAUI.Controls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:Moba.SharedUI.ViewModel;assembly=SharedUI"
    xmlns:tc="clr-namespace:Moba.SharedUI.TrainControl;assembly=SharedUI"
    x:DataType="tc:TrainControlViewModel">

    <Grid Padding="16,12,16,0" RowDefinitions="Auto,*" RowSpacing="12">
        <Border
            Padding="12"
            BackgroundColor="{DynamicResource Surface}"
            Stroke="{DynamicResource BorderColor}"
            StrokeShape="RoundRectangle 16"
            StrokeThickness="1">
            <Grid ColumnDefinitions="2*,*" ColumnSpacing="12">
                <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label
                        FontAttributes="Bold"
                        FontAutoScalingEnabled="True"
                        FontSize="20"
                        LineBreakMode="TailTruncation"
                        MaxLines="2"
                        SemanticProperties.Description="{Binding LocomotiveTitle}"
                        Text="{Binding LocomotiveTitle}"
                        TextColor="{DynamicResource TextPrimary}" />
                    <Label
                        FontAutoScalingEnabled="True"
                        LineBreakMode="WordWrap"
                        Style="{DynamicResource BodySmall}"
                        Text="{Binding LocoAddress, StringFormat='DCC {0}'}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                    <Button
                        Padding="6,10"
                        Command="{Binding EmergencyStopCommand}"
                        FontAutoScalingEnabled="True"
                        HeightRequest="-1"
                        MinimumHeightRequest="48"
                        MinimumWidthRequest="48"
                        Style="{DynamicResource DangerButton}"
                        Text="STOP">
                        <SemanticProperties.Description>
                            <MultiBinding StringFormat="Stop selected locomotive {0}, DCC {1}">
                                <Binding Path="LocomotiveTitle" />
                                <Binding Path="LocoAddress" />
                            </MultiBinding>
                        </SemanticProperties.Description>
                    </Button>
                    <Label
                        FontAutoScalingEnabled="True"
                        FontSize="12"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="Selected loco"
                        TextColor="{DynamicResource TextSecondary}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Speed controls and fixed F0-F31 rows share the remaining bounded scroll area. -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="0,0,0,80" Spacing="12">

                <Border
                    Padding="16"
                    BackgroundColor="{DynamicResource Surface}"
                    Stroke="{DynamicResource BorderColor}"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="1">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            IsVisible="{Binding StatusMessage, Converter={toolkit:IsStringNotNullOrEmptyConverter}}"
                            LineBreakMode="TailTruncation"
                            MaxLines="2"
                            Style="{DynamicResource BodySmall}"
                            Text="{Binding StatusMessage}" />

                        <Label Style="{DynamicResource TitleSmall}" Text="Speed" />

                        <VerticalStackLayout Spacing="16">
                        <Border
                            Padding="8,4"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Center"
                            StrokeThickness="0">
                            <controls:SpeedGaugeView
                                DisplayKmh="{Binding SpeedKmh}"
                                GaugeMaxKmh="400"
                                Maximum="{Binding MaxSpeedStep}"
                                SpeedSteps="{Binding SpeedSteps}"
                                VmaxKmh="{Binding SelectedVmax}"
                                Value="{Binding Speed}" />
                        </Border>

                        <Label
                            HorizontalOptions="Center"
                            Style="{DynamicResource BodySmall}"
                            Text="DCC steps" />

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label
                                FontSize="12"
                                Text="0"
                                TextColor="{DynamicResource TextSecondary}"
                                VerticalOptions="Center" />
                            <Slider
                                Grid.Column="1"
                                IsEnabled="{Binding IsSpeedControlEnabled}"
                                Maximum="{Binding MaxSpeedStep}"
                                Minimum="0"
                                Style="{DynamicResource LocomotiveSpeedSliderStyle}"
                                Value="{Binding Speed, Mode=TwoWay}" />
                            <Label
                                Grid.Column="2"
                                FontSize="12"
                                Text="{Binding MaxSpeedStep}"
                                TextColor="{DynamicResource TextSecondary}"
                                VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="4">
                                <Button
                                    Grid.Column="0"
                                    Command="{Binding SetSpeedPresetCommand}"
                                    CommandParameter="0"
                                    Style="{DynamicResource SpeedPresetButton}"
                                    Text="0" />
                                <Button
                                    Grid.Column="1"
                                    Command="{Binding SetSpeedPresetCommand}"
                                    CommandParameter="20"
                                    Style="{DynamicResource SpeedPresetButton}"
                                    Text="20" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding SetSpeedPresetCommand}"
                                    CommandParameter="40"
                                    Style="{DynamicResource SpeedPresetButton}"
                                    Text="40" />
                                <Button
                                    Grid.Column="3"
                                    Command="{Binding SetSpeedPresetCommand}"
                                    CommandParameter="60"
                                    Style="{DynamicResource SpeedPresetButton}"
                                    Text="60" />
                                <Button
                                    Grid.Column="4"
                                    Command="{Binding SetSpeedPresetCommand}"
                                    CommandParameter="80"
                                    Style="{DynamicResource SpeedPresetButton}"
                                    Text="80" />
                                <Button
                                    Grid.Column="5"
                                    Command="{Binding SetSpeedPresetCommand}"
                                    CommandParameter="100"
                                    Style="{DynamicResource SpeedPresetButton}"
                                    Text="100" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="4">
                                <Button
                                    Grid.Column="0"
                                    Command="{Binding SetSpeedPresetCommand}"
                                    CommandParameter="120"
                                    Style="{DynamicResource SpeedPresetButton}"
                                    Text="120" />
                                <Button
                                    Grid.Column="1"
                                    Command="{Binding SetSpeedPresetCommand}"
                                    CommandParameter="140"
                                    Style="{DynamicResource SpeedPresetButton}"
                                    Text="140" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding SetSpeedPresetCommand}"
                                    CommandParameter="160"
                                    Style="{DynamicResource SpeedPresetButton}"
                                    Text="160" />
                                <Button
                                    Grid.Column="3"
                                    Command="{Binding SetSpeedPresetCommand}"
                                    CommandParameter="180"
                                    Style="{DynamicResource SpeedPresetButton}"
                                    Text="180" />
                                <Button
                                    Grid.Column="4"
                                    Command="{Binding SetSpeedPresetCommand}"
                                    CommandParameter="200"
                                    Style="{DynamicResource SpeedPresetButton}"
                                    Text="200" />
                                <Button
                                    Grid.Column="5"
                                    Command="{Binding SetSpeedPresetCommand}"
                                    CommandParameter="250"
                                    Style="{DynamicResource SpeedPresetButton}"
                                    Text="250" />
                            </Grid>
                        </VerticalStackLayout>
                        </VerticalStackLayout>

                        <Label Style="{DynamicResource TitleSmall}" Text="Direction" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label
                                Style="{DynamicResource BodySmall}"
                                Text="{Binding DirectionStatusText}"
                                VerticalOptions="Center" />
                            <Switch
                                Grid.Column="1"
                                IsToggled="{Binding IsForward, Mode=TwoWay, Converter={toolkit:InvertedBoolConverter}}"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        Style="{DynamicResource TitleSmall}"
                        Text="Functions"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="1"
                        Command="{Binding TurnOffAllFunctionsCommand}"
                        Style="{DynamicResource OutlinedButton}"
                        Text="All off" />
                </Grid>

                <!-- BindableLayout creates fixed F0-F31 rows without CollectionView recycling. -->
                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding Functions}"
                    Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:FunctionButtonViewModel">
                            <controls:FunctionToggleView ToggleCommand="{Binding Source={x:Reference ControlRoot}, Path=BindingContext.ToggleFunctionCommand}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>

