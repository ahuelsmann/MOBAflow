<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Moba.MAUI.View.ControlPage"
    x:Name="ControlRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Moba.MAUI.Controls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:Moba.SharedUI.ViewModel;assembly=SharedUI"
    x:DataType="vm:TrainControlViewModel">

    <!-- Fixed F0-F31 rows: no BindableLayout/CollectionView recycling (<=32 keys per DCC loco). -->
    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,24" Spacing="12">

            <Border
                Padding="16"
                BackgroundColor="{DynamicResource Surface}"
                Stroke="{DynamicResource BorderColor}"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="1">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                FontAttributes="Bold"
                                FontSize="20"
                                Text="{Binding LocomotiveTitle}"
                                TextColor="{DynamicResource TextPrimary}" />
                            <Label
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                Style="{DynamicResource BodySmall}"
                                Text="{Binding StatusMessage}" />
                        </VerticalStackLayout>
                        <Button
                            Grid.Column="1"
                            Command="{Binding EmergencyStopCommand}"
                            Style="{DynamicResource DangerButton}"
                            Text="STOP"
                            VerticalOptions="Center" />
                    </Grid>

                    <Label Style="{DynamicResource TitleSmall}" Text="Speed" />

                    <controls:SpeedGaugeView
                        DisplayKmh="{Binding SpeedKmh}"
                        Maximum="{Binding MaxSpeedStep}"
                        SemanticProperties.Description="{Binding SpeedKmh, StringFormat='Current speed {0} kilometers per hour'}"
                        SpeedSteps="{Binding SpeedSteps}"
                        VmaxKmh="{Binding SelectedVmax}"
                        Value="{Binding Speed}" />

                    <Label
                        HorizontalOptions="Center"
                        Style="{DynamicResource LabelSmall}"
                        Text="{Binding Speed, StringFormat='Step {0}'}" />

                    <Slider
                        IsEnabled="{Binding IsSpeedControlEnabled}"
                        Maximum="{Binding MaxSpeedStep}"
                        Minimum="0"
                        Style="{DynamicResource LocomotiveSpeedSliderStyle}"
                        Value="{Binding Speed, Mode=TwoWay}" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button
                            Grid.Column="0"
                            Command="{Binding SetSpeedPresetCommand}"
                            CommandParameter="0"
                            Text="0" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding SetSpeedPresetCommand}"
                            CommandParameter="40"
                            Text="40" />
                        <Button
                            Grid.Column="2"
                            Command="{Binding SetSpeedPresetCommand}"
                            CommandParameter="80"
                            Text="80" />
                    </Grid>

                    <Label Style="{DynamicResource TitleSmall}" Text="Direction" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label
                            Style="{DynamicResource BodySmall}"
                            Text="{Binding DirectionStatusText}"
                            VerticalOptions="Center" />
                        <Switch
                            Grid.Column="1"
                            IsToggled="{Binding IsForward, Mode=TwoWay, Converter={toolkit:InvertedBoolConverter}}"
                            VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button
                Command="{Binding Source={x:Reference ControlRoot}, Path=ChangeLocomotiveCommand}"
                HorizontalOptions="Start"
                Style="{DynamicResource OutlinedButton}"
                Text="Change locomotive" />

            <Grid ColumnDefinitions="*,Auto">
                <Label
                    Style="{DynamicResource TitleSmall}"
                    Text="Functions"
                    VerticalOptions="Center" />
                <Button
                    Grid.Column="1"
                    Command="{Binding TurnOffAllFunctionsCommand}"
                    Style="{DynamicResource OutlinedButton}"
                    Text="All off" />
            </Grid>

            <VerticalStackLayout Spacing="8">
                <controls:FunctionToggleView BacklightColorHex="{Binding Functions[0].BacklightColorHex}" FunctionIndex="0" IconAsset="{Binding Functions[0].IconAsset}" IsOn="{Binding Functions[0].IsOn}" Description="{Binding Functions[0].Description}" Label="{Binding Functions[0].Label}" ToggleCommand="{Binding ToggleFunctionCommand}" />
                <controls:FunctionToggleView BacklightColorHex="{Binding Functions[1].BacklightColorHex}" FunctionIndex="1" IconAsset="{Binding Functions[1].IconAsset}" IsOn="{Binding Functions[1].IsOn}" Description="{Binding Functions[1].Description}" Label="{Binding Functions[1].Label}" ToggleCommand="{Binding ToggleFunctionCommand}" />
                <controls:FunctionToggleView BacklightColorHex="{Binding Functions[2].BacklightColorHex}" FunctionIndex="2" IconAsset="{Binding Functions[2].IconAsset}" IsOn="{Binding Functions[2].IsOn}" Description="{Binding Functions[2].Description}" Label="{Binding Functions[2].Label}" ToggleCommand="{Binding ToggleFunctionCommand}" />
                <controls:FunctionToggleView BacklightColorHex="{Binding Functions[3].BacklightColorHex}" FunctionIndex="3" IconAsset="{Binding Functions[3].IconAsset}" IsOn="{Binding Functions[3].IsOn}" Description="{Binding Functions[3].Description}" Label="{Binding Functions[3].Label}" ToggleCommand="{Binding ToggleFunctionCommand}" />
                <controls:FunctionToggleView BacklightColorHex="{Binding Functions[4].BacklightColorHex}" FunctionIndex="4" IconAsset="{Binding Functions[4].IconAsset}" IsOn="{Binding Functions[4].IsOn}" Description="{Binding Functions[4].Description}" Label="{Binding Functions[4].Label}" ToggleCommand="{Binding ToggleFunctionCommand}" />
                <controls:FunctionToggleView BacklightColorHex="{Binding Functions[5].BacklightColorHex}" FunctionIndex="5" IconAsset="{Binding Functions[5].IconAsset}" IsOn="{Binding Functions[5].IsOn}" Description="{Binding Functions[5].Description}" Label="{Binding Functions[5].Label}" ToggleCommand="{Binding ToggleFunctionCommand}" />
                <controls:FunctionToggleView BacklightColorHex="{Binding Functions[6].BacklightColorHex}" FunctionIndex="6" IconAsset="{Binding Functions[6].IconAsset}" IsOn="{Binding Functions[6].IsOn}" Description="{Binding Functions[6].Description}" Label="{Binding Functions[6].Label}" ToggleCommand="{Binding ToggleFunctionCommand}" />
