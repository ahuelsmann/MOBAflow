                <controls:FunctionToggleView BacklightColorHex="{Binding Functions[11].BacklightColorHex}" FunctionIndex="11" IconAsset="{Binding Functions[11].IconAsset}" IsOn="{Binding Functions[11].IsOn}" Description="{Binding Functions[11].Description}" Label="{Binding Functions[11].Label}" ToggleCommand="{Binding ToggleFunctionCommand}" />
