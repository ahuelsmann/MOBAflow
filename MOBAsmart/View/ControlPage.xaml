                <controls:FunctionToggleView BacklightColorHex="{Binding Functions[25].BacklightColorHex}" FunctionIndex="25" IconAsset="{Binding Functions[25].IconAsset}" IsOn="{Binding Functions[25].IsOn}" Description="{Binding Functions[25].Description}" Label="{Binding Functions[25].Label}" ToggleCommand="{Binding ToggleFunctionCommand}" />
                <controls:FunctionToggleView BacklightColorHex="{Binding Functions[26].BacklightColorHex}" FunctionIndex="26" IconAsset="{Binding Functions[26].IconAsset}" IsOn="{Binding Functions[26].IsOn}" Description="{Binding Functions[26].Description}" Label="{Binding Functions[26].Label}" ToggleCommand="{Binding ToggleFunctionCommand}" />
                <controls:FunctionToggleView BacklightColorHex="{Binding Functions[27].BacklightColorHex}" FunctionIndex="27" IconAsset="{Binding Functions[27].IconAsset}" IsOn="{Binding Functions[27].IsOn}" Description="{Binding Functions[27].Description}" Label="{Binding Functions[27].Label}" ToggleCommand="{Binding ToggleFunctionCommand}" />
                <controls:FunctionToggleView BacklightColorHex="{Binding Functions[28].BacklightColorHex}" FunctionIndex="28" IconAsset="{Binding Functions[28].IconAsset}" IsOn="{Binding Functions[28].IsOn}" Description="{Binding Functions[28].Description}" Label="{Binding Functions[28].Label}" ToggleCommand="{Binding ToggleFunctionCommand}" />
                <controls:FunctionToggleView BacklightColorHex="{Binding Functions[29].BacklightColorHex}" FunctionIndex="29" IconAsset="{Binding Functions[29].IconAsset}" IsOn="{Binding Functions[29].IsOn}" Description="{Binding Functions[29].Description}" Label="{Binding Functions[29].Label}" ToggleCommand="{Binding ToggleFunctionCommand}" />
                <controls:FunctionToggleView BacklightColorHex="{Binding Functions[30].BacklightColorHex}" FunctionIndex="30" IconAsset="{Binding Functions[30].IconAsset}" IsOn="{Binding Functions[30].IsOn}" Description="{Binding Functions[30].Description}" Label="{Binding Functions[30].Label}" ToggleCommand="{Binding ToggleFunctionCommand}" />
                <controls:FunctionToggleView BacklightColorHex="{Binding Functions[31].BacklightColorHex}" FunctionIndex="31" IconAsset="{Binding Functions[31].IconAsset}" IsOn="{Binding Functions[31].IsOn}" Description="{Binding Functions[31].Description}" Label="{Binding Functions[31].Label}" ToggleCommand="{Binding ToggleFunctionCommand}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>

