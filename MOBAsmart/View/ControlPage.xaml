<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Moba.MAUI.View.ControlPage"
    x:Name="ControlRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:Moba.SharedUI.ViewModel;assembly=SharedUI"
    x:DataType="vm:TrainControlViewModel">

    <!-- No CollectionView at all: ScrollView + BindableLayout only (<=32 function rows). -->
    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,24" Spacing="12">

            <Border
                Padding="16"
                BackgroundColor="{DynamicResource Surface}"
                Stroke="{DynamicResource BorderColor}"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="1">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                FontAttributes="Bold"
                                FontSize="20"
                                Text="{Binding LocomotiveTitle}"
                                TextColor="{DynamicResource TextPrimary}" />
                            <Label
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                Style="{DynamicResource BodySmall}"
                                Text="{Binding StatusMessage}" />
                        </VerticalStackLayout>
                        <Button
                            Grid.Column="1"
                            Command="{Binding EmergencyStopCommand}"
                            Style="{DynamicResource DangerButton}"
                            Text="STOP"
                            VerticalOptions="Center" />
                    </Grid>

                    <Label Style="{DynamicResource TitleSmall}" Text="Speed" />

                    <Label
                        FontAttributes="Bold"
                        FontSize="36"
                        HorizontalOptions="Center"
                        Text="{Binding SpeedKmh, StringFormat='{0} km/h'}"
                        TextColor="{DynamicResource RailwayAccent}" />

                    <Label
                        HorizontalOptions="Center"
                        Style="{DynamicResource LabelSmall}"
                        Text="{Binding Speed, StringFormat='Step {0}'}" />

                    <Slider
                        IsEnabled="{Binding IsSpeedControlEnabled}"
                        Maximum="{Binding MaxSpeedStep}"
                        Minimum="0"
                        Style="{DynamicResource LocomotiveSpeedSliderStyle}"
                        Value="{Binding Speed, Mode=TwoWay}" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button
                            Grid.Column="0"
                            Command="{Binding SetSpeedPresetCommand}"
                            CommandParameter="0"
                            Text="0" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding SetSpeedPresetCommand}"
                            CommandParameter="40"
                            Text="40" />
                        <Button
                            Grid.Column="2"
                            Command="{Binding SetSpeedPresetCommand}"
                            CommandParameter="80"
                            Text="80" />
                    </Grid>

                    <Label Style="{DynamicResource TitleSmall}" Text="Direction" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button
                            Grid.Column="0"
                            Command="{Binding SetDirectionCommand}"
                            CommandParameter="True"
                            Text="Forward" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding SetDirectionCommand}"
                            CommandParameter="False"
                            Text="Backward" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border
                Padding="16"
                BackgroundColor="{DynamicResource Surface}"
                Stroke="{DynamicResource BorderColor}"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="1">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{DynamicResource TitleSmall}" Text="Locomotives" />

                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding ProjectLocomotives}"
                        Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:LocomotiveViewModel">
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="12"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{StaticResource SelectLocomotiveCommand}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsPickerSelected}"
                                            TargetType="Border"
                                            Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource RailwayPrimary}" />
                                            <Setter Property="Stroke" Value="{DynamicResource RailwayPrimary}" />
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding IsPickerSelected}"
                                            TargetType="Border"
                                            Value="False">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceDark}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            Text="{Binding Name}" />
                                        <Label
                                            Style="{DynamicResource BodySmall}"
                                            Text="{Binding DigitalAddress, StringFormat='Digital address {0}'}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label
                        IsVisible="{Binding HasProjectLocomotives, Converter={toolkit:InvertedBoolConverter}}"
                        Style="{DynamicResource BodySmall}"
                        Text="No locomotives available yet. Connect to MOBAflow once to sync your fleet." />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto">
                <Label
                    Style="{DynamicResource TitleSmall}"
                    Text="Functions"
                    VerticalOptions="Center" />
                <Button
                    Grid.Column="1"
                    Command="{Binding TurnOffAllFunctionsCommand}"
                    Style="{DynamicResource OutlinedButton}"
                    Text="All off" />
            </Grid>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Functions}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:FunctionButtonViewModel">
                        <Button
                            Command="{StaticResource ToggleFunctionCommand}"
                            CommandParameter="{Binding Index}"
                            CornerRadius="12"
                            FontSize="12"
                            HeightRequest="52"
                            Text="{Binding Label}">
                            <Button.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsOn}"
                                    TargetType="Button"
                                    Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource RailwayAccent}" />
                                    <Setter Property="TextColor" Value="{DynamicResource TextOnPrimary}" />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding IsOn}"
                                    TargetType="Button"
                                    Value="False">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceDark}" />
                                    <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
