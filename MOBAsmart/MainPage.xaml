<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Moba.MAUI.CounterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Moba.SharedUI.ViewModel;assembly=SharedUI"
    xmlns:controls="clr-namespace:Moba.MAUI.Controls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="local:MauiViewModel">

    <ContentView.Resources>
        <ResourceDictionary>
            <Style x:Key="StepperButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceDark}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariant}" />
                                    <Setter Property="TextColor" Value="{DynamicResource TextDisabled}" />
                                    <Setter Property="Opacity" Value="0.85" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style x:Key="StepperValueBorderStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceDark}" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="HeightRequest" Value="44" />
            </Style>

            <Style x:Key="MetricTileStyle" TargetType="Border">
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceDark}" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
                <Setter Property="StrokeThickness" Value="0" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <ScrollView>
        <VerticalStackLayout
            Padding="0"
            HorizontalOptions="Fill"
            Spacing="8">
            <controls:ConnectionStatusPanel x:Name="ConnectionHeader" />

            <!--  System Stats Card (when connected)  -->
            <Border
                x:Name="LiveDataSectionCard"
                IsVisible="{Binding IsConnected}"
                Style="{DynamicResource MainSectionCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{DynamicResource SectionTitleLabel}" Text="Z21 Status" />
                    <Border Style="{StaticResource MetricTileStyle}">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <HorizontalStackLayout
                                Grid.Column="0"
                                HorizontalOptions="Center"
                                Spacing="4">
                                <Label
                                    FontSize="14"
                                    Text="🌡️"
                                    VerticalOptions="Center" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    LineBreakMode="NoWrap"
                                    Text="{Binding Temperature, StringFormat='{0}°C'}"
                                    TextColor="{DynamicResource TextPrimary}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout
                                Grid.Column="1"
                                HorizontalOptions="Center"
                                Spacing="4">
                                <Label
                                    FontSize="14"
                                    Text="🔌"
                                    VerticalOptions="Center" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    LineBreakMode="NoWrap"
                                    Text="{Binding SupplyVoltage, StringFormat='{0}mV'}"
                                    TextColor="{DynamicResource TextPrimary}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout
                                Grid.Column="2"
                                HorizontalOptions="Center"
                                Spacing="4">
                                <Label
                                    FontSize="14"
                                    Text="⚡"
                                    VerticalOptions="Center" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    LineBreakMode="NoWrap"
                                    Text="{Binding VccVoltage, StringFormat='{0}mV'}"
                                    TextColor="{DynamicResource TextPrimary}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!--  Counter Settings Card (Compact & Aligned)  -->
            <Border x:Name="SetupSectionCard" Style="{DynamicResource MainSectionCard}">
                <VerticalStackLayout Spacing="10">
                    <Label Style="{DynamicResource SectionTitleLabel}" Text="Lap Counter Setup" />
                    <!--  Section Header  -->
                    <Grid ColumnDefinitions="*,*">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="Feedback Points"
                            TextColor="{DynamicResource TextSecondary}" />
                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="12"
                            HorizontalTextAlignment="End"
                            Text="Lap Counter"
                            TextColor="{DynamicResource TextSecondary}" />
                    </Grid>

                    <!--  Feedback Points & Target Laps (Full-Width Aligned)  -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <!--  Feedback Points Stepper  -->
                        <Grid
                            Grid.Column="0"
                            ColumnDefinitions="44,*,44"
                            ColumnSpacing="4">
                            <Button
                                Grid.Column="0"
                                Command="{Binding DecrementFeedbackPointsCommand}"
                                SemanticProperties.Description="Reduce feedback points"
                                Style="{StaticResource StepperButtonStyle}"
                                Text="−" />
                            <Border Grid.Column="1" Style="{StaticResource StepperValueBorderStyle}">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    HorizontalOptions="Center"
                                    Text="{Binding CountOfFeedbackPoints}"
                                    TextColor="{DynamicResource TextPrimary}"
                                    VerticalOptions="Center" />
                            </Border>
                            <Button
                                Grid.Column="2"
                                Command="{Binding IncrementFeedbackPointsCommand}"
                                SemanticProperties.Description="Increase feedback points"
                                Style="{StaticResource StepperButtonStyle}"
                                Text="+" />
                        </Grid>
                        <!--  Target Lap Count Stepper  -->
                        <Grid
                            Grid.Column="1"
                            ColumnDefinitions="44,*,44"
                            ColumnSpacing="4">
                            <Button
                                Grid.Column="0"
                                Command="{Binding DecrementTargetLapCountCommand}"
                                SemanticProperties.Description="Reduce target lap count"
                                Style="{StaticResource StepperButtonStyle}"
                                Text="−" />
                            <Border Grid.Column="1" Style="{StaticResource StepperValueBorderStyle}">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    HorizontalOptions="Center"
                                    Text="{Binding GlobalTargetLapCount}"
                                    TextColor="{DynamicResource TextPrimary}"
                                    VerticalOptions="Center" />
                            </Border>
                            <Button
                                Grid.Column="2"
                                Command="{Binding IncrementTargetLapCountCommand}"
                                SemanticProperties.Description="Increase target lap count"
                                Style="{StaticResource StepperButtonStyle}"
                                Text="+" />
                        </Grid>
                    </Grid>

                    <!--  Timer Filter Row (Aligned)  -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <HorizontalStackLayout
                            Grid.Column="0"
                            HeightRequest="44"
                            HorizontalOptions="Start"
                            Spacing="8"
                            VerticalOptions="Center">
                            <CheckBox
                                IsChecked="{Binding UseTimerFilter}"
                                VerticalOptions="Center"
                                Color="{DynamicResource RailwayPrimary}" />
                            <Label
                                FontSize="13"
                                Text="Timer Filter"
                                TextColor="{DynamicResource TextSecondary}"
                                VerticalOptions="Center"
                                VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                        <Grid
                            Grid.Column="1"
                            ColumnDefinitions="44,*,44"
                            ColumnSpacing="4">
                            <Button
                                Grid.Column="0"
                                Command="{Binding DecrementTimerIntervalCommand}"
                                IsEnabled="{Binding UseTimerFilter}"
                                SemanticProperties.Description="Reduce timer filter interval"
                                Style="{StaticResource StepperButtonStyle}"
                                Text="−" />
                            <Border Grid.Column="1" Style="{StaticResource StepperValueBorderStyle}">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    HorizontalOptions="Center"
                                    Text="{Binding TimerIntervalSeconds, StringFormat='{0:F1}s'}"
                                    TextColor="{DynamicResource TextPrimary}"
                                    VerticalOptions="Center" />
                            </Border>
                            <Button
                                Grid.Column="2"
                                Command="{Binding IncrementTimerIntervalCommand}"
                                IsEnabled="{Binding UseTimerFilter}"
                                SemanticProperties.Description="Increase timer filter interval"
                                Style="{StaticResource StepperButtonStyle}"
                                Text="+" />
                        </Grid>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <controls:StatisticsPanel x:Name="StatisticsSection" />

            <!--  Footer  -->
            <Label
                Margin="0,8,0,12"
                FontSize="10"
                HorizontalOptions="Center"
                Text="© 2026 Andreas Huelsmann"
                TextColor="{DynamicResource TextSecondary}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>