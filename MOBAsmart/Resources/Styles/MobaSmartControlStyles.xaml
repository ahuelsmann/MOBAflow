<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Shared control styles registered once in App.xaml.
    ContentView XAML: reference these styles with DynamicResource (StaticResource fails at parse time).
    Inside Style setters use DynamicResource for theme colors.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style x:Key="MainSectionCard" TargetType="Border">
        <Setter Property="Margin" Value="16,4" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="Stroke" Value="{DynamicResource Border}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
    </Style>

    <Style x:Key="SectionTitleLabel" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="FluentBottomTabBarLabel" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="StepperValueBorderStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceDark}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="HeightRequest" Value="44" />
    </Style>

    <Style x:Key="MetricTileStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceDark}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="StrokeThickness" Value="0" />
    </Style>

    <Style x:Key="SpeedPresetButton" TargetType="Button">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="2,8" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.94" />
                            <Setter Property="Opacity" Value="0.88" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

</ResourceDictionary>
