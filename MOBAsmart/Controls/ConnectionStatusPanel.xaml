<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Moba.MAUI.Controls.ConnectionStatusPanel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Moba.SharedUI.ViewModel;assembly=SharedUI"
    xmlns:converters="clr-namespace:Moba.MAUI.Converters"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="local:MauiViewModel"
    x:Name="ConnectionStatusRoot">

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:ThemeResourceKeyConverter x:Key="ThemeResourceKeyConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Border Style="{DynamicResource MainSectionCard}">
        <VerticalStackLayout Spacing="10">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <Label
                    Grid.Column="0"
                    FontAttributes="Bold"
                    FontSize="24"
                    Text="MOBAsmart"
                    TextColor="{DynamicResource RailwayPrimary}"
                    VerticalOptions="Center" />

                <Image
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    HeightRequest="28"
                    Source="engine.png"
                    VerticalOptions="Center"
                    WidthRequest="28" />

                <HorizontalStackLayout
                    Grid.Column="3"
                    Spacing="4"
                    VerticalOptions="Center">
                    <Label
                        x:Name="ThemeIcon"
                        FontSize="14"
                        Text="🌙"
                        VerticalOptions="Center" />
                    <Switch
                        x:Name="ThemeSwitch"
                        OnColor="{DynamicResource RailwayPrimary}"
                        SemanticProperties.Description="Toggle light or dark application theme"
                        ThumbColor="{DynamicResource White}"
                        Toggled="ThemeSwitch_Toggled" />
                </HorizontalStackLayout>
            </Grid>

            <BoxView HeightRequest="1" Color="{DynamicResource BorderColor}" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <HorizontalStackLayout
                    Grid.Column="0"
                    HorizontalOptions="Start"
                    Spacing="6"
                    VerticalOptions="Center">
                    <Border
                        x:Name="ConnectionIndicator"
                        BackgroundColor="{Binding Z21IndicatorResourceKey, Converter={StaticResource ThemeResourceKeyConverter}}"
                        HeightRequest="12"
                        StrokeShape="RoundRectangle 6"
                        StrokeThickness="0"
                        WidthRequest="12" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="12"
                        Text="Z21"
                        TextColor="{DynamicResource TextSecondary}"
                        VerticalOptions="Center" />
                    <Label
                        Margin="2,0,0,0"
                        FontSize="12"
                        SemanticProperties.Description="{Binding Z21StatusSemanticDescription}"
                        Text="{Binding Z21StatusText}"
                        TextColor="{Binding Z21IndicatorResourceKey, Converter={StaticResource ThemeResourceKeyConverter}}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <HorizontalStackLayout
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    Spacing="6"
                    VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding RetryRestApiDiscoveryCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Border
                        BackgroundColor="{Binding RestApiIndicatorResourceKey, Converter={StaticResource ThemeResourceKeyConverter}}"
                        HeightRequest="12"
                        StrokeShape="RoundRectangle 6"
                        StrokeThickness="0"
                        WidthRequest="12" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="12"
                        Text="MOBAflow"
                        TextColor="{DynamicResource TextSecondary}"
                        VerticalOptions="Center" />
                    <Label
                        Margin="2,0,0,0"
                        FontSize="12"
                        SemanticProperties.Description="MOBAflow connection status. Tap to search for MOBAflow on the network."
                        Text="{Binding RestApiStatusText}"
                        TextColor="{Binding RestApiIndicatorResourceKey, Converter={StaticResource ThemeResourceKeyConverter}}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <HorizontalStackLayout
                    Grid.Column="2"
                    HorizontalOptions="End"
                    VerticalOptions="Center">
                    <Button
                        Command="{Binding CaptureAndUploadPhotoCommand}"
                        HeightRequest="44"
                        ImageSource="icon_camera"
                        IsEnabled="{Binding IsPhotoUploading, Converter={toolkit:BoolToObjectConverter TrueObject=False, FalseObject=True}}"
                        Padding="8"
                        SemanticProperties.Description="Capture a photo and upload it to MOBAflow"
                        Style="{DynamicResource AccentButtonStyle}"
                        WidthRequest="44" />
                </HorizontalStackLayout>
            </Grid>

            <BoxView HeightRequest="1" Color="{DynamicResource Border}" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <HorizontalStackLayout
                    Grid.Column="0"
                    Spacing="8"
                    VerticalOptions="Center">
                    <Label
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="Track Power"
                        TextColor="{DynamicResource TextPrimary}"
                        VerticalOptions="Center" />
                    <Label
                        FontSize="12"
                        Text="{Binding TrackPowerStatusText}"
                        TextColor="{Binding TrackPowerStatusResourceKey, Converter={StaticResource ThemeResourceKeyConverter}}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Switch
                    x:Name="TrackPowerSwitch"
                    Grid.Column="1"
                    IsEnabled="{Binding IsConnected}"
                    IsToggled="{Binding IsTrackPowerOn, Mode=OneWay}"
                    OnColor="{DynamicResource RailwayWarning}"
                    SemanticProperties.Description="Toggle track power for connected Z21"
                    ThumbColor="{DynamicResource White}"
                    Toggled="TrackPowerSwitch_Toggled"
                    VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
