<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Moba.MAUI.Controls.SignalAspectPicker"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Moba.MAUI.Controls"
    xmlns:display="clr-namespace:Moba.Common.Display;assembly=Common">
    <Grid
        ColumnDefinitions="*,*,*"
        ColumnSpacing="6"
        RowDefinitions="Auto,Auto,Auto"
        RowSpacing="6">
        <Border
            x:Name="AspectHp0Button"
            Grid.Row="0"
            Grid.Column="0"
            Padding="8"
            HeightRequest="112"
            Stroke="{DynamicResource BorderColor}"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="1">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAspectTapped" CommandParameter="{x:Static display:KsSignalAspectNames.Hp0}" />
            </Border.GestureRecognizers>
            <VerticalStackLayout HorizontalOptions="Center" Spacing="6" VerticalOptions="Center">
                <controls:KsSignalScreen
                    Aspect="{x:Static display:KsSignalAspectNames.Hp0}"
                    BottomSpeedValue="{Binding Source={x:Reference Root}, Path=BottomSpeedValue}"
                    InputTransparent="True"
                    IsPreviewMode="True"
                    SignalArticleNumber="{Binding Source={x:Reference Root}, Path=PreviewSignalArticleNumber}"
                    TopSpeedValue="{Binding Source={x:Reference Root}, Path=TopSpeedValue}" />
                <Label
                    x:Name="AspectHp0Label"
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    Text="Hp0"
                    TextColor="{DynamicResource TextPrimary}" />
            </VerticalStackLayout>
        </Border>

