<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Moba.MAUI.Controls.LanguageSettingsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:l="clr-namespace:Moba.MAUI.Localization"
    xmlns:vm="clr-namespace:Moba.SharedUI.ViewModel;assembly=SharedUI"
    x:DataType="vm:LanguageSettingsViewModel">
    <Border Style="{DynamicResource MainSectionCard}">
        <VerticalStackLayout Spacing="8">
            <Label Text="{l:Localize LanguageTitle}" Style="{DynamicResource SectionTitleLabel}" />
            <Picker
                Title="{l:Localize LanguageChoice}"
                SemanticProperties.Description="{l:Localize LanguageChoice}"
                ItemsSource="{Binding Choices}"
                ItemDisplayBinding="{Binding Name, x:DataType=vm:LanguageChoice}"
                SelectedItem="{Binding SelectedChoice}"
                TextColor="{DynamicResource TextPrimary}" />
            <Label Text="{l:Localize LanguageExplanation}" TextColor="{DynamicResource TextSecondary}" />
            <Button Text="{l:Localize LanguageSave}" Command="{Binding SaveCommand}" />
            <Label Text="{Binding Message}" TextColor="{DynamicResource TextPrimary}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
