<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Moba.MAUI.Controls.CounterStepperButton"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    HeightRequest="44"
    WidthRequest="44">
    <Border
        x:Name="StepperBorder"
        BackgroundColor="{DynamicResource SurfaceDark}"
        HeightRequest="44"
        Stroke="{DynamicResource BorderColor}"
        StrokeShape="RoundRectangle 8"
        StrokeThickness="0"
        WidthRequest="44">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command, Source={x:Reference Root}}" />
        </Border.GestureRecognizers>
        <Label
            x:Name="SymbolLabel"
            FontAttributes="Bold"
            FontSize="22"
            HorizontalOptions="Center"
            Text="{Binding Symbol, Source={x:Reference Root}}"
            TextColor="{DynamicResource TextPrimary}"
            VerticalOptions="Center"
            VerticalTextAlignment="Center" />
    </Border>
</ContentView>
