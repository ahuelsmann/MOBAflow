<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Moba.MAUI.Controls.KsSignalScreen"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    MinimumHeightRequest="70"
    MinimumWidthRequest="64">
    <Grid
        x:Name="ScaleHost"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">
        <Grid
            x:Name="SignalGrid"
            AnchorX="0.5"
            AnchorY="0.5"
            Padding="6"
            ColumnSpacing="3"
            HorizontalOptions="Center"
            RowSpacing="3"
            VerticalOptions="Center"
            WidthRequest="90">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopSpeedRow" Height="0" />
                <RowDefinition Height="15" />
                <RowDefinition Height="21" />
                <RowDefinition Height="21" />
                <RowDefinition Height="15" />
                <RowDefinition Height="15" />
                <RowDefinition x:Name="BottomSpeedRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="17.25" />
                <ColumnDefinition Width="17.25" />
                <ColumnDefinition Width="17.25" />
                <ColumnDefinition Width="17.25" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Row="1"
                Grid.RowSpan="5"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                BackgroundColor="{DynamicResource SignalHousingBackground}"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4" />
                </Border.StrokeShape>
            </Border>

            <Border
                x:Name="TopSpeedBox"
                Grid.Row="0"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                BackgroundColor="{DynamicResource SignalHousingBackground}"
                HeightRequest="32"
                HorizontalOptions="Center"
                IsVisible="False"
                StrokeThickness="0"
                VerticalOptions="Center"
                WidthRequest="44">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="2" />
                </Border.StrokeShape>
                <Label
                    x:Name="TopSpeedIndicator"
                    FontAttributes="Bold"
                    FontSize="20"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Text=""
                    TextColor="{DynamicResource TextPrimary}"
                    VerticalOptions="Center"
                    VerticalTextAlignment="Center" />
            </Border>

            <Ellipse
                x:Name="W1"
                Grid.Row="1"
                Grid.Column="0"
                Fill="#3C404040"
                HeightRequest="12"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="12" />

            <Ellipse
                x:Name="Hp0"
                Grid.Row="2"
                Grid.Column="2"
                Fill="#3C404040"
                HeightRequest="18"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="18" />

            <Ellipse
                x:Name="Ks1"
                Grid.Row="3"
                Grid.Column="1"
                Fill="#3C404040"
                HeightRequest="18"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="18" />
            <Ellipse
                x:Name="Ks2"
                Grid.Row="3"
                Grid.Column="3"
                Fill="#3C404040"
                HeightRequest="18"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="18" />

            <Ellipse
                x:Name="W2"
                Grid.Row="4"
                Grid.Column="1"
                Fill="#3C404040"
                HeightRequest="12"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="12" />
            <Ellipse
                x:Name="Zs7Center"
                Grid.Row="4"
                Grid.Column="2"
                Fill="#3C404040"
                HeightRequest="12"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="12" />
            <Ellipse
                x:Name="Zs7Right"
                Grid.Row="4"
                Grid.Column="3"
                Fill="#3C404040"
                HeightRequest="12"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="12" />

            <Ellipse
                x:Name="W3"
                Grid.Row="5"
                Grid.Column="0"
                Fill="#3C404040"
                HeightRequest="12"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="12" />
            <Ellipse
                x:Name="Ra12Right"
                Grid.Row="5"
                Grid.Column="1"
                Fill="#3C404040"
                HeightRequest="12"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="12" />

            <Border
                x:Name="BottomSpeedBox"
                Grid.Row="6"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                BackgroundColor="{DynamicResource SignalHousingBackground}"
                HeightRequest="32"
                HorizontalOptions="Center"
                IsVisible="False"
                StrokeThickness="0"
                VerticalOptions="Center"
                WidthRequest="44">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="2" />
                </Border.StrokeShape>
                <Label
                    x:Name="BottomSpeedIndicator"
                    FontAttributes="Bold"
                    FontSize="20"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Text=""
                    TextColor="{DynamicResource RailwayWarning}"
                    VerticalOptions="Center"
                    VerticalTextAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</ContentView>
