<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Moba.MAUI.Controls.KsSignalScreen"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    HeightRequest="70"
    WidthRequest="64">
    <Grid
        x:Name="ScaleHost"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">
        <Grid
            x:Name="SignalGrid"
            AnchorX="0.5"
            AnchorY="0.5"
            Padding="6"
            BackgroundColor="#1E1E1E"
            ColumnSpacing="3"
            HorizontalOptions="Center"
            RowSpacing="3"
            VerticalOptions="Center"
            WidthRequest="90">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label
                x:Name="TopSpeedIndicator"
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                FontAttributes="Bold"
                FontSize="38"
                HeightRequest="40"
                HorizontalTextAlignment="Center"
                IsVisible="False"
                Text=""
                TextColor="White"
                VerticalTextAlignment="Center" />

            <Ellipse
                x:Name="W1"
                Grid.Row="1"
                Grid.Column="0"
                Fill="#3C404040"
                HeightRequest="12"
                WidthRequest="12" />

            <Ellipse
                x:Name="Hp0"
                Grid.Row="2"
                Grid.Column="2"
                Fill="#3C404040"
                HeightRequest="18"
                WidthRequest="18" />

            <Ellipse
                x:Name="Ks1"
                Grid.Row="3"
                Grid.Column="1"
                Fill="#3C404040"
                HeightRequest="18"
                WidthRequest="18" />
            <Ellipse
                x:Name="Ks2"
                Grid.Row="3"
                Grid.Column="3"
                Fill="#3C404040"
                HeightRequest="18"
                WidthRequest="18" />

            <Ellipse
                x:Name="W2"
                Grid.Row="4"
                Grid.Column="1"
                Fill="#3C404040"
                HeightRequest="12"
                WidthRequest="12" />
            <Ellipse
                x:Name="Zs7Center"
                Grid.Row="4"
                Grid.Column="2"
                Fill="#3C404040"
                HeightRequest="12"
                WidthRequest="12" />
            <Ellipse
                x:Name="Zs7Right"
                Grid.Row="4"
                Grid.Column="3"
                Fill="#3C404040"
                HeightRequest="12"
                WidthRequest="12" />

            <Ellipse
                x:Name="W3"
                Grid.Row="5"
                Grid.Column="0"
                Fill="#3C404040"
                HeightRequest="12"
                WidthRequest="12" />
            <Ellipse
                x:Name="Ra12Right"
                Grid.Row="5"
                Grid.Column="1"
                Fill="#3C404040"
                HeightRequest="12"
                WidthRequest="12" />

            <Label
                x:Name="BottomSpeedIndicator"
                Grid.Row="6"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                FontAttributes="Bold"
                FontSize="38"
                HeightRequest="40"
                HorizontalTextAlignment="Center"
                IsVisible="False"
                Text=""
                TextColor="White"
                VerticalTextAlignment="Center" />
        </Grid>
    </Grid>
</ContentView>
