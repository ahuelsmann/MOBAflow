<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Moba.MAUI.Controls.StatisticsPanel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Moba.SharedUI.ViewModel;assembly=SharedUI"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="local:MauiViewModel"
    x:Name="StatisticsRoot">

    <Border x:Name="LapsSectionCard" Style="{DynamicResource MainSectionCard}">
        <VerticalStackLayout Spacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Label
                    Grid.Column="0"
                    Margin="0"
                    Style="{DynamicResource SectionTitleLabel}"
                    Text="Laps per Track"
                    VerticalOptions="Center" />
                <Button
                    x:Name="ResetCountersButton"
                    Grid.Column="2"
                    Padding="12,6"
                    BackgroundColor="{DynamicResource SurfaceDark}"
                    Clicked="ResetCountersButton_Clicked"
                    CornerRadius="6"
                    FontSize="12"
                    HeightRequest="34"
                    SemanticProperties.Description="Reset all lap counters"
                    Text="↻ Reset"
                    TextColor="{DynamicResource TextPrimary}"
                    VerticalOptions="Center" />
            </Grid>

            <CollectionView
                ItemsSource="{Binding Statistics}"
                SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label
                        FontSize="12"
                        HorizontalTextAlignment="Center"
                        Text="No lap data available yet."
                        TextColor="{DynamicResource TextSecondary}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:InPortStatistic">
                        <Border
                            Margin="0,0,0,4"
                            Padding="12,8"
                            BackgroundColor="{DynamicResource SurfaceDark}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border
                                    Grid.Column="0"
                                    BackgroundColor="{Binding HasReceivedFirstLap, Converter={toolkit:BoolToObjectConverter TrueObject={DynamicResource RailwayAccent}, FalseObject={DynamicResource RailwayPrimary}}}"
                                    HeightRequest="32"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="32">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        HorizontalOptions="Center"
                                        Text="{Binding Count}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                </Border>

                                <Grid
                                    Grid.Column="1"
                                    RowDefinitions="Auto,Auto"
                                    RowSpacing="4">
                                    <Grid
                                        Grid.Row="0"
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="8">
                                        <Label
                                            Grid.Column="0"
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            Text="{Binding InPort, StringFormat='Track {0}'}"
                                            VerticalOptions="Center" />
                                        <HorizontalStackLayout
                                            Grid.Column="1"
                                            HorizontalOptions="End"
                                            Spacing="8"
                                            VerticalOptions="Center">
                                            <Label
                                                FontSize="11"
                                                Text="Lap:"
                                                TextColor="{DynamicResource TextDisabled}" />
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="11"
                                                Text="{Binding LastLapTimeFormatted}"
                                                TextColor="{DynamicResource RailwaySecondary}" />
                                            <Label
                                                FontSize="11"
                                                Text="@"
                                                TextColor="{DynamicResource TextDisabled}" />
                                            <Label
                                                FontSize="11"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1"
                                                Text="{Binding LastFeedbackTimeFormatted}"
                                                TextColor="{DynamicResource TextSecondary}" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <Grid
                                        Grid.Row="1"
                                        ColumnDefinitions="Auto,*,Auto,Auto"
                                        ColumnSpacing="6">
                                        <Label
                                            Grid.Column="0"
                                            FontSize="11"
                                            Text="{Binding LapCountFormatted}"
                                            TextColor="{DynamicResource TextSecondary}"
                                            VerticalOptions="Center" />
                                        <BoxView Grid.Column="1" Color="Transparent" />
                                        <ProgressBar
                                            Grid.Column="2"
                                            HeightRequest="6"
                                            Progress="{Binding Progress}"
                                            ProgressColor="{DynamicResource RailwayAccent}"
                                            VerticalOptions="Center"
                                            WidthRequest="72" />
                                        <Label
                                            Grid.Column="3"
                                            FontSize="11"
                                            HorizontalTextAlignment="End"
                                            Text="{Binding Progress, StringFormat='{0:P0}'}"
                                            TextColor="{DynamicResource TextSecondary}"
                                            VerticalOptions="Center"
                                            WidthRequest="35" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Border>
</ContentView>
