<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Moba.MAUI.Controls.FunctionToggleView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    HeightRequest="72"
    MinimumHeightRequest="48">
    <Border
        x:Name="ToggleBorder"
        Padding="6"
        StrokeShape="RoundRectangle 12"
        StrokeThickness="1">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding ToggleCommand, Source={x:Reference Root}}" CommandParameter="{Binding FunctionIndex, Source={x:Reference Root}}" />
        </Border.GestureRecognizers>
        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
            <Image
                x:Name="IconImage"
                HeightRequest="22"
                HorizontalOptions="Center"
                IsVisible="False"
                WidthRequest="22" />
            <Label
                x:Name="FunctionLabel"
                FontAttributes="Bold"
                FontSize="10"
                HorizontalTextAlignment="Center"
                TextColor="{DynamicResource TextPrimary}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
