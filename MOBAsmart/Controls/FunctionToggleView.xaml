<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Moba.MAUI.Controls.FunctionToggleView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    MinimumHeightRequest="40">
    <Border
        x:Name="ToggleBorder"
        Padding="8,6"
        StrokeShape="RoundRectangle 12"
        StrokeThickness="1">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding ToggleCommand, Source={x:Reference Root}}" CommandParameter="{Binding FunctionIndex, Source={x:Reference Root}}" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
            <Image
                x:Name="IconImage"
                Grid.Column="0"
                HeightRequest="20"
                IsVisible="False"
                VerticalOptions="Center"
                WidthRequest="20" />
            <Label
                x:Name="FunctionKeyLabel"
                Grid.Column="1"
                FontAttributes="Bold"
                FontSize="12"
                LineBreakMode="NoWrap"
                MinimumWidthRequest="28"
                VerticalOptions="Center" />
            <Label
                x:Name="DescriptionLabel"
                Grid.Column="2"
                FontSize="11"
                IsVisible="False"
                LineBreakMode="TailTruncation"
                MaxLines="1"
                VerticalOptions="Center" />
        </Grid>
    </Border>
</ContentView>
